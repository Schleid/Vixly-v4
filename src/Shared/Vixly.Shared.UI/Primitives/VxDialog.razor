@namespace Vixly.Shared.UI.Primitives
@*
=========================================================
FILE: VxDialog.razor

PURPOSE:
Accessible modal dialog primitive with backdrop and focus trap.

IMPORTANT NOTES:
- Pure presentational primitive (ADR-0001)
- Size budgets (UI-7): max 6 parameters, max 250 lines
=========================================================
*@

@if (IsOpen)
{
    <div class="vx-dialog-overlay" @onclick="OnClose">
        <div class="vx-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@(_dialogId)-title"
             @onclick:stopPropagation>
            <header class="vx-dialog__header">
                <h2 id="@(_dialogId)-title" class="vx-dialog__title">@Title</h2>
                <button type="button" class="vx-dialog__close" aria-label="Close" @onclick="OnClose">
                    <span aria-hidden="true">&times;</span>
                </button>
            </header>
            <div class="vx-dialog__body">
                @ChildContent
            </div>
            @if (Footer is not null)
            {
                <footer class="vx-dialog__footer">
                    @Footer
                </footer>
            }
        </div>
    </div>
}

@code {
    private readonly string _dialogId = "vx-dialog-" + Guid.NewGuid().ToString("N")[..6];

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Footer { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }
}
