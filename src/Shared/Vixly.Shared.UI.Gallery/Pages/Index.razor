@page "/"

<div class="gallery-section">
    <h1>Vixly Shared UI Primitives Gallery</h1>
    <p>A zero-backend Blazor host showcasing all shared design tokens and Batch 1 primitives across states, themes, and screen sizes.</p>
</div>

<div class="gallery-section">
    <h2>Batch 1 Primitives Status</h2>
    <div class="gallery-grid">
        <VxStatusBadge Text="Button (Primary, Danger, Subtle, Busy)" Status="VxBadgeStatus.Active" />
        <VxStatusBadge Text="TextInput (Accessible, Styled)" Status="VxBadgeStatus.Active" />
        <VxStatusBadge Text="StatusBadge (Multi-status)" Status="VxBadgeStatus.Active" />
        <VxStatusBadge Text="Message / Alert (WCAG roles)" Status="VxBadgeStatus.Active" />
        <VxStatusBadge Text="Card (Header, Footer, Actions)" Status="VxBadgeStatus.Active" />
        <VxStatusBadge Text="Dialog (Modal, Backdrop, Focus trap)" Status="VxBadgeStatus.Active" />
        <VxStatusBadge Text="EmptyState (Actionable, Illustrated)" Status="VxBadgeStatus.Active" />
        <VxStatusBadge Text="DataTable & Pager (Virtualized/Paged)" Status="VxBadgeStatus.Active" />
    </div>
</div>
