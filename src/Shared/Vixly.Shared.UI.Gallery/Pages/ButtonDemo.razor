@page "/primitives/button"

<div class="gallery-section">
    <h1>VxButton Primitive</h1>
    <p>Accessible button primitive supporting keyboard focus, busy spinners, and design system variants.</p>
</div>

<div class="gallery-section">
    <h2>Button Variants</h2>
    <div class="gallery-grid">
        <VxButton Variant="VxButtonVariant.Primary">Primary Action</VxButton>
        <VxButton Variant="VxButtonVariant.Secondary">Secondary Action</VxButton>
        <VxButton Variant="VxButtonVariant.Danger">Destructive Action</VxButton>
        <VxButton Variant="VxButtonVariant.Subtle">Subtle Action</VxButton>
    </div>
</div>

<div class="gallery-section">
    <h2>Button States</h2>
    <div class="gallery-grid">
        <VxButton Variant="VxButtonVariant.Primary" Disabled="true">Disabled State</VxButton>
        <VxButton Variant="VxButtonVariant.Primary" IsBusy="true">Saving...</VxButton>
        <VxButton Variant="VxButtonVariant.Secondary" Disabled="true">Disabled Secondary</VxButton>
    </div>
</div>
