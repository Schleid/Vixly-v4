<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Vixly Shared UI Gallery</title>
    <link rel="stylesheet" href="_content/Vixly.Shared.UI/vixly-theme.css" />
    <link rel="stylesheet" href="_content/Vixly.Shared.UI/vixly-primitives.css" />
    <link rel="stylesheet" href="css/gallery.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script>
        document.addEventListener('keydown', function(event) {
            if ((event.ctrlKey || event.metaKey) && event.code === 'KeyK') {
                var search = document.querySelector('[data-workbench-search]');
                if (search) { event.preventDefault(); search.focus(); search.select(); }
            }
        });
        window.setGalleryTheme = function(theme) {
            document.documentElement.setAttribute('data-theme', theme);
        };
    </script>
</body>
</html>
