@using Vixly.Shared.Help
@inject IStringLocalizer<PublicText> T
@* =========================================================
   FILE: PublicHelpList.razor

   PURPOSE:
   Presents article titles and summaries in a help result list.

   RESPONSIBILITIES:
   - Render localized empty results and stable article addresses.

   IMPORTANT NOTES:
   - The caller supplies already-visible catalogue articles.
   ========================================================= *@
@if (Articles.Count == 0)
{
    <p>@T["ui.help.empty"]</p>
}
else
{
    <ul class="pub-help-list">
        @foreach (HelpArticle article in Articles)
        {
            <li>
                <a href="@PublicHelpCatalogue.Address(article.Language, article.Metadata.Slug)">@article.Metadata.Title</a>
                <p>@article.Metadata.Summary</p>
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<HelpArticle> Articles { get; set; } = [];
}
