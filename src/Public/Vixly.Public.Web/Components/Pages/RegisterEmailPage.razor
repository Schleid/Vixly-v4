@*
=========================================================
FILE: RegisterEmailPage.razor

PURPOSE:
Sign-up, step 2: check your email.

IMPORTANT NOTES:
- Page (UI-6): route and composition only
- Sign-up pages are noindex and switched off until Stage 3 (D-U4)
=========================================================
*@
@page "/en/register/email"
@page "/fr/register/email"
@page "/es/register/email"
@attribute [EnableRateLimiting(PublicRateLimits.Registration)]
@inject IStringLocalizer<PublicText> T

<PageHead TitleKey="public.register.email_title" Indexed="false" />
<section class="pub-section pub-section--narrow">
    <h1>@T["public.register.email_title"]</h1>
    <RegistrationGate>
        <RegistrationEmail />
    </RegistrationGate>
</section>
