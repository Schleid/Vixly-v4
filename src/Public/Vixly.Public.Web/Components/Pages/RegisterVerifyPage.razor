@*
=========================================================
FILE: RegisterVerifyPage.razor

PURPOSE:
Sign-up: the link from the verification email.

IMPORTANT NOTES:
- Page (UI-6): route and composition only
- Sign-up pages are noindex and switched off until Stage 3 (D-U4)
=========================================================
*@
@page "/register/verify"
@attribute [EnableRateLimiting(PublicRateLimits.Registration)]
@inject IStringLocalizer<PublicText> T

<PageHead TitleKey="public.register.verify_title" Indexed="false" />
<section class="pub-section pub-section--narrow">
    <h1>@T["public.register.verify_title"]</h1>
    <RegistrationGate>
        <RegistrationVerify Token="@Token" />
    </RegistrationGate>
</section>

@code {
    [SupplyParameterFromQuery]
    public string? Token { get; set; }
}
