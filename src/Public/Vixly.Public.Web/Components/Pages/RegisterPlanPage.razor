@*
=========================================================
FILE: RegisterPlanPage.razor

PURPOSE:
Sign-up, step 3: choose a plan.

IMPORTANT NOTES:
- Page (UI-6): route and composition only
- Sign-up pages are noindex and switched off until Stage 3 (D-U4)
=========================================================
*@
@page "/en/register/plan"
@page "/fr/register/plan"
@page "/es/register/plan"
@attribute [EnableRateLimiting(PublicRateLimits.Registration)]
@inject IStringLocalizer<PublicText> T

<PageHead TitleKey="public.register.plan_title" Indexed="false" />
<section class="pub-section pub-section--narrow">
    <h1>@T["public.register.plan_title"]</h1>
    <RegistrationGate>
        <RegistrationPlan Plan="@Plan" />
    </RegistrationGate>
</section>

@code {
    [SupplyParameterFromQuery]
    public string? Plan { get; set; }
}
