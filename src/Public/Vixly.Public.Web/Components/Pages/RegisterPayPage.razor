@*
=========================================================
FILE: RegisterPayPage.razor

PURPOSE:
Sign-up, step 4: pay.

IMPORTANT NOTES:
- Page (UI-6): route and composition only
- Sign-up pages are noindex and switched off until Stage 3 (D-U4)
=========================================================
*@
@page "/en/register/pay"
@page "/fr/register/pay"
@page "/es/register/pay"
@attribute [EnableRateLimiting(PublicRateLimits.Registration)]
@inject IStringLocalizer<PublicText> T

<PageHead TitleKey="public.register.pay_title" Indexed="false" />
<section class="pub-section pub-section--narrow">
    <h1>@T["public.register.pay_title"]</h1>
    <RegistrationGate>
        <RegistrationPay />
    </RegistrationGate>
</section>
