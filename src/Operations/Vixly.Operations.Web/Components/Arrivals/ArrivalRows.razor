@*
=========================================================
FILE: ArrivalRows.razor

PURPOSE:
A table of dispatches a destination warehouse receives (Slice 7).

RESPONSIBILITIES:
- One row per dispatch, linked to its receiving page

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10)
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<OperationsTableViewport Label="@T["ui.arrivals.coming"]">
    <table class="ops-editor__table">
        <thead><tr><th scope="col" class="ops-editor__identity-cell">@T["ui.dispatch.number"]</th><th scope="col">@T["ui.dispatch.from"]</th><th scope="col">@T["ui.dispatch.state"]</th><th scope="col">@T["ui.arrivals.departed"]</th><th scope="col">@T["ui.arrivals.received_at"]</th><th scope="col" class="ops-editor__number">@T["ui.dispatch.bundles"]</th></tr></thead>
        <tbody>
            @foreach (OperationsArrivalRow row in Rows)
            {
                <tr data-status="@row.Status">
                    <td class="ops-editor__identity-cell ops-editor__code"><a href="/staff/arrivals/@row.DispatchId?warehouse=@WarehouseId">@row.Number</a>@if (row.Onward) { <span class="ops-editor__hint"> · @T["ui.arrivals.onward"]</span> }</td>
                    <td>@row.FromCode</td>
                    <td><span class="ops-editor__status" data-status="@row.Status.ToString().ToLowerInvariant()">@T["ui.dispatch.status." + row.Status]</span></td>
                    <td>@OperationsDispatchWords.Time(row.DepartedUtc, TimeZone)</td>
                    <td>@OperationsDispatchWords.Time(row.ReceivedUtc, TimeZone)</td>
                    <td class="ops-editor__number">@row.BundleCount</td>
                </tr>
            }
        </tbody>
    </table>
</OperationsTableViewport>

@code {
    [Parameter] public IReadOnlyList<OperationsArrivalRow> Rows { get; set; } = Array.Empty<OperationsArrivalRow>();

    [Parameter] public Guid WarehouseId { get; set; }

    [Parameter] public string? TimeZone { get; set; }
}
