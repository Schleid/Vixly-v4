@*
=========================================================
FILE: ScreenActionButton.razor

PURPOSE:
One choice on the customer screen (Slice 5F step 3), posted with the version the customer saw.

RESPONSIBILITIES:
- A form with a single large button

IMPORTANT NOTES:
- Markup only
=========================================================
*@
<form method="post" action="/screen/act" class="ops-screen__choice">
    <AntiforgeryToken />
    <input type="hidden" name="action" value="@Action" />
    <input type="hidden" name="version" value="@Version" />
    <button type="submit" class="vx-button @(Secondary ? "vx-button--secondary" : "vx-button--primary")">@Label</button>
</form>

@code {
    [Parameter, EditorRequired] public OperationsScreenAction Action { get; set; }

    [Parameter, EditorRequired] public string Version { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter] public bool Secondary { get; set; }
}
