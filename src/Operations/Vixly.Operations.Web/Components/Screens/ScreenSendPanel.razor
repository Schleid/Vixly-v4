@*
=========================================================
FILE: ScreenSendPanel.razor

PURPOSE:
Sends an invoice to pay, or a shipment's declaration to sign, to a customer screen at this warehouse (Slice 5F step 3, P-2, P-3).

RESPONSIBILITIES:
- One button per screen of the warehouse; what the screen shows now, and Clear · next customer
- Say when the customer accepted the Zelle terms on the screen

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10)
- The clerk's page reloads itself only when asked; the screen's state is read when the page opens
=========================================================
*@
<section class="ops-editor__panel" aria-labelledby="screens-title" id="screens" data-screens>
    <h2 id="screens-title">@T["ui.screens.panel_title"]</h2>
    @if (Screens.Count == 0)
    {
        <p class="ops-editor__hint">@T["ui.screens.panel_none"] <a href="/staff/screens">@T["ui.screens.title"]</a></p>
    }
    else
    {
        <ul class="ops-editor__list">
            @foreach (OperationsScreenRow screen in Screens)
            {
                bool showingThis = (InvoiceId is not null && screen.InvoiceId == InvoiceId) || (ShipmentId is not null && screen.ShipmentId == ShipmentId);
                <li data-screen="@screen.ScreenId" data-showing="@showingThis">
                    <strong>@screen.Name</strong>
                    @if (!screen.Paired)
                    {
                        <span> · @T["ui.screens.waiting_code"]</span>
                    }
                    else if (showingThis)
                    {
                        <span> · @T["ui.screens.step." + screen.Step]</span>
                        @if (InvoiceId is not null && screen.ZelleAcceptedUtc is { } accepted)
                        {
                            <span data-zelle-accepted> · @VixlyText.Format(T, "ui.screens.zelle_accepted", "time", accepted.ToLocalTime().ToString("t", CultureInfo.CurrentCulture))</span>
                        }
                        <form method="post" action="/staff/screens/@screen.ScreenId/send" style="display: inline;">
                            <AntiforgeryToken />
                            <input type="hidden" name="clear" value="true" />
                            <input type="hidden" name="back" value="@Back" />
                            <button type="submit" class="vx-button vx-button--secondary">@T["ui.screens.clear"]</button>
                        </form>
                    }
                    @if (screen.Paired)
                    {
                        <form method="post" action="/staff/screens/@screen.ScreenId/send" style="display: inline;">
                            <AntiforgeryToken />
                            @if (InvoiceId is { } invoice)
                            {
                                <input type="hidden" name="invoice" value="@invoice" />
                            }
                            @if (ShipmentId is { } shipment)
                            {
                                <input type="hidden" name="shipment" value="@shipment" />
                            }
                            <input type="hidden" name="back" value="@Back" />
                            <button type="submit" class="vx-button vx-button--primary">@(InvoiceId is not null ? T["ui.screens.send_invoice"] : T["ui.screens.send_sign"])</button>
                        </form>
                    }
                </li>
            }
        </ul>
    }
</section>

@code {
    [Parameter, EditorRequired] public IStringLocalizer<OperationsText> T { get; set; } = null!;

    // The screens of this page's warehouse.
    [Parameter] public IReadOnlyList<OperationsScreenRow> Screens { get; set; } = Array.Empty<OperationsScreenRow>();

    [Parameter] public Guid? InvoiceId { get; set; }

    [Parameter] public Guid? ShipmentId { get; set; }

    // "invoice" or "shipment": where the clerk comes back.
    [Parameter] public string Back { get; set; } = string.Empty;
}
