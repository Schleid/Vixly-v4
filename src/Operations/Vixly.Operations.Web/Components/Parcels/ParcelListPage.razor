@*
=========================================================
FILE: ParcelListPage.razor

PURPOSE:
The parcels a staff member may see, and the unidentified queue (Slice 3B).

RESPONSIBILITIES:
- Search by parcel number, carrier tracking number or customer code
- Filter by warehouse, held parcels, or unidentified ones

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10); the use case limits the list to covered warehouses
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<EditorShell Title="@(Unidentified ? T["ui.parcels.unidentified_title"] : T["ui.parcels.title"])" Company="@Company" Section="parcels" Error="@Error">
    <nav class="ops-editor__inline" aria-label="@T["ui.parcels.views"]">
        <a href="/staff/parcels" aria-current="@(!Unidentified && !Held ? "page" : null)">@T["ui.parcels.view.all"]</a>
        <a href="/staff/parcels?held=true" aria-current="@(Held ? "page" : null)">@T["ui.parcels.view.held"]</a>
        <a href="/staff/parcels/unidentified" aria-current="@(Unidentified ? "page" : null)">@T["ui.parcels.view.unidentified"]</a>
        <a href="/staff/parcels/incoming">@T["ui.incoming.title"]</a>
        <a href="/staff/parcels/labels">@T["ui.shipping_label.list_title"]</a>
        <a href="/staff/parcels/counts">@T["ui.counts.title"]</a>
        <a href="/staff/tickets">@T["ui.tickets.title"]</a>
    </nav>
    <form method="get" action="@BasePath" class="ops-editor__inline ops-editor__search">
        @if (Held) { <input type="hidden" name="held" value="true" /> }
        <input name="search" value="@Search" placeholder="@T["ui.parcels.search"]" aria-label="@T["ui.parcels.search"]" maxlength="60" autocomplete="off" />
        @if (Warehouses.Count > 1)
        {
            <select name="warehouse" aria-label="@T["ui.receiving.warehouse"]">
                <option value="">@T["ui.parcels.all_warehouses"]</option>
                @foreach (OperationsWarehouse warehouse in Warehouses)
                {
                    <option value="@warehouse.Id" selected="@(warehouse.Id == WarehouseId)">@warehouse.Code</option>
                }
            </select>
        }
        <button type="submit" class="vx-button vx-button--secondary">@T["ui.staff.search_submit"]</button>
    </form>
    <section class="ops-editor__panel">
        @if (Unidentified) { <p class="ops-editor__hint">@T["ui.parcels.unidentified_hint"]</p> }
        @if (Parcels.Count == 0)
        {
            <div class="ops-editor__empty"><h2>@T["ui.parcels.none"]</h2></div>
        }
        else
        {
            <OperationsTableViewport Label="@T["ui.parcels.title"]">
                <table class="ops-editor__table">
                    <thead><tr><th scope="col" class="ops-editor__identity-cell">@T["ui.parcels.number"]</th><th scope="col">@T["ui.parcels.tracking"]</th><th scope="col">@T["ui.customers.code"]</th><th scope="col">@T["ui.parcels.warehouse"]</th><th scope="col">@T["ui.parcels.weight"]</th><th scope="col">@T["ui.parcels.milestone"]</th><th scope="col">@T["ui.parcels.holds"]</th><th scope="col">@T["ui.parcels.received"]</th></tr></thead>
                    <tbody>
                        @foreach (OperationsParcelSummary parcel in Parcels)
                        {
                            <tr>
                                <td class="ops-editor__identity-cell ops-editor__code"><a href="/staff/parcels/@parcel.ParcelId">@parcel.Number</a></td>
                                <td class="ops-editor__code">@parcel.CarrierTrackingNumber @if (!string.IsNullOrWhiteSpace(parcel.Carrier)) { <small>@parcel.Carrier</small> }</td>
                                <td class="ops-editor__code">@(parcel.CustomerCode ?? T["ui.hold.Unidentified"])</td>
                                <td class="ops-editor__code">@parcel.WarehouseCode @if (parcel.StorageLocationCode is { } shelf) { <small>@shelf</small> }</td>
                                <td>@(parcel.WeightKg is { } kg ? OperationsUnits.ToShownWeight(kg, WeightUnit).ToString("0.###") + " " + (WeightUnit == OperationsWeightUnit.Pound ? "lb" : "kg") : null)</td>
                                <td>@(parcel.Milestone is { } milestone ? T["ui.milestone." + milestone].Value : null)</td>
                                <td>@string.Join(", ", Holds(parcel.HoldReasons))</td>
                                <td>@parcel.ReceivedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </OperationsTableViewport>
        }
        <p class="ops-editor__list-footer">@VixlyText.Format(T, "ui.parcels.count", "count", TotalCount)</p>
        <nav class="ops-editor__inline" aria-label="@T["ui.customers.pages"]">
            @if (Page > 1) { <a href="@PageLink(Page - 1)">@T["ui.customers.previous"]</a> }
            @if (Page * PageSize < TotalCount) { <a href="@PageLink(Page + 1)">@T["ui.customers.next"]</a> }
        </nav>
    </section>
</EditorShell>

@code {
    public const int PageSize = 25;

    private string BasePath => Unidentified ? "/staff/parcels/unidentified" : "/staff/parcels";

    private string PageLink(int page) => BasePath + "?page=" + page
        + (Held ? "&held=true" : null)
        + (WarehouseId is { } warehouse ? "&warehouse=" + warehouse : null)
        + (string.IsNullOrWhiteSpace(Search) ? null : "&search=" + Uri.EscapeDataString(Search));

    private IEnumerable<string> Holds(OperationsHoldReasons reasons) =>
        Enum.GetValues<OperationsHoldReasons>().Where(reason => reason != OperationsHoldReasons.None && reasons.HasFlag(reason)).Select(reason => T["ui.hold." + reason].Value);

    [Parameter] public string? Company { get; set; }

    [Parameter] public string? Search { get; set; }

    [Parameter] public Guid? WarehouseId { get; set; }

    [Parameter] public bool Unidentified { get; set; }

    [Parameter] public bool Held { get; set; }

    [Parameter] public int Page { get; set; } = 1;

    [Parameter] public IReadOnlyList<OperationsParcelSummary> Parcels { get; set; } = Array.Empty<OperationsParcelSummary>();

    [Parameter] public int TotalCount { get; set; }

    [Parameter] public IReadOnlyList<OperationsWarehouse> Warehouses { get; set; } = Array.Empty<OperationsWarehouse>();

    [Parameter] public OperationsWeightUnit WeightUnit { get; set; }

    [Parameter] public string? Error { get; set; }
}
