@inject IStringLocalizer<OperationsText> T
@* =========================================================
FILE: InventoryTabs.razor

PURPOSE:
The tabs shared by the basic parcel inventory pages (owner, 2026-10-23: "Inventory" in the menu).

RESPONSIBILITIES:
- Link on hand, move, shelf counts, undeclared counts and the parcels list
- Mark the current tab

IMPORTANT NOTES:
- Links only. Each page's use case checks its own permission
========================================================= *@
<nav class="ops-status-chips" aria-label="@T["ui.inventory.tabs"]">
    @foreach ((string key, string url) in Tabs)
    {
        <a href="@url" class="ops-status-chip" aria-current="@(Current == key ? "page" : null)"><span>@T["ui.inventory.tab." + key]</span></a>
    }
</nav>

@code {
    private static readonly (string Key, string Url)[] Tabs =
    {
        ("on_hand", "/staff/parcels/on-hand"),
        ("move", "/staff/parcels/move"),
        ("shelf_counts", "/staff/parcels/shelf-counts"),
        ("undeclared_counts", "/staff/parcels/counts"),
        ("parcels", "/staff/parcels")
    };

    // The key of the page showing the tabs.
    [Parameter] public string Current { get; set; } = string.Empty;
}
