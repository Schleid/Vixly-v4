@inject IStringLocalizer<OperationsText> T
@inject IStringLocalizer<OperationsInspectionText> L
@* =========================================================
FILE: InspectionStationFrame.razor

PURPOSE:
Frame the inspection lookup with a calm, high-density station scan input.

RESPONSIBILITIES:
- Present the scan entry clearly without decorative sketches or guide text (brief 2026-10-20)

IMPORTANT NOTES:
- Presentation only; no queue counts, scanner connection claims or policy changes
- A loaded parcel keeps the lookup compact
========================================================= *@
<section class="ops-inspection-station" data-loaded="@(Loaded ? "true" : "false")" aria-label="@T["ui.inspection.title"]">
    <div class="ops-inspection-station__scan">
        <span class="ops-inspection-station__scan-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5M7 8v8m3-8v8m4-8v8m3-8v8M1 12h22"/></svg></span>
        <div class="ops-inspection-station__input">@ChildContent
            <p class="ops-inspection-station__hint">@L["inspection_scan_hint"] <kbd>↵</kbd></p>
        </div>
    </div>
</section>

@code {
    [Parameter] public bool Loaded { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
