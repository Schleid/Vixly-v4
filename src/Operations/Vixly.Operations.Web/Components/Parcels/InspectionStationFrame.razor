@inject IStringLocalizer<OperationsText> T
@inject IStringLocalizer<OperationsInspectionText> L
@* =========================================================
FILE: InspectionStationFrame.razor

PURPOSE:
Frame the inspection lookup and explain its empty state.

RESPONSIBILITIES:
- Present the scan entry and the three inspection tasks

IMPORTANT NOTES:
- Presentation only; no queue counts, scanner connection claims or policy changes
- A loaded parcel keeps the lookup compact
========================================================= *@
<section class="ops-inspection-station" data-loaded="@(Loaded ? "true" : "false")" aria-label="@T["ui.inspection.title"]">
    @if (!Loaded)
    {
        <div class="ops-inspection-station__intro">
            <div><p class="ops-inspection-station__eyebrow">@L["inspection_eyebrow"]</p>
                <h2>@L["inspection_ready"]</h2>
                <p class="ops-inspection-station__description">@L["inspection_intro"]</p>
            </div>
            <InspectionSketch />
        </div>
    }
    <div class="ops-inspection-station__scan">
        <span class="ops-inspection-station__scan-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5M7 8v8m3-8v8m4-8v8m3-8v8M1 12h22"/></svg></span>
        <div class="ops-inspection-station__input">@ChildContent
            <p class="ops-inspection-station__hint">@L["inspection_scan_hint"] <kbd>↵</kbd></p>
        </div>
    </div>
    @if (!Loaded)
    {
        <ol class="ops-inspection-station__steps">
            <li><span aria-hidden="true">01</span><div><h3>@T["ui.receiving.condition"]</h3><p>@L["inspection_condition"]</p></div></li>
            <li><span aria-hidden="true">02</span><div><h3>@T["ui.receiving.measurements"]</h3><p>@L["inspection_measurements"]</p></div></li>
            <li><span aria-hidden="true">03</span><div><h3>@T["ui.receiving.photos"]</h3><p>@L["inspection_photos"]</p></div></li>
        </ol>
    }
</section>

@code {
    [Parameter] public bool Loaded { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
