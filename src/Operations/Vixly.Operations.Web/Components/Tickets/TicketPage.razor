@*
=========================================================
FILE: TicketPage.razor

PURPOSE:
One customer's ticket for staff: what it knows, the messages, and the undeclared packages that resemble it (Slice 4D step 4).

RESPONSIBILITIES:
- Show the ticket, the proof link and the messages
- Give a package that resembles it to the customer (how staff checked it), answer, or resolve

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10)
- Forms only for staff with ops.parcels.assign at the warehouse; the use cases check again
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<EditorShell Title="@T["ui.tickets.ticket"]" Company="@Company" Section="parcels" Error="@Error" Info="@Info">
    <div class="ops-support-workflow">
    <VxWorkspaceArt Kind="support" />
    <p><a href="/staff/tickets">@T["ui.tickets.back"]</a></p>
    <section class="ops-editor__panel">
        <dl class="ops-editor__details">
            <dt>@T["ui.tickets.status"]</dt><dd>@T["ui.tickets.status." + Ticket.Status]</dd>
            <dt>@T["ui.customers.code"]</dt><dd>@CustomerCode @(CustomerName is null ? null : "· " + CustomerName)</dd>
            <dt>@T["ui.receiving.warehouse"]</dt><dd>@WarehouseCode</dd>
            <dt>@T["ui.tickets.carrier"]</dt><dd>@Ticket.Carrier</dd>
            <dt>@T["ui.tickets.tracking"]</dt><dd>@Ticket.TrackingNumber</dd>
            @if (!string.IsNullOrWhiteSpace(Ticket.Store)) { <dt>@T["ui.tickets.store"]</dt><dd>@Ticket.Store</dd> }
            @if (!string.IsNullOrWhiteSpace(Ticket.OrderNumber)) { <dt>@T["ui.tickets.order"]</dt><dd>@Ticket.OrderNumber</dd> }
            @if (Ticket.DeliveredOn is { } day) { <dt>@T["ui.tickets.delivered"]</dt><dd>@day.ToString("yyyy-MM-dd")</dd> }
            <dt>@T["ui.tickets.contents"]</dt><dd>@Ticket.Contents</dd>
            @if (Ticket.ProofKey is not null) { <dt>@T["ui.tickets.proof"]</dt><dd><a href="/staff/tickets/@Ticket.Id/proof" target="_blank" rel="noopener">@T["ui.tickets.proof_open"]</a></dd> }
            @if (Ticket.ParcelId is { } found) { <dt>@T["ui.tickets.found"]</dt><dd><a href="/staff/parcels/@found">@T["ui.tickets.open_parcel"]</a></dd> }
        </dl>
    </section>
    <section class="ops-editor__panel">
        <h2>@T["ui.tickets.messages"]</h2>
        <ol>
            @foreach (OperationsTicketMessage message in Ticket.Messages)
            {
                <li><time datetime="@message.SentUtc.ToString("O")">@message.SentUtc.ToString("yyyy-MM-dd HH:mm")</time> <strong>@(message.FromStaff ? T["ui.tickets.from_staff"] : T["ui.tickets.from_customer"])</strong> @message.Text</li>
            }
        </ol>
    </section>
    @if (Ticket.Status != OperationsTicketStatus.Resolved)
    {
        <section class="ops-editor__panel">
            <h2>@T["ui.tickets.lookalikes"]</h2>
            <p class="ops-editor__hint">@T["ui.tickets.lookalikes_hint"]</p>
            @if (Lookalikes.Count == 0)
            {
                <p>@T["ui.tickets.lookalikes_none"]</p>
            }
            else
            {
                <ul>
                    @foreach (OperationsParcelSummary parcel in Lookalikes)
                    {
                        <li>
                            <a href="/staff/parcels/@parcel.ParcelId">@parcel.Number</a> · @parcel.Carrier · @parcel.CarrierTrackingNumber · @parcel.ReceivedUtc.ToString("yyyy-MM-dd")
                            @if (!string.IsNullOrWhiteSpace(parcel.LabelName)) { <span> · @parcel.LabelName</span> }
                            @if (CanAnswer && CustomerCode is not null)
                            {
                                <form method="post" action="/staff/tickets/@Ticket.Id/link" class="ops-editor__inline ops-panel--restricted">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="key" value="@Guid.NewGuid().ToString("N")" />
                                    <input type="hidden" name="parcel" value="@parcel.ParcelId" />
                                    <select name="verifiedBy" required aria-label="@T["ui.parcels.verified_by"]">
                                        @foreach (string method in OperationsTrackingCodes.VerificationMethods) { <option value="@method">@T["ui.parcels.verified." + method]</option> }
                                    </select>
                                    <button type="submit" class="vx-button vx-button--primary">@T["ui.tickets.link"]</button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    }
    @if (CanAnswer)
    {
        <form method="post" action="/staff/tickets/@Ticket.Id/answer" class="ops-editor__panel ops-panel--restricted">
            <AntiforgeryToken />
            <input type="hidden" name="key" value="@Guid.NewGuid().ToString("N")" />
            <h2>@T["ui.tickets.answer"]</h2>
            <label>@T["ui.tickets.message"] <textarea name="message" maxlength="1000" rows="3"></textarea></label>
            <label><input type="checkbox" name="resolve" value="true" /> @T["ui.tickets.resolve"]</label>
            <button type="submit" class="vx-button vx-button--primary">@T["ui.tickets.send"]</button>
        </form>
    }
    </div>
</EditorShell>

@code {
    [Parameter] public string? Company { get; set; }

    [Parameter, EditorRequired] public OperationsTicket Ticket { get; set; } = null!;

    [Parameter] public string? WarehouseCode { get; set; }

    [Parameter] public string? CustomerCode { get; set; }

    [Parameter] public string? CustomerName { get; set; }

    [Parameter] public IReadOnlyList<OperationsParcelSummary> Lookalikes { get; set; } = Array.Empty<OperationsParcelSummary>();

    [Parameter] public bool CanAnswer { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public string? Info { get; set; }
}
