    <base href="/" />
    <link rel="stylesheet" href="@Assets["_content/Vixly.Shared.UI/vixly-theme.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Vixly.Shared.UI/vixly-primitives.css"]" />
    <link rel="stylesheet" href="/css/ops-status.css" />
    <script src="@Assets["_content/Vixly.Shared.UI/vixly-forms.js"]" defer></script>
    <HeadOutlet />
</head>
<body>
    <Routes />
</body>
