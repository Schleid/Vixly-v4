@*
=========================================================
FILE: PickupSettingsPage.razor

PURPOSE:
Settings → Pickup (Slice 7 step 2, R-4, R-5, R-10): the proof asked at the counter, destination charges, storage at the destination.

RESPONSIBILITIES:
- Four proof checkboxes, the charges switch, the storage switch with its free days and fee

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10)
- Read only without the right to edit settings
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<EditorShell Title="@T["ui.pickup_settings.title"]" Company="@Company" Section="pickup_settings" Error="@Error" Info="@Info">
    <form method="post" action="/staff/settings/pickup" class="ops-editor__panel ops-editor__form">
        <AntiforgeryToken />
        <fieldset disabled="@(!CanEdit)">
            <fieldset>
                <legend>@T["ui.pickup_settings.proofs"]</legend>
                @foreach (OperationsPickupProofs proof in new[] { OperationsPickupProofs.Id, OperationsPickupProofs.Signature, OperationsPickupProofs.Code, OperationsPickupProofs.Photo })
                {
                    <label><input type="checkbox" name="proofs" value="@proof" checked="@Proofs.HasFlag(proof)" /> @T["ui.pickup_settings.proof." + proof]</label>
                }
                <p class="ops-editor__hint">@T["ui.pickup_settings.proofs_hint"]</p>
            </fieldset>
            <label><input type="checkbox" name="charges" value="true" checked="@DestinationCharges" /> @T["ui.pickup_settings.charges"]</label>
            <p class="ops-editor__hint">@T["ui.pickup_settings.charges_hint"]</p>
            <fieldset>
                <legend>@T["ui.pickup_settings.storage_title"]</legend>
                <label><input type="checkbox" name="storage" value="true" checked="@DestinationStorage" /> @T["ui.pickup_settings.storage"]</label>
                <label>@T["ui.pickup_settings.free_days"] <input name="freeDays" type="number" min="0" max="365" value="@FreeDays" required /></label>
                <label>@VixlyText.Format(T, "ui.pickup_settings.fee", "currency", CurrencyCode) <input name="fee" type="number" min="0" step="0.01" value="@FeePerDay?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" /></label>
                <p class="ops-editor__hint">@T["ui.pickup_settings.storage_hint"]</p>
            </fieldset>
            <p class="ops-editor__actions"><button type="submit" class="vx-button vx-button--primary">@T["ui.editor.save"]</button></p>
        </fieldset>
    </form>
</EditorShell>

@code {
    [Parameter] public string? Company { get; set; }

    [Parameter] public OperationsPickupProofs Proofs { get; set; }

    [Parameter] public bool DestinationCharges { get; set; }

    [Parameter] public bool DestinationStorage { get; set; }

    [Parameter] public int FreeDays { get; set; }

    [Parameter] public decimal? FeePerDay { get; set; }

    [Parameter] public string CurrencyCode { get; set; } = string.Empty;

    [Parameter] public bool CanEdit { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public string? Info { get; set; }
}
