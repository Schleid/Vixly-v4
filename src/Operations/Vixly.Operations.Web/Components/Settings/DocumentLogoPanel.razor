@*
=========================================================
FILE: DocumentLogoPanel.razor

PURPOSE:
The logo printed on the company's documents and shipping labels (owner, 2026-10-28).

RESPONSIBILITIES:
- Show the saved logo as it prints, and its black and white copy for labels, with its size and who saved it when
- Upload, replace or remove it (Owner and Administrators, with a fresh confirmation); sample PDFs to check it

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10); values come from the endpoint
- Owner, 2026-10-28: once saved, the page shows that it is there
=========================================================
*@
@using Vixly.Operations.Application.UseCases.Company.GetOperationsDocumentLogo
@inject IStringLocalizer<OperationsText> T

<section class="ops-editor__panel ops-document-logo" id="document-logo" aria-labelledby="document-logo-title">
    <h2 id="document-logo-title">@T["ui.company.document_logo"]</h2>
    @if (Logo.Content is not null)
    {
        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: flex-start;">
            <figure style="margin: 0;">
                <div style="background: #ffffff; border: 1px solid var(--vx-color-border, #e2e8f0); border-radius: 0.375rem; padding: 0.75rem;">
                    <img src="/staff/company/document-logo?v=@Version" alt="@T["ui.company.document_logo"]" style="height: 57px; width: auto; max-width: 100%; display: block;" />
                </div>
                <figcaption class="ops-editor__hint">@T["ui.company.document_logo.on_documents"]</figcaption>
            </figure>
            <figure style="margin: 0;">
                <div style="background: #ffffff; border: 1px solid var(--vx-color-border, #e2e8f0); border-radius: 0.375rem; padding: 0.75rem;">
                    <img src="/staff/company/document-logo?label=true&amp;v=@Version" alt="@T["ui.company.document_logo.on_labels"]" style="height: 40px; width: auto; max-width: 100%; display: block; image-rendering: pixelated;" />
                </div>
                <figcaption class="ops-editor__hint">@T["ui.company.document_logo.on_labels"]</figcaption>
            </figure>
        </div>
        <p class="ops-document-logo__facts">
            <strong>@T["ui.company.document_logo.saved"]</strong>
            · PNG · @Logo.Width × @Logo.Height px · @Size(Logo.Bytes)
            @if (Logo.ChangedUtc is { } changed)
            {
                <span> · @VixlyText.Format(T, "ui.company.document_logo.by", new Dictionary<string, object> { ["date"] = changed.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture), ["name"] = Logo.ChangedBy ?? "—" })</span>
            }
        </p>
        <p class="ops-editor__inline" style="gap: 0.5rem; margin-inline-start: 0; justify-content: flex-start;">
            <a class="vx-button vx-button--secondary" href="/staff/company/document-logo/sample" target="_blank" rel="noopener">@T["ui.company.document_logo.sample"]</a>
            <a class="vx-button vx-button--secondary" href="/staff/company/document-logo/sample-label" target="_blank" rel="noopener">@T["ui.company.document_logo.sample_label"]</a>
        </p>
    }
    else
    {
        <p>@T["ui.company.document_logo.none"]</p>
    }
    @if (Logo.CanEdit)
    {
        <div class="ops-inline-action-bar" style="display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.75rem; margin-top: 0.5rem;">
            <form method="post" action="/staff/company/document-logo" enctype="multipart/form-data" style="display: inline-flex; align-items: flex-end; gap: 0.5rem; margin: 0;">
                <AntiforgeryToken />
                <label style="display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.75rem; font-weight: 600; margin: 0;">
                    <span>@T["ui.company.document_logo.file"]</span>
                    <input type="file" name="logo" accept="image/png" required style="height: 32px; padding: 0.2rem 0.4rem; font-size: 0.8125rem;" />
                </label>
                <button type="submit" class="vx-button vx-button--primary">@(Logo.Content is null ? T["ui.company.document_logo.upload"] : T["ui.company.document_logo.replace"])</button>
            </form>
            @if (Logo.Content is not null)
            {
                <form method="post" action="/staff/company/document-logo/remove" style="display: inline; margin: 0;">
                    <AntiforgeryToken />
                    <button type="submit" class="vx-button vx-button--secondary">@T["ui.company.document_logo.remove"]</button>
                </form>
            }
        </div>
        <p class="ops-editor__hint">@T["ui.company.document_logo.hint"]</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public GetOperationsDocumentLogoResponse Logo { get; set; } = null!;

    // A new address after each change, so the browser never shows the old picture.
    private long Version => Logo.ChangedUtc?.UtcTicks ?? 0;

    private static string Size(int bytes) => bytes >= 1024 * 1024
        ? (bytes / 1048576.0).ToString("0.0", System.Globalization.CultureInfo.CurrentCulture) + " MB"
        : Math.Max(1, (int)Math.Round(bytes / 1024.0)).ToString(System.Globalization.CultureInfo.CurrentCulture) + " KB";
}
