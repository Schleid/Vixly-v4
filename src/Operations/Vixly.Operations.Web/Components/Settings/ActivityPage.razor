@*
=========================================================
FILE: ActivityPage.razor

PURPOSE:
Member activity (owner, 2026-10-21): each sign-in and how it
ended, with the device, the browser and the country.

RESPONSIBILITIES:
- Render the sign-ins of the company, or of one member, newest
  first, with paging

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10); values come from the endpoint
- A sign-in from another country than its device's is marked (data-flag); it was confirmed with a second factor
=========================================================
*@
@using Vixly.Operations.Application.Audit
@inject IStringLocalizer<OperationsText> T

<EditorShell Title="@T["ui.activity.title"]" Company="@Company" Section="activity" Error="@Error">
    <div class="ops-list-bar" style="margin-bottom: 0.75rem;">
        <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
            @if (MemberId is not null)
            {
                <span style="font-weight: 600; font-size: 0.875rem;">@VixlyText.Format(T, "ui.activity.of", "name", MemberName ?? string.Empty)</span>
                <a href="/staff/activity" class="vx-button vx-button--secondary" style="height: 30px; padding: 0 0.75rem; font-size: 0.75rem;">@T["ui.activity.everyone"]</a>
            }
            <a href="@("/staff/audit?area=auth" + (MemberId is null ? null : "&actor=" + MemberId))" class="vx-button vx-button--secondary" style="height: 30px; padding: 0 0.75rem; font-size: 0.75rem;">@T["ui.activity.refused_link"]</a>
        </div>
        <div class="ops-list-bar__actions">
            <span style="font-size: 0.8125rem; color: var(--vx-color-text-muted, #64748b);">@VixlyText.Format(T, "ui.activity.count", "count", TotalCount)</span>
        </div>
    </div>
    <section class="ops-editor__panel">
        @if (Lines.Count == 0)
        {
            <div class="ops-editor__empty"><p>@T["ui.editor.none"]</p></div>
        }
        else
        {
            <OperationsTableViewport Label="@T["ui.activity.title"]">
                <table class="ops-editor__table ops-activity">
                    <thead>
                        <tr>
                            <th scope="col">@T["ui.activity.member"]</th>
                            <th scope="col">@T["ui.activity.signed_in"]</th>
                            <th scope="col">@T["ui.activity.signed_out"]</th>
                            <th scope="col">@T["ui.activity.device"]</th>
                            <th scope="col">@T["ui.activity.browser"]</th>
                            <th scope="col">@T["ui.activity.country"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (OperationsActivityLine line in Lines)
                        {
                            <tr data-flag="@(line.CountryChanged ? "country" : null)">
                                <td><a href="/staff/activity?member=@line.UserId">@(line.MemberName ?? "-")</a></td>
                                <td>@Time(line.SignedInUtc)</td>
                                <td>
                                    @if (line.SignedOutUtc is { } signedOut)
                                    {
                                        @Time(signedOut) <small class="ops-editor__hint">· @T["ui.activity.ended." + line.Ended]</small>
                                    }
                                    else
                                    {
                                        <span class="ops-editor__status" data-status="active">@T["ui.activity.still_signed_in"]</span>
                                    }
                                </td>
                                <td>@(line.DeviceName is null ? T["ui.activity.no_device"].Value : line.DeviceName + " · " + line.DeviceNumber)</td>
                                <td>@(line.Browser ?? "-")</td>
                                <td>
                                    @Country(line.Country)
                                    @if (line.CountryChanged) { <span class="ops-editor__status" data-status="warning" style="margin-inline-start: 0.35rem;">@T["ui.activity.country_changed"]</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </OperationsTableViewport>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.85rem; padding-top: 0.5rem; border-top: 1px solid var(--vx-color-border, #e2e8f0);">
                <span style="font-size: 0.8125rem; color: var(--vx-color-text-muted, #64748b);">@VixlyText.Format(T, "ui.activity.count", "count", TotalCount)</span>
                <div style="display: flex; gap: 0.5rem;">
                    @if (Page > 1) { <a href="@PageLink(Page - 1)" class="vx-button vx-button--secondary" style="height: 30px; padding: 0 0.75rem; font-size: 0.75rem;">@T["ui.audit.newer"]</a> }
                    @if (Page * PageSize < TotalCount) { <a href="@PageLink(Page + 1)" class="vx-button vx-button--secondary" style="height: 30px; padding: 0 0.75rem; font-size: 0.75rem;">@T["ui.audit.older"]</a> }
                </div>
            </div>
        }
    </section>
</EditorShell>

@code {
    [Parameter] public string? Company { get; set; }

    [Parameter] public IReadOnlyList<OperationsActivityLine> Lines { get; set; } = Array.Empty<OperationsActivityLine>();

    [Parameter] public int TotalCount { get; set; }

    [Parameter] public int Page { get; set; } = 1;

    [Parameter] public int PageSize { get; set; } = 50;

    [Parameter] public Guid? MemberId { get; set; }

    [Parameter] public string? MemberName { get; set; }

    [Parameter] public string? Error { get; set; }

    private string Country(string? code) => code switch { null => "-", "T1" => T["ui.activity.country.tor"].Value, "XX" => T["ui.activity.country.unknown"].Value, _ => code };

    private static string Time(DateTimeOffset utc) => utc.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture) + " UTC";

    private string PageLink(int page) => "/staff/activity?page=" + page + (MemberId is null ? null : "&member=" + MemberId);
}
