@*
=========================================================
FILE: CustomerLookupPage.razor

PURPOSE:
Find one customer by their exact phone, email or code, for staff without the company's customer list (owner, 2026-10-29, design 4.4).

RESPONSIBILITIES:
- One search box; the few exact matches, each opening the customer

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10); the endpoint loads the data
- Never a list or a name search: the customer list is a company feature
- Every lookup is recorded and limited per hour (OperationsCustomerLookups)
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<EditorShell Title="@T["ui.customers.lookup.title"]" Company="@Company" Section="customers" Error="@Error">
    <form method="get" action="/staff/customers" class="ops-list-bar" role="search">
        <input name="search" value="@Search" placeholder="@T["ui.customers.lookup.placeholder"]" aria-label="@T["ui.customers.lookup.placeholder"]" maxlength="100" autocomplete="off" autofocus required />
        <button type="submit" class="vx-button vx-button--primary">@T["ui.staff.search_submit"]</button>
        @if (!string.IsNullOrWhiteSpace(Search))
        {
            <a href="/staff/customers" class="vx-button vx-button--secondary">@T["ui.counter.clear"]</a>
        }
    </form>
    <p class="ops-editor__hint">@T["ui.customers.lookup.hint"]</p>
    @if (!string.IsNullOrWhiteSpace(Search) && Error is null)
    {
        <section class="ops-editor__panel">
            @if (Customers.Count == 0)
            {
                <div class="ops-editor__empty"><h2>@T["ui.customers.lookup.none"]</h2></div>
            }
            else
            {
                <OperationsTableViewport Label="@T["ui.customers.lookup.title"]">
                    <table class="ops-editor__table">
                        <thead>
                            <tr>
                                <th scope="col" class="ops-editor__identity-cell">@T["ui.staff.name"]</th>
                                <th scope="col">@T["ui.customers.code"]</th>
                                <th scope="col">@T["ui.editor.email"]</th>
                                <th scope="col">@T["ui.customers.phone"]</th>
                                <th scope="col">@T["ui.customers.status"]</th>
                                <th scope="col">@T["ui.customers.credit"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (OperationsCustomerProfile customer in Customers)
                            {
                                <tr>
                                    <td class="ops-editor__identity-cell"><a href="/staff/customers/@customer.CustomerId">@customer.FullName</a>@if (!string.IsNullOrWhiteSpace(customer.CompanyName)) { <small> · @customer.CompanyName</small> }</td>
                                    <td class="ops-editor__code">@(customer.Code ?? T["ui.customers.no_code"].Value)</td>
                                    <td>@customer.Email</td>
                                    <td class="ops-editor__code">@Vixly.Shared.Localization.VixlyPhone.International(customer.Phone)</td>
                                    <td><span class="ops-editor__status" data-status="@customer.Status.ToString().ToLowerInvariant()">@T["ui.customers.status." + customer.Status.ToString().ToLowerInvariant()]</span></td>
                                    <td><span class="ops-editor__status" data-status="@(customer.CreditAllowed ? "active" : "neutral")">@(customer.CreditAllowed ? T["ui.customers.credit_on"].Value : T["ui.customers.credit_off"].Value)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </OperationsTableViewport>
            }
        </section>
    }
</EditorShell>

@code {
    [Parameter] public string? Company { get; set; }

    [Parameter] public string? Search { get; set; }

    [Parameter] public IReadOnlyList<OperationsCustomerProfile> Customers { get; set; } = Array.Empty<OperationsCustomerProfile>();

    [Parameter] public string? Error { get; set; }
}
