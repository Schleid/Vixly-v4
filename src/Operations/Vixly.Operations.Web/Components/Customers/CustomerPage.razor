@*
=========================================================
FILE: CustomerPage.razor

PURPOSE:
One customer: details, the packages coming to them, status and credit (Slice 2).

RESPONSIBILITIES:
- Show the customer and the packages coming to them; never the mailbox's street address (owner, 2026-10-18)
- Suspend, reactivate or close; allow or remove credit. The details are the customer's own (owner, 2026-10-18)

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10); the endpoint loads the data
- Static forms with antiforgery and the form guard (ADR-0019)
- Credit needs ops.customers.credit and step-up; the use cases decide
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<EditorShell Title="@Customer.FullName" Company="@Company" Section="customers" Error="@Error" Info="@Info">
    <p><a href="/staff/customers">@T["ui.customers.back"]</a></p>
    <div class="ops-customer-tabs ops-compact-tabs" data-section-tabs="customer" data-tabs-label="@T["ui.customers.details"]">

    <section class="ops-editor__panel ops-record-summary" aria-labelledby="customer-details">
        <h2 id="customer-details">@T["ui.customers.details"]</h2>
        <dl>
            <dt>@T["ui.customers.code"]</dt><dd>@(Customer.Code ?? T["ui.customers.no_code"])</dd>
            <dt>@T["ui.editor.email"]</dt><dd>@Customer.Email @(Customer.EmailVerified ? null : "· " + T["ui.customers.not_verified"])</dd>
            <dt>@T["ui.customers.phone"]</dt><dd>@Customer.Phone</dd>
            @if (!string.IsNullOrWhiteSpace(Customer.CompanyName)) { <dt>@T["ui.customers.company"]</dt><dd>@Customer.CompanyName</dd> }
            <dt>@T["ui.staff.language"]</dt><dd>@Customer.Language.ToUpperInvariant()</dd>
            <dt>@T["ui.customers.status"]</dt><dd><span class="ops-editor__status" data-status="@Customer.Status.ToString().ToLowerInvariant()">@T["ui.customers.status." + Customer.Status.ToString().ToLowerInvariant()]</span> @(Customer.StatusReason is null ? null : "· " + Customer.StatusReason)</dd>
            <dt>@T["ui.customers.credit"]</dt><dd>@(Customer.CreditAllowed ? T["ui.customers.credit_on"] : T["ui.customers.credit_off"]) @(Customer.CreditReason is null ? null : "· " + Customer.CreditReason)</dd>
            <dt>@T["ui.customers.created"]</dt><dd>@Customer.CreatedUtc.ToString("yyyy-MM-dd")</dd>
            <dt>@T["ui.customers.last_sign_in"]</dt><dd>@(Customer.LastSignInUtc?.ToString("yyyy-MM-dd HH:mm") ?? T["ui.customers.never"])</dd>
        </dl>
    </section>
    @if (CanSeePackages)
    {
        <CustomerIncomingPackages T="T" CustomerCode="@Customer.Code" Packages="Incoming" />
    }


    @if (CanManage)
    {
        <form method="post" action="/staff/customers/@Customer.CustomerId/status" class="ops-editor__panel ops-panel--restricted">
            <AntiforgeryToken />
            <h2>@T["ui.customers.status"]</h2>
            <p>@T["ui.customers.status_hint"]</p>
            <label>@T["ui.customers.new_status"]
                <select name="status">
                    @if (Customer.Status != OperationsCustomerStatus.Active) { <option value="active">@T["ui.customers.status.active"]</option> }
                    @if (Customer.Status != OperationsCustomerStatus.Suspended) { <option value="suspended">@T["ui.customers.status.suspended"]</option> }
                    @if (Customer.Status != OperationsCustomerStatus.Closed) { <option value="closed">@T["ui.customers.status.closed"]</option> }
                </select>
            </label>
            <label>@T["ui.customers.reason"] <input name="reason" maxlength="300" required /></label>
            <button type="submit" class="vx-button vx-button--secondary">@T["ui.customers.status_submit"]</button>
        </form>
    }
    @if (CanSetCredit)
    {
        <section class="ops-editor__panel ops-panel--restricted">
            <h2>@T["ui.customers.credit"]</h2>
            <p>@T["ui.customers.credit_account_hint"]</p>
            <a class="vx-button vx-button--secondary" href="/staff/credit/customers/@Customer.CustomerId">@T["ui.customers.credit_account"]</a>
        </section>
    }
    </div>
</EditorShell>

@code {
    [Parameter] public string? Company { get; set; }

    [Parameter] public OperationsCustomerProfile Customer { get; set; } = null!;

    [Parameter] public IReadOnlyList<OperationsIncomingPackage> Incoming { get; set; } = Array.Empty<OperationsIncomingPackage>();

    [Parameter] public bool CanSeePackages { get; set; }

    [Parameter] public bool CanManage { get; set; }

    [Parameter] public bool CanSetCredit { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public string? Info { get; set; }
}
