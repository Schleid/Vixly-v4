@*
=========================================================
FILE: InvoicePage.razor

PURPOSE:
One invoice (Slice 5F): identity, facts strip, PDF action,
lines and totals, credit notes, and correction request form.

IMPORTANT NOTES:
- Page component (UI-6): <= 80 lines
- Text comes from OperationsText (L-10)
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<EditorShell Title="@(Invoice?.Number ?? T["ui.invoices.title"].Value)" Company="@Company" Section="invoices" Error="@Error" Info="@Info">
    <div class="ops-record-top">
        <a href="/staff/invoices" class="ops-editor__back-link">@T["ui.invoices.back"]</a>
    </div>
    @if (Invoice is { } invoice)
    {
        <div class="ops-record-header">
            <div class="ops-record-header__identity">
                <h1 class="ops-record-header__title">
                    @invoice.Number
                    <span class="ops-editor__status" data-status="@OperationsInvoiceWords.State(invoice)">@T["ui.invoices.status." + OperationsInvoiceWords.State(invoice)]</span>
                </h1>
            </div>
            <div class="ops-record-header__actions">
                <a class="vx-button vx-button--secondary" href="/staff/invoices/@invoice.Id/pdf" target="_blank" rel="noopener">@T["ui.invoices.pdf"]</a>
                <span class="ops-editor__status" data-status="@OperationsPaymentWords.State(invoice.PaymentState)">@T["ui.payments.state." + OperationsPaymentWords.State(invoice.PaymentState)]</span>
                @if (CanTake && invoice.Owed > 0m) { <a class="vx-button vx-button--primary" href="/staff/cashier/invoices/@invoice.Id">@T["ui.cashier.pay"]</a> }
            </div>
        </div>

        <dl class="ops-invoice__facts">
            <div><dt>@T["ui.invoices.date"]</dt><dd>@OperationsInvoiceWords.Day(invoice.IssuedOn)</dd></div>
            <div><dt>@T["ui.invoices.customer"]</dt><dd>@OperationsBillingRows.Customer(invoice) · @invoice.Party.CustomerPhone</dd></div>
            <div><dt>@T[invoice.Kind switch { OperationsInvoiceKind.Shipment => "ui.invoices.shipment", OperationsInvoiceKind.Destination => "ui.invoices.destination", _ => "ui.invoices.order" }]</dt><dd>@invoice.Reference@(invoice.Route is { } route ? " · " + route : string.Empty)</dd></div>
            <div><dt>@T["ui.invoices.warehouse"]</dt><dd>@invoice.Party.WarehouseName</dd></div>
            <div><dt>@T["ui.invoices.language"]</dt><dd>@invoice.Language.ToUpperInvariant()</dd></div>
        </dl>

        <section class="ops-editor__panel ops-invoice" aria-labelledby="lines-title">
            <h2 id="lines-title" class="vx-visually-hidden">@T["ui.invoices.lines"]</h2>
            <InvoiceLines T="T" Invoice="invoice" />
        </section>

        <PaymentsList T="T" Payments="Payments" Refunds="Refunds" Others="OtherNames" />
        @if (CanRefund && invoice.Refundable > 0m) { <InvoiceRefundForm T="T" Invoice="invoice" Others="OtherNames" Methods="Methods" /> }
        <InvoiceCredits T="T" Invoice="invoice" CreditNotes="CreditNotes" People="People" CanApprove="CanApprove" UserId="UserId" />

        @if (CanRequest && invoice.Status == OperationsInvoiceStatus.Issued && CreditNotes.All(note => note.Status != OperationsCreditNoteStatus.Requested))
        {
            <InvoiceRequestForm T="T" Invoice="invoice" />
        }
    }
</EditorShell>

@code {
    [Parameter] public string? Company { get; set; }
    [Parameter] public OperationsInvoice? Invoice { get; set; }
    [Parameter] public IReadOnlyList<OperationsCreditNote> CreditNotes { get; set; } = Array.Empty<OperationsCreditNote>();
    [Parameter] public IReadOnlyDictionary<Guid, string> People { get; set; } = new Dictionary<Guid, string>();
    [Parameter] public bool CanRequest { get; set; }
    [Parameter] public bool CanApprove { get; set; }
    [Parameter] public Guid UserId { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? Info { get; set; }
    [Parameter] public IReadOnlyList<OperationsPayment> Payments { get; set; } = Array.Empty<OperationsPayment>();
    [Parameter] public IReadOnlyList<OperationsRefund> Refunds { get; set; } = Array.Empty<OperationsRefund>();
    [Parameter] public bool CanTake { get; set; }
    [Parameter] public bool CanRefund { get; set; }
    [Parameter] public IReadOnlyDictionary<OperationsPaymentMethod, string> OtherNames { get; set; } = new Dictionary<OperationsPaymentMethod, string>();
    [Parameter] public IReadOnlyList<OperationsPaymentMethod> Methods { get; set; } = Array.Empty<OperationsPaymentMethod>();
}