@*
=========================================================
FILE: InvoiceCredits.razor

PURPOSE:
The credit notes and voids of an invoice (Slice 5F, I-6): asked, approved or refused, by whom and why.

RESPONSIBILITIES:
- List each with its state, amount, reason and people, its PDF once approved
- Approve or refuse a request, for an approver who did not ask for it

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10)
- A person never decides their own request (the domain refuses it too)
=========================================================
*@
@if (CreditNotes.Count > 0)
{
<section class="ops-editor__panel" aria-labelledby="credits-title">
    <h2 id="credits-title">@T["ui.invoices.credits"]</h2>
    <ul class="ops-invoice__credits">
        @foreach (OperationsCreditNote note in CreditNotes)
        {
            <li data-status="@note.Status">
                <strong>@T["ui.invoices.credit_kind." + note.Kind]</strong> · @OperationsInvoiceWords.Money(note.Total, Invoice.CurrencyCode)
                · <span class="ops-editor__status" data-status="@note.Status">@T["ui.invoices.credit_status." + note.Status]</span>
                @if (note.Number is { } number)
                {
                    <span> · <a href="/staff/invoices/@Invoice.Id/pdf?credit=@note.Id" target="_blank" rel="noopener">@number</a></span>
                }
                <br /><span class="ops-editor__hint">@VixlyText.Format(T, "ui.invoices.asked_by", new Dictionary<string, object> { ["name"] = Name(note.RequestedByUserId), ["when"] = note.RequestedUtc.ToString("g", CultureInfo.CurrentCulture), ["reason"] = note.Reason })</span>
                @if (note.DecidedByUserId is { } decidedBy)
                {
                    <br /><span class="ops-editor__hint">@VixlyText.Format(T, "ui.invoices.decided_by", "name", Name(decidedBy))@(note.RefusalNote is { } why ? " · " + why : string.Empty)</span>
                }
                @if (note.Status == OperationsCreditNoteStatus.Requested && CanApprove && note.RequestedByUserId != UserId)
                {
                    <form method="post" action="/staff/invoices/credits/@note.Id/decide" class="ops-editor__inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="back" value="invoice" />
                        <button type="submit" name="approve" value="true" class="vx-button vx-button--primary">@T["ui.invoices.approve"]</button>
                        <label>@T["ui.invoices.refusal_note"] <input name="note" maxlength="500" size="24" /></label>
                        <button type="submit" name="approve" value="false" class="vx-button vx-button--secondary">@T["ui.invoices.refuse"]</button>
                    </form>
                }
                else if (note.Status == OperationsCreditNoteStatus.Requested && note.RequestedByUserId == UserId)
                {
                    <br /><span class="ops-editor__hint">@T["ui.invoices.waiting_other"]</span>
                }
            </li>
        }
    </ul>
</section>
}

@code {
    [Parameter, EditorRequired] public IStringLocalizer<OperationsText> T { get; set; } = null!;

    [Parameter, EditorRequired] public OperationsInvoice Invoice { get; set; } = null!;

    [Parameter] public IReadOnlyList<OperationsCreditNote> CreditNotes { get; set; } = Array.Empty<OperationsCreditNote>();

    [Parameter] public IReadOnlyDictionary<Guid, string> People { get; set; } = new Dictionary<Guid, string>();

    [Parameter] public bool CanApprove { get; set; }

    [Parameter] public Guid UserId { get; set; }

    private string Name(Guid userId) => People.TryGetValue(userId, out string? name) && name.Length > 0 ? name : "—";
}
