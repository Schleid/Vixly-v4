@*
=========================================================
FILE: CreditRequestsPage.razor

PURPOSE:
Credits to approve (Slice 5F, I-6): the credit notes and voids waiting for a decision in the warehouses the person approves for.

RESPONSIBILITIES:
- List each request with the invoice, customer, amount, reason and who asked; approve or refuse

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10)
- A person's own requests are listed without the buttons
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<EditorShell Title="@T["ui.invoices.requests_title"]" Company="@Company" Section="invoices" Error="@Error" Info="@Info">
    <p><a href="/staff/invoices">@T["ui.invoices.back"]</a></p>
    @if (Requests.Count == 0)
    {
        <div class="ops-editor__empty"><p>@T["ui.invoices.no_requests"]</p></div>
    }
    else
    {
        <ul class="ops-invoice__credits">
            @foreach (OperationsCreditRequestRow row in Requests)
            {
                <li>
                    <strong><a href="/staff/invoices/@row.InvoiceId">@row.InvoiceNumber</a></strong> · @row.Customer · @T["ui.invoices.credit_kind." + row.Kind]
                    · @OperationsInvoiceWords.Money(row.Total, row.CurrencyCode)
                    <br /><span class="ops-editor__hint">@VixlyText.Format(T, "ui.invoices.asked_by", new Dictionary<string, object> { ["name"] = row.RequestedBy, ["when"] = row.RequestedUtc.ToString("g", CultureInfo.CurrentCulture), ["reason"] = row.Reason })</span>
                    @if (row.Own)
                    {
                        <br /><span class="ops-editor__hint">@T["ui.invoices.waiting_other"]</span>
                    }
                    else
                    {
                        <form method="post" action="/staff/invoices/credits/@row.CreditNoteId/decide" class="ops-editor__inline">
                            <AntiforgeryToken />
                            <input type="hidden" name="back" value="credits" />
                            <button type="submit" name="approve" value="true" class="vx-button vx-button--primary">@T["ui.invoices.approve"]</button>
                            <label>@T["ui.invoices.refusal_note"] <input name="note" maxlength="500" size="24" /></label>
                            <button type="submit" name="approve" value="false" class="vx-button vx-button--secondary">@T["ui.invoices.refuse"]</button>
                        </form>
                    }
                </li>
            }
        </ul>
    }
</EditorShell>

@code {
    [Parameter] public string? Company { get; set; }

    [Parameter] public IReadOnlyList<OperationsCreditRequestRow> Requests { get; set; } = Array.Empty<OperationsCreditRequestRow>();

    [Parameter] public string? Error { get; set; }

    [Parameter] public string? Info { get; set; }
}
