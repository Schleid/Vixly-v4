@*
=========================================================
FILE: InvoicesPage.razor

PURPOSE:
Invoices (Slice 5F, I-8): find an invoice by its number, the shipment or order, or the customer, and filter by state.

RESPONSIBILITIES:
- Show the search, the requests waiting for the approver and the list

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10)
- At most 100, newest first
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<EditorShell Title="@T["ui.invoices.title"]" Company="@Company" Section="invoices" Error="@Error" Info="@Info">
    @if (Requests > 0)
    {
        <p class="ops-editor__notice"><a href="/staff/invoices/credits">@VixlyText.Format(T, "ui.invoices.requests_waiting", "count", Requests)</a></p>
    }
    <form method="get" action="/staff/invoices" class="ops-editor__filters" role="search">
        <label>@T["ui.invoices.search"] <input name="q" value="@Text" maxlength="80" size="28" autofocus /></label>
        <label>@T["ui.invoices.state"]
            <select name="state">
                @foreach (OperationsInvoiceFilter filter in Enum.GetValues<OperationsInvoiceFilter>())
                {
                    <option value="@filter" selected="@(filter == Filter)">@T["ui.invoices.filter." + filter]</option>
                }
            </select>
        </label>
        <button type="submit" class="vx-button vx-button--secondary">@T["ui.invoices.find"]</button>
    </form>
    @if (Invoices.Count == 0)
    {
        <div class="ops-editor__empty"><p>@T[Denied ? "ui.invoices.denied" : "ui.invoices.none"]</p></div>
    }
    else
    {
        <OperationsTableViewport Label="@T["ui.invoices.title"]">
            <table class="ops-editor__table">
                <thead>
                    <tr>
                        <th scope="col">@T["ui.invoices.number"]</th><th scope="col">@T["ui.invoices.date"]</th><th scope="col">@T["ui.invoices.reference"]</th>
                        <th scope="col">@T["ui.invoices.customer"]</th><th scope="col">@T["ui.invoices.warehouse"]</th><th scope="col" class="ops-editor__number">@T["ui.invoices.total"]</th>
                        <th scope="col" class="ops-editor__number">@T["ui.invoices.owed"]</th><th scope="col">@T["ui.invoices.state"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (OperationsInvoiceRow row in Invoices)
                    {
                        <tr>
                            <td><a href="/staff/invoices/@row.InvoiceId">@row.Number</a></td>
                            <td>@OperationsInvoiceWords.Day(row.IssuedOn)</td>
                            <td>@row.Reference</td>
                            <td>@row.Customer</td>
                            <td>@row.WarehouseCode</td>
                            <td class="ops-editor__number">@OperationsInvoiceWords.Money(row.Total, row.CurrencyCode)</td>
                            <td class="ops-editor__number">@OperationsInvoiceWords.Money(row.Owed, row.CurrencyCode)</td>
                            <td><span class="ops-editor__status" data-status="@OperationsInvoiceWords.State(row.Voided, row.Owed, row.Credited)">@T["ui.invoices.status." + OperationsInvoiceWords.State(row.Voided, row.Owed, row.Credited)]</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </OperationsTableViewport>
    }
</EditorShell>

@code {
    [Parameter] public string? Company { get; set; }

    [Parameter] public IReadOnlyList<OperationsInvoiceRow> Invoices { get; set; } = Array.Empty<OperationsInvoiceRow>();

    [Parameter] public int Requests { get; set; }

    [Parameter] public string? Text { get; set; }

    [Parameter] public OperationsInvoiceFilter Filter { get; set; }

    [Parameter] public bool Denied { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public string? Info { get; set; }
}
