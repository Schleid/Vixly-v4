@*
=========================================================
FILE: DispatchPage.razor

PURPOSE:
One dispatch (Slice 6B, D-2 to D-6): its bundles, its legs and its steps.

RESPONSIBILITIES:
- Show the route, service, cutoff, state and times
- Add and remove bundles while planned (chosen or scanned); add and remove legs before it leaves
- Close (manifest), depart and arrive each leg with the real time, cancel
- Open the dispatch manifest and each bundle's manifest

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10)
- Times where the company works
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<EditorShell Title="@VixlyText.Format(T, "ui.dispatch.dispatch_title", "number", Dispatch.Number)" Company="@Company" Section="dispatches" Error="@Error" Info="@Info">
    <div class="ops-list-bar" style="margin-bottom: 0.75rem;">
        <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
            <a href="/staff/dispatches" class="vx-button vx-button--secondary">@T["ui.dispatch.back"]</a>
            @if (Dispatch.Status != OperationsDispatchStatus.Cancelled) { <a class="vx-button vx-button--secondary" href="/staff/dispatches/@Dispatch.Id/manifest" target="_blank" rel="noopener">@T["ui.dispatch.manifest"]</a> }
            @if (Dispatch.Status is not (OperationsDispatchStatus.Cancelled or OperationsDispatchStatus.Planned)) { <a class="vx-button vx-button--secondary" href="/staff/dispatches/@Dispatch.Id/sli" target="_blank" rel="noopener">@T["ui.dispatch.sli"]</a> }
            @if (Shipments.Count > 0 && Dispatch.TravelsByAir) { <a class="vx-button vx-button--secondary" href="/staff/dispatches/@Dispatch.Id/hawb" target="_blank" rel="noopener">@T["ui.dispatch.hawb_all"]</a> }
        </div>
        <div class="ops-list-bar__actions">
            <span class="ops-editor__status" data-status="@Dispatch.Status.ToString().ToLowerInvariant()">@T["ui.dispatch.status." + Dispatch.Status]</span>
        </div>
    </div>

    <section class="ops-editor__panel" aria-labelledby="dispatch-title">
        <h2 id="dispatch-title">@Warehouse.Code &gt; @OperationsBundleWords.Destination(T, Dispatch.DestinationWarehouseId, Dispatch.DestinationCountryCode, Destination is null ? Array.Empty<OperationsWarehouse>() : new[] { Destination })</h2>
        <dl class="ops-facts-grid">
            <div class="ops-fact-cell"><dt>@T["ui.dispatch.state"]</dt><dd><span class="ops-editor__status" data-status="@Dispatch.Status.ToString().ToLowerInvariant()">@T["ui.dispatch.status." + Dispatch.Status]</span></dd></div>
            <div class="ops-fact-cell"><dt>@T["ui.dispatch.service"]</dt><dd>@T["ui.services.name." + Dispatch.ServiceCode]</dd></div>
            @if (Dispatch.CutoffUtc is not null) { <div class="ops-fact-cell"><dt>@T["ui.dispatch.cutoff"]</dt><dd>@OperationsDispatchWords.Time(Dispatch.CutoffUtc, TimeZone)</dd></div> }
            <div class="ops-fact-cell"><dt>@T["ui.dispatch.bundles"]</dt><dd>@Bundles.Count · @VixlyText.Format(T, "ui.dispatch.pieces", "count", Bundles.Sum(bundle => bundle.ParcelCount)) · @OperationsBundleWords.Weight(Bundles.Sum(bundle => bundle.WeightKg ?? 0m), WeightUnit)</dd></div>
            @if (Dispatch.ClosedUtc is not null) { <div class="ops-fact-cell"><dt>@T["ui.dispatch.closed_at"]</dt><dd>@OperationsDispatchWords.Time(Dispatch.ClosedUtc, TimeZone)</dd></div> }
            @if (Dispatch.DepartedUtc is not null) { <div class="ops-fact-cell"><dt>@T["ui.dispatch.departed_at"]</dt><dd>@OperationsDispatchWords.Time(Dispatch.DepartedUtc, TimeZone)</dd></div> }
            @if (Dispatch.ArrivedUtc is not null) { <div class="ops-fact-cell"><dt>@T["ui.dispatch.arrived_at"]</dt><dd>@OperationsDispatchWords.Time(Dispatch.ArrivedUtc, TimeZone)</dd></div> }
            @if (Dispatch.Notes is { } notes) { <div class="ops-fact-cell"><dt>@T["ui.dispatch.notes"]</dt><dd>@notes</dd></div> }
            @if (Dispatch.CancelReason is { } reason) { <div class="ops-fact-cell"><dt>@T["ui.dispatch.cancel_reason"]</dt><dd>@reason</dd></div> }
        </dl>
        <p class="ops-editor__hint" style="margin-top: 0.75rem;">@VixlyText.Format(T, "ui.dispatch.times_in", "zone", OperationsDispatchWords.Zone(TimeZone))</p>
    </section>

    <section class="ops-editor__panel" aria-labelledby="bundles-title">
        <h2 id="bundles-title">@T["ui.dispatch.bundles"]</h2>
        @if (Bundles.Count == 0)
        {
            <div class="ops-editor__empty"><p>@T["ui.dispatch.bundles_none"]</p></div>
        }
        else
        {
            <OperationsTableViewport Label="@T["ui.dispatch.bundles"]">
                <table class="ops-editor__table">
                    <thead><tr><th scope="col" class="ops-editor__identity-cell">@T["ui.bundles.number"]</th><th scope="col">@T["ui.bundles.type"]</th><th scope="col" class="ops-editor__number">@T["ui.bundles.parcels"]</th><th scope="col" class="ops-editor__number">@T["ui.bundles.weight"]</th><th scope="col"></th></tr></thead>
                    <tbody>
                        @foreach (OperationsBundle bundle in Bundles)
                        {
                            <tr>
                                <td class="ops-editor__identity-cell ops-editor__code"><a href="/staff/bundles/@bundle.Id">@bundle.Number</a></td>
                                <td>@bundle.TypeName</td>
                                <td class="ops-editor__number">@bundle.ParcelCount</td>
                                <td class="ops-editor__number">@(bundle.WeightKg is { } kg ? OperationsBundleWords.Weight(kg, WeightUnit) : string.Empty)</td>
                                <td>
                                    <a href="/staff/bundles/@bundle.Id/manifest" target="_blank" rel="noopener">@T["ui.dispatch.bundle_manifest"]</a>
                                    @if (Dispatch.Status == OperationsDispatchStatus.Planned)
                                    {
                                        <form method="post" action="/staff/dispatches/@Dispatch.Id/bundles/@bundle.Id/remove" class="ops-editor__inline">
                                            <AntiforgeryToken />
                                            <button type="submit" class="vx-button vx-button--secondary">@T["ui.dispatch.remove"]</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </OperationsTableViewport>
        }
        @if (Dispatch.Status == OperationsDispatchStatus.Planned)
        {
            <form method="post" action="/staff/dispatches/@Dispatch.Id/bundles" class="ops-inline-action-bar" style="margin: 0.75rem 0; padding: 0.5rem 0;">
                <AntiforgeryToken />
                <label for="dispatch-scan-input" class="ops-inline-action-bar__label">@T["ui.dispatch.scan_bundle"]</label>
                <input id="dispatch-scan-input" name="number" autocomplete="off" autofocus maxlength="40" class="ops-inline-action-bar__select" style="width: 16rem;" />
                <button type="submit" class="vx-button vx-button--primary">@T["ui.dispatch.add_bundle"]</button>
            </form>
            @if (Candidates.Count > 0)
            {
                <h3>@T["ui.dispatch.candidates"]</h3>
                <ul class="ops-editor__list">
                    @foreach (OperationsBundle bundle in Candidates)
                    {
                        <li>
                            <span class="ops-editor__code">@bundle.Number</span> @bundle.TypeName · @bundle.ParcelCount · @(bundle.WeightKg is { } kg ? OperationsBundleWords.Weight(kg, WeightUnit) : string.Empty)
                            <form method="post" action="/staff/dispatches/@Dispatch.Id/bundles" class="ops-editor__inline">
                                <AntiforgeryToken />
                                <input type="hidden" name="bundle" value="@bundle.Id" />
                                <button type="submit" class="vx-button vx-button--secondary">@T["ui.dispatch.add_bundle"]</button>
                            </form>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="ops-editor__hint">@T["ui.dispatch.candidates_none"]</p>
            }
        }
    </section>

    <DispatchLegsPanel Dispatch="@Dispatch" Carriers="@Carriers" TimeZone="@TimeZone" />
    <DispatchPapersPanel Dispatch="@Dispatch" Shipments="@Shipments" WeightUnit="@WeightUnit" />

    @if (Dispatch.Status == OperationsDispatchStatus.Planned)
    {
        <form method="post" action="/staff/dispatches/@Dispatch.Id/close" class="ops-editor__panel ops-editor__form" aria-labelledby="close-title">
            <AntiforgeryToken />
            <h2 id="close-title">@T["ui.dispatch.close"]</h2>
            <button type="submit" class="vx-button vx-button--primary" disabled="@(Bundles.Count == 0 || Dispatch.Legs.Count == 0)">@T["ui.dispatch.close_button"]</button>
            <p class="ops-editor__hint">@T["ui.dispatch.close_hint"]</p>
        </form>
    }
    @if (Dispatch.Status is OperationsDispatchStatus.Planned or OperationsDispatchStatus.Closed)
    {
        <form method="post" action="/staff/dispatches/@Dispatch.Id/cancel" class="ops-editor__panel ops-panel--restricted" aria-labelledby="cancel-title">
            <AntiforgeryToken />
            <h2 id="cancel-title">@T["ui.dispatch.cancel"]</h2>
            <div class="ops-inline-action-bar" style="padding: 0; margin-top: 0.5rem;">
                <label for="dispatch-cancel-reason" class="ops-inline-action-bar__label">@T["ui.dispatch.cancel_reason"]</label>
                <input id="dispatch-cancel-reason" name="reason" maxlength="300" required class="ops-inline-action-bar__select" style="width: 20rem;" />
                <button type="submit" class="vx-button vx-button--secondary">@T["ui.dispatch.cancel_button"]</button>
            </div>
            <p class="ops-editor__hint" style="margin-top: 0.5rem;">@T["ui.dispatch.cancel_hint"]</p>
        </form>
    }
</EditorShell>

@code {
    [Parameter] public string? Company { get; set; }

    [Parameter, EditorRequired] public OperationsDispatch Dispatch { get; set; } = null!;

    [Parameter, EditorRequired] public OperationsWarehouse Warehouse { get; set; } = null!;

    [Parameter] public OperationsWarehouse? Destination { get; set; }

    [Parameter] public IReadOnlyList<OperationsBundle> Bundles { get; set; } = Array.Empty<OperationsBundle>();

    [Parameter] public IReadOnlyList<OperationsBundle> Candidates { get; set; } = Array.Empty<OperationsBundle>();

    [Parameter] public IReadOnlyList<OperationsCarrier> Carriers { get; set; } = Array.Empty<OperationsCarrier>();

    [Parameter] public OperationsWeightUnit WeightUnit { get; set; }

    [Parameter] public string? TimeZone { get; set; }

    [Parameter] public IReadOnlyList<OperationsDispatchShipmentRow> Shipments { get; set; } = Array.Empty<OperationsDispatchShipmentRow>();

    [Parameter] public string? Error { get; set; }

    [Parameter] public string? Info { get; set; }
}