@*
=========================================================
FILE: CarrierForm.razor

PURPOSE:
The form of a carrier, new or existing (Slice 6B, D-1).

RESPONSIBILITIES:
- Name, kind, account number, airline prefix (air), active

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10)
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<form method="post" action="@(Carrier is null ? "/staff/carriers" : "/staff/carriers/" + Carrier.Id)" class="ops-editor__panel ops-editor__form" aria-labelledby="carrier-form-title">
    <AntiforgeryToken />
    <h2 id="carrier-form-title">@T[Carrier is null ? "ui.carriers.new" : "ui.carriers.edit"]</h2>
    <div class="ops-charges-duo">
        <div>
            <label>@T["ui.carriers.name"] <input name="name" value="@Carrier?.Name" maxlength="@OperationsCarrier.NameMaxLength" required /></label>
        </div>
        <div>
            <label>@T["ui.carriers.kind"]
                <select name="kind">
                    @foreach (OperationsCarrierKind kind in Enum.GetValues<OperationsCarrierKind>())
                    {
                        <option value="@kind" selected="@(Carrier?.Kind == kind)">@T["ui.dispatch.mode." + OperationsDispatching.Mode(kind)]</option>
                    }
                </select>
            </label>
        </div>
    </div>
    <div class="ops-charges-duo">
        <div>
            <label>@T["ui.carriers.account"] <input name="account" value="@Carrier?.AccountNumber" maxlength="@OperationsCarrier.AccountMaxLength" /></label>
        </div>
        <div>
            <label>@T["ui.carriers.prefix"] <input name="prefix" value="@Carrier?.AirlinePrefix" maxlength="3" inputmode="numeric" pattern="[0-9]{3}" size="4" /></label>
            <p class="ops-editor__hint">@T["ui.carriers.prefix_hint"]</p>
        </div>
    </div>
    @if (Carrier is not null)
    {
        <div class="ops-checkbox-group" style="margin: 0.5rem 0;">
            <label class="ops-checkbox-label">
                <input type="checkbox" name="active" value="true" checked="@Carrier.IsActive" />
                <span>@T["ui.carriers.active"]</span>
            </label>
        </div>
    }
    else
    {
        <input type="hidden" name="active" value="true" />
    }
    <p class="ops-editor__actions"><button type="submit" class="vx-button vx-button--primary">@T["ui.editor.save"]</button></p>
</form>

@code {
    [Parameter] public OperationsCarrier? Carrier { get; set; }
}
