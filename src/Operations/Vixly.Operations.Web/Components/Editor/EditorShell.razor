@*
=========================================================
FILE: EditorShell.razor

PURPOSE:
The HTML document around every site editor page.

RESPONSIBILITIES:
- Render the HTML document around every site editor page
- Enforce compact header <= 56px with single topbar title and quick lookup

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10); values come from the endpoint
- Tenant surface: never says "Vixly" (ADR-0012 W-1); endpoints enforce access
- Static forms with antiforgery and the form guard (ADR-0019)
=========================================================
*@
@inject IStringLocalizer<OperationsText> T
@inject Vixly.Shared.Hosting.Maintenance.VixlyMaintenanceMonitor Maintenance
@inject IStringLocalizer<OperationsWorkbenchText> L
@inject IHttpContextAccessor IdleHttp

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex" />
    <title>@Title &middot; @Company</title>
    <link rel="stylesheet" href="/_content/Vixly.Shared.UI/vixly-theme.css" />
    <link rel="stylesheet" href="/_content/Vixly.Shared.UI/vixly-primitives.css" />
    <link rel="stylesheet" href="/css/ops-editor.css?v=20261029-4" />
    <link rel="stylesheet" href="/css/ops-help.css?v=20261025-1" />
    <link rel="stylesheet" href="/css/ops-experience.css?v=20261018-customer3" />
    <link rel="stylesheet" href="/css/ops-inspection.css?v=20261019-1" />
    <link rel="stylesheet" href="/css/ops-continuity.css?v=20261026-3" />
    <link rel="stylesheet" href="/css/ops-counter.css?v=20261020-2" />
    <script src="/_content/Vixly.Shared.UI/vixly-forms.js" defer></script>
    <script src="/js/ops-theme.js" defer></script>
    <script src="/js/ops-session.js" defer></script>
    <script src="/js/ops-workbench.js" defer></script>
    <script src="/js/ops-tabs.js?v=20261020-1" defer></script>
    <script src="/js/ops-counter-side.js?v=20261020-1" defer></script>
    <script src="/js/ops-estimate.js?v=20261020-1" defer></script>
    <script src="/js/ops-camera-reader.js?v=20261027-1" defer></script>
    <script src="/js/ops-camera-field.js?v=20261027-1" defer></script>
    <script src="/js/ops-logo-trim.js?v=20261025-1" defer></script>
    <script src="/js/ops-cashier-tenders.js?v=20261026-1" defer></script>
</head>
<body class="ops-editor" data-idle-warn="@Vixly.Operations.Web.Security.OperationsIdlePage.WarnSeconds(IdleHttp.HttpContext)" data-idle-end="@Vixly.Operations.Web.Security.OperationsIdlePage.EndSeconds(IdleHttp.HttpContext)">
    <a class="ops-editor__skip" href="#main-content">@T["site.skip"]</a>
    @if (Vixly.Shared.Hosting.Maintenance.VixlyMaintenanceBanner.Banner(Maintenance, "staff", T) is { } maintenance)
    {
        <p class="vx-maintenance-banner" role="status">@maintenance</p>
    }
    <aside id="ops-navigation" class="ops-editor__sidebar" aria-label="@L["navigation"]" tabindex="-1">
        <a href="/staff" class="ops-editor__brand">
            <span class="ops-editor__mark" aria-hidden="true">@Initials</span>
            <span>@Company<small>@L["portal"]</small></span>
        </a>
        <button type="button" hidden data-nav-close class="ops-editor__nav-close" aria-label="@L["close_menu"]"><span aria-hidden="true">&times;</span></button>
        <OperationsNavigation Section="@Section" />
        <footer class="ops-editor__sidebar-footer">
            <a href="/staff/account" aria-current="@(Section == "account" ? "page" : null)">@T["ui.editor.nav.account"]</a>
            <form method="post" action="/staff/sign-out" data-sign-out>
                <AntiforgeryToken />
                <button type="submit">@T["ui.signout"]</button>
            </form>
        </footer>
    </aside>
    <button type="button" hidden data-nav-backdrop class="ops-editor__backdrop" aria-label="@L["close_menu"]" tabindex="-1"></button>
    <header class="ops-editor__topbar">
        <button type="button" hidden data-nav-toggle class="ops-editor__menu-button" aria-controls="ops-navigation" aria-expanded="false" aria-label="@L["navigation"]">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
        <div class="ops-editor__breadcrumb">
            <span class="ops-editor__breadcrumb-sub">@L["portal"]</span>
            <span aria-hidden="true" class="ops-editor__breadcrumb-sep">/</span>
            <h1 class="ops-editor__title">@Title</h1>
        </div>
        <form class="ops-editor__quicksearch" method="get" action="/staff/counter" role="search" data-enhance="false">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="search" name="find" id="ops-quick-search" maxlength="100" placeholder="@T["ui.customers.search"]" class="ops-editor__quicksearch-input" aria-label="@T["ui.customers.search"]" />
            <kbd class="ops-editor__kbd" aria-hidden="true">Ctrl / &#x2318; K</kbd>
        </form>
        <div class="ops-editor__topbar-actions">
            <Vixly.Operations.Web.Components.Help.OperationsHelpLink Company="@Company" />
            <button type="button" class="ops-editor__theme-btn" id="ops-theme-toggle" title="Theme" aria-label="Theme" data-vx-theme-toggle aria-pressed="false">
                <svg class="vx-theme-icon vx-theme-icon--dark" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                <svg class="vx-theme-icon vx-theme-icon--light" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
            </button>
            <a href="/" class="ops-editor__site-link">@T["ui.editor.nav.site"] <span aria-hidden="true">&nearr;</span></a>
        </div>
    </header>
    <main id="main-content" class="ops-editor__main" data-section="@Section" tabindex="-1">
        <AccessBanner />
        <FormMessage Error="@Error" Info="@Info" />
        @ChildContent
    </main>
    <div class="vx-auth__idle" role="alertdialog" aria-live="assertive" data-idle-warning hidden>
        <p>@T["ui.session.idle_warning"]</p>
        <p class="ops-idle__time">@T["ui.session.time_left"] <strong data-idle-countdown aria-live="off">2:00</strong></p>
        <button type="button" class="vx-button vx-button--primary" data-idle-stay>@T["ui.session.stay"]</button>
    </div>
</body>
</html>

@code {
    private string Initials => string.IsNullOrWhiteSpace(Company) ? string.Empty : string.Concat(Company.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(word => System.Globalization.StringInfo.GetNextTextElement(word))).ToUpperInvariant();

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Company { get; set; }

    [Parameter]
    public string Section { get; set; } = string.Empty;

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public string? Info { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
