@*
=========================================================
FILE: EditorShell.razor

PURPOSE:
The HTML document around every site editor page.

RESPONSIBILITIES:
- Render the HTML document around every site editor page

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10); values come from the endpoint
- Tenant surface: never says "Vixly" (ADR-0012 W-1); owner only (the use cases refuse others)
- Static forms with antiforgery and the form guard (ADR-0019); Operations task navigation and responsive workbench styling
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex" />
    <title>@Title · @Company</title>
    <link rel="stylesheet" href="/_content/Vixly.Shared.UI/vixly-theme.css" />
    <link rel="stylesheet" href="/_content/Vixly.Shared.UI/vixly-primitives.css" />
    <link rel="stylesheet" href="/css/ops-editor.css" />
    <script src="/_content/Vixly.Shared.UI/vixly-forms.js" defer></script>
    <script src="/js/ops-session.js" defer></script>
</head>
<body class="ops-editor" data-idle-warn="780" data-idle-end="900">
    <a class="ops-editor__skip" href="#main-content">@T["site.skip"]</a>
    <header class="ops-editor__bar">
        <strong>@Company</strong>
        <nav aria-label="@T["ui.editor.nav"]">
            <a href="/staff">@T["ui.editor.nav.workspace"]</a>
            <a href="/staff/site" aria-current="@(Section == "site" ? "page" : null)">@T["ui.editor.nav.site"]</a>
            <a href="/staff/locations" aria-current="@(Section == "locations" ? "page" : null)">@T["ui.editor.nav.locations"]</a>
            <a href="/staff/devices" aria-current="@(Section == "devices" ? "page" : null)">@T["ui.editor.nav.devices"]</a>
            <a href="/staff/people" aria-current="@(Section == "staff" ? "page" : null)">@T["ui.editor.nav.staff"]</a>
            <a href="/staff/roles" aria-current="@(Section == "roles" ? "page" : null)">@T["ui.editor.nav.roles"]</a>
            <a href="/staff/company" aria-current="@(Section == "company" ? "page" : null)">@T["ui.editor.nav.company"]</a>
            <a href="/staff/billing" aria-current="@(Section == "billing" ? "page" : null)">@T["ui.editor.nav.billing"]</a>
            <a href="/staff/settings" aria-current="@(Section == "settings" ? "page" : null)">@T["ui.editor.nav.settings"]</a>
            <a href="/staff/audit" aria-current="@(Section == "audit" ? "page" : null)">@T["ui.editor.nav.audit"]</a>
            <a href="/staff/legal" aria-current="@(Section == "legal" ? "page" : null)">@T["ui.editor.nav.legal"]</a>
            <a href="/staff/account" aria-current="@(Section == "account" ? "page" : null)">@T["ui.editor.nav.account"]</a>
        </nav>
        <form method="post" action="/staff/sign-out">
            <AntiforgeryToken />
            <button type="submit" class="vx-button vx-button--secondary">@T["ui.signout"]</button>
        </form>
    </header>
    <main id="main-content" class="ops-editor__main">
        <AccessBanner />
        <h1>@Title</h1>
        <FormMessage Error="@Error" Info="@Info" />
        @ChildContent
    </main>
    <div class="vx-auth__idle" role="alertdialog" aria-live="assertive" data-idle-warning hidden>
        <p>@T["ui.session.idle_warning"]</p>
        <button type="button" class="vx-button vx-button--primary" data-idle-stay>@T["ui.session.stay"]</button>
    </div>
</body>
</html>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Company { get; set; }

    [Parameter]
    public string Section { get; set; } = string.Empty;

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public string? Info { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
