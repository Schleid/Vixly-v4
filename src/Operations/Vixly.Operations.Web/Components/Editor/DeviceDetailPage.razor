@*
=========================================================
FILE: DeviceDetailPage.razor

PURPOSE:
One device of the company (owner, 2026-10-21): its licence,
where and when it was registered, who authorised it; approve or
deny a request, release a licence.

RESPONSIBILITIES:
- Render the device and the actions the person may take

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10); values come from the endpoint
- Each action asks for a fresh authenticator code (step-up)
- Placeholder look: Frontend/UI designs the final experience
=========================================================
*@
@inherits OperationsAllowedComponent
@using Vixly.Operations.Application.Ports
@using Vixly.Operations.Domain.Access
@inject IStringLocalizer<OperationsText> T

<EditorShell Title="@Device.Name" Company="@Company" Section="company" Error="@Error">
    <CompanyTabs Current="licences" />
    <p><a href="/staff/devices">@T["ui.licences.back"]</a></p>
    <section class="ops-editor__panel">
        <dl class="ops-editor__facts">
            <dt>@T["ui.licences.device_id"]</dt><dd>@Device.Number</dd>
            <dt>@T["ui.licences.status"]</dt><dd><span class="ops-editor__status" data-status="@Device.Status">@T["ui.licences.status." + Device.Status]</span></dd>
            <dt>@T["ui.devices.kind"]</dt><dd>@T["ui.devices.kind." + Device.Kind]</dd>
            <dt>@T["ui.devices.browser"]</dt><dd>@(Device.Browser ?? "-")</dd>
            <dt>@T["ui.devices.registered"]</dt><dd>@Time(Device.RequestedUtc)</dd>
            <dt>@T["ui.devices.requested_by"]</dt><dd>@(Device.RequestedByName ?? "-")</dd>
            <dt>@T["ui.devices.authorised_by"]</dt>
            <dd>@(Device.ApprovedUtc is { } approved ? (Device.ApprovedByName ?? T["ui.devices.authorised_by_link"].Value) + ", " + Time(approved) : "-")</dd>
            <dt>@T["ui.devices.last_seen"]</dt><dd>@(Device.LastSeenUtc is { } seen ? Time(seen) : "-")</dd>
        </dl>
    </section>
    @if (Device.Status == "pending" && Can(OperationsPermissions.DevicesApprove))
    {
        <section class="ops-editor__panel">
            <h2>@T["ui.licences.decide"]</h2>
            <form method="post" action="/staff/devices/@Device.DeviceId/decide" class="ops-editor__inline">
                <AntiforgeryToken />
                <input name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required placeholder="@T["ui.devices.code"]" aria-label="@T["ui.devices.code"]" />
                <button type="submit" name="approve" value="true" class="vx-button vx-button--primary">@T["ui.devices.approve"]</button>
                <button type="submit" name="approve" value="false" class="vx-button vx-button--secondary">@T["ui.devices.deny"]</button>
            </form>
        </section>
    }
    else if (Device.Status == "active" && Can(OperationsPermissions.DevicesRelease))
    {
        <section class="ops-editor__panel">
            <h2>@T["ui.licences.release_title"]</h2>
            <form method="post" action="/staff/devices/@Device.DeviceId/release" class="ops-editor__inline">
                <AntiforgeryToken />
                <select name="reason" aria-label="@T["ui.devices.reason"]">
                    @foreach (string reason in Vixly.Operations.Application.UseCases.Devices.ReleaseOperationsDevice.ReleaseOperationsDeviceUseCase.Reasons)
                    {
                        <option value="@reason">@T["ui.devices.reason." + reason]</option>
                    }
                </select>
                <input name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required placeholder="@T["ui.devices.code"]" aria-label="@T["ui.devices.code"]" />
                <button type="submit" class="vx-button vx-button--secondary">@T["ui.devices.release"]</button>
            </form>
        </section>
    }
</EditorShell>

@code {
    [Parameter] public string? Company { get; set; }

    [Parameter, EditorRequired] public OperationsDevice Device { get; set; } = null!;

    [Parameter] public string? Error { get; set; }

    private static string Time(DateTimeOffset utc) => utc.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture) + " UTC";
}
