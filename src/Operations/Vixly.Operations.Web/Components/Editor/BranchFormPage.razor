@*
=========================================================
FILE: BranchFormPage.razor

PURPOSE:
The form for one branch: a country or market the company serves (owner, 2026-10-29).

RESPONSIBILITIES:
- Render the form for one branch: code, name, country, legal identity, optional office, status

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10); values come from the endpoint
- Tenant surface: never says "Vixly" (ADR-0012 W-1); owner only (the use cases refuse others)
- Static forms with antiforgery and the form guard (ADR-0019); placeholder look: Frontend/UI designs the final experience
=========================================================
*@
@inherits OperationsAllowedComponent
@using Vixly.Operations.Domain.Access
@inject IStringLocalizer<OperationsText> T

<EditorShell Title="@T[Form.BranchId is null ? "ui.editor.branch.add" : "ui.editor.branch.edit"]" Company="@Company" Section="locations" Error="@Error">
    <form method="post" action="/staff/locations/branch" class="ops-editor__panel ops-editor__form">
        <AntiforgeryToken />
        <input type="hidden" name="branchId" value="@Form.BranchId" />
        <label class="ops-editor__form-span-2">@T["ui.editor.code"] <input name="code" value="@Form.Code" maxlength="@OperationsLocationLimits.CodeMaxLength" required /></label>
        <label class="ops-editor__form-span-4">@T["ui.editor.name"] <input name="name" value="@Form.Name" maxlength="@OperationsLocationLimits.NameMaxLength" required /></label>
        <p class="ops-editor__hint" style="grid-column: 1 / -1;">@T["ui.editor.branch.hint"]</p>
        <CountrySelect Name="countryCode" Value="@Form.CountryCode" Class="ops-editor__form-span-3" />
        <fieldset class="ops-editor__panel-fieldset" style="grid-column: 1 / -1;">
            <legend>@T["ui.editor.branch.legal"]</legend>
            <p class="ops-editor__hint" style="grid-column: 1 / -1;">@T["ui.editor.branch.legal_hint"]</p>
            <label>@T["ui.editor.branch.legal_name"] <input name="legalName" value="@Form.LegalName" maxlength="@OperationsBranch.LegalNameMaxLength" /></label>
            <label>@T["ui.editor.branch.tax_number"] <input name="taxNumber" value="@Form.TaxNumber" maxlength="@OperationsBranch.TaxNumberMaxLength" /></label>
            <label style="grid-column: 1 / -1;">@T["ui.editor.branch.legal_notes"] <textarea name="legalNotes" maxlength="@OperationsBranch.LegalNotesMaxLength" rows="3">@Form.LegalNotes</textarea></label>
        </fieldset>
        <AddressFields Line1="@Form.Line1" Line2="@Form.Line2" City="@Form.City" Region="@Form.Region" PostalCode="@Form.PostalCode" CountryCode="@Form.CountryCode"
                       Optional="true" ShowCountry="false" Legend="ui.editor.branch.office" Hint="ui.editor.branch.office_hint" />
        <ContactFields Phone="@Form.Phone" Email="@Form.Email" OpeningHours="@Form.OpeningHours" />
        <StatusFields Status="@Form.Status" ShowOnSite="@Form.ShowOnSite" Class="ops-editor__form-span-3" />
        <div class="ops-editor__form-actions">
            @if (Can(OperationsPermissions.BranchesManage)) { <button type="submit" class="vx-button vx-button--primary">@T["ui.editor.save"]</button> }
            <a class="vx-button vx-button--secondary" href="/staff/locations">@T["ui.editor.cancel"]</a>
        </div>
    </form>
</EditorShell>

@code {
    [Parameter] public string? Company { get; set; }

    [Parameter, EditorRequired] public SaveOperationsBranchRequest Form { get; set; } = null!;

    [Parameter] public string? Error { get; set; }
}
