@*
=========================================================
FILE: WarehouseFormPage.razor

PURPOSE:
The form for one warehouse.

RESPONSIBILITIES:
- Render the form for one warehouse

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10); values come from the endpoint
- Tenant surface: never says "Vixly" (ADR-0012 W-1); owner only (the use cases refuse others)
- Static forms with antiforgery and the form guard (ADR-0019); placeholder look: Frontend/UI designs the final experience
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<EditorShell Title="@T[Form.WarehouseId is null ? "ui.editor.warehouse.add" : "ui.editor.warehouse.edit"]" Company="@Company" Section="locations" Error="@Error">
    <form method="post" action="/staff/locations/warehouse" class="ops-editor__panel">
        <AntiforgeryToken />
        <input type="hidden" name="warehouseId" value="@Form.WarehouseId" />
        <label>@T["ui.editor.warehouse.branch"]
            <select name="branchId" required>
                @foreach (OperationsBranch branch in Branches)
                {
                    <option value="@branch.Id" selected="@(branch.Id == Form.BranchId)">@branch.Code · @branch.Name</option>
                }
            </select>
        </label>
        <label>@T["ui.editor.code"] <input name="code" value="@Form.Code" maxlength="@OperationsLocationLimits.CodeMaxLength" required /></label>
        <label>@T["ui.editor.name"] <input name="name" value="@Form.Name" maxlength="@OperationsLocationLimits.NameMaxLength" required /></label>
        <p class="ops-editor__hint">@T["ui.editor.warehouse.country_hint"]</p>
        <AddressFields Line1="@Form.Line1" Line2="@Form.Line2" City="@Form.City" Region="@Form.Region" PostalCode="@Form.PostalCode" CountryCode="@Form.CountryCode" />
        <ContactFields Phone="@Form.Phone" Email="@Form.Email" OpeningHours="@Form.OpeningHours" />
        <fieldset>
            <legend>@T["ui.editor.warehouse.roles"]</legend>
            @foreach (OperationsWarehouseRoles role in new[] { OperationsWarehouseRoles.Receiving, OperationsWarehouseRoles.DispatchHub, OperationsWarehouseRoles.PickupPoint })
            {
                <label><input type="checkbox" name="roles" value="@role" checked="@Form.Roles.HasFlag(role)" /> @T["ui.editor.role." + role.ToString().ToLowerInvariant()]</label>
            }
            <label><input type="checkbox" name="acceptingDeliveries" value="true" checked="@Form.AcceptingDeliveries" /> @T["ui.editor.warehouse.accepting"]</label>
        </fieldset>
        <StatusFields Status="@Form.Status" ShowOnSite="@Form.ShowOnSite" />
        <p class="ops-editor__actions">
            <button type="submit" class="vx-button vx-button--primary">@T["ui.editor.save"]</button>
            <a href="/staff/locations">@T["ui.editor.cancel"]</a>
        </p>
    </form>
</EditorShell>

@code {
    [Parameter] public string? Company { get; set; }

    [Parameter, EditorRequired] public SaveOperationsWarehouseRequest Form { get; set; } = null!;

    [Parameter] public IReadOnlyList<OperationsBranch> Branches { get; set; } = Array.Empty<OperationsBranch>();

    [Parameter] public string? Error { get; set; }
}
