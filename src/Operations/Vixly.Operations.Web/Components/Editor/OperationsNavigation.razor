@inject IStringLocalizer<OperationsText> T
@inject IStringLocalizer<OperationsWorkbenchText> L
@* =========================================================
FILE: OperationsNavigation.razor

PURPOSE:
Group the existing Operations routes into a navigable workbench.

RESPONSIBILITIES:
- Render native collapsible navigation groups and current-page state

IMPORTANT NOTES:
- Navigation never grants access; existing endpoints enforce permissions
- No links to unimplemented shipment or dispatch screens
========================================================= *@
<nav aria-label="@L["navigation"]" class="ops-nav">
    @foreach (var group in Groups)
    {
        <details open class="ops-nav__group">
            <summary>@L[group.Key]</summary>
            @foreach (var item in group.Items)
            {
                <a href="@item.Url" aria-current="@(Section == item.Section ? "page" : null)">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@Icon(item.Section)" /></svg>
                    <span>@T["ui.editor.nav." + item.Label]</span>
                </a>
            }
        </details>
    }
</nav>

@code {
    [Parameter] public string Section { get; set; } = string.Empty;

    private static readonly (string Key, (string Section, string Url, string Label)[] Items)[] Groups =
    {
        ("workspace", new[] { ("workspace", "/staff", "workspace"), ("customers", "/staff/customers", "customers") }),
        ("business", new[] { ("locations", "/staff/locations", "locations"), ("services", "/staff/services", "services"), ("billing", "/staff/billing", "billing"), ("site", "/staff/site", "site") }),
        ("administration", new[] { ("staff", "/staff/people", "staff"), ("roles", "/staff/roles", "roles"), ("devices", "/staff/devices", "devices"), ("company", "/staff/company", "company"), ("settings", "/staff/settings", "settings"), ("audit", "/staff/audit", "audit"), ("legal", "/staff/legal", "legal") })
    };

    private static string Icon(string section) => section switch
    {
        "workspace" => "M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z",
        "customers" or "staff" => "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M22 21v-2a4 4 0 0 0-3-3.87M9 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8M16 3a4 4 0 0 1 0 8",
        "locations" => "m3 21 0-13 9-5 9 5v13M7 21V11h10v10M8 15h8M8 18h8",
        "devices" => "M3 3h18v13H3zM8 21h8M12 16v5",
        "roles" or "legal" => "m12 2 9 4v6c0 5-9 10-9 10S3 17 3 12V6l9-4Zm-4 10 3 3 5-6",
        "billing" => "M5 2h14v20l-3-2-4 2-4-2-3 2V2Zm3 5h8M8 11h8M8 15h5",
        "site" => "M3 3h18v18H3zM3 8h18M8 8v13",
        "services" => "m3 7 9-5 9 5-9 5-9-5Zm0 0v10l9 5 9-5V7M12 12v10",
        "audit" => "M4 3h16v18H4zM8 7h8M8 12h8M8 17h5",
        "company" => "M4 21V5h10v16M14 10h6v11M2 21h20M8 9h2M8 13h2M8 17h2",
        "account" => "M20 21v-2a7 7 0 0 0-14 0v2M13 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8",
        _ => "M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M5 19l2-2M17 7l2-2"
    };
}
