@inject IStringLocalizer<OperationsText> T
@inject IStringLocalizer<OperationsWorkbenchText> L
@inherits OperationsAllowedComponent
@using Vixly.Operations.Application.UseCases.Staff.GetOperationsMenu
@using Vixly.Operations.Domain.Access
@* =========================================================
FILE: OperationsNavigation.razor

PURPOSE:
Group the existing Operations routes into a navigable workbench.

RESPONSIBILITIES:
- Render native collapsible navigation groups and current-page state
- Show only the pages the person's role allows; a group with none is left out (owner, 2026-10-18)

IMPORTANT NOTES:
- Navigation never grants access; existing endpoints enforce permissions. Hiding is a second layer, not the protection
- No links to unimplemented shipment or dispatch screens
========================================================= *@
<nav aria-label="@L["navigation"]" class="ops-nav">
    @foreach (var group in Groups.Where(group => group.Items.Any(item => Visible(item.Permissions, Allowance))))
    {
        <details open class="ops-nav__group">
            <summary>@L[group.Key]</summary>
            @foreach (var item in group.Items.Where(item => Visible(item.Permissions, Allowance)))
            {
                <a href="@item.Url" aria-current="@(Section == item.Section ? "page" : null)">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@Icon(item.Section)" /></svg>
                    <span>@T["ui.editor.nav." + item.Label]</span>
                </a>
            }
        </details>
    }
</nav>

@code {
    [Parameter] public string Section { get; set; } = string.Empty;

    // An item with no permission is open to every signed-in person; otherwise any one of its permissions shows it.
    public static bool Visible(string[] permissions, GetOperationsMenuResponse allowed) => permissions.Length == 0 || allowed.HasAny(permissions);

