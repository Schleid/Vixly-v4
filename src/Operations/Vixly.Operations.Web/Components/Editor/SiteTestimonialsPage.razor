@*
=========================================================
FILE: SiteTestimonialsPage.razor

PURPOSE:
The company's customer testimonials for its website: record one with the customer's agreement, show, hide or remove (owner, 2026-10-30).

RESPONSIBILITIES:
- List every testimonial with its quote, name, place, rating, source and whether the website shows it
- Record a new one: the customer's words as given, and a confirmation that the customer agreed to be quoted

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10)
- Never invented: no agreement, no testimonial; the quote is never edited afterwards (remove and record again)
- Only six show on the website, in this order; those who edit the website change them
- Brief §5 record and table layout with top-aligned controls
=========================================================
*@
@inherits OperationsAllowedComponent
@using Vixly.Operations.Domain.Access
@inject IStringLocalizer<OperationsText> T

<EditorShell Title="@T["ui.testimonials.title"]" Company="@Company" Section="site" Error="@Error" Info="@Info">
    <div class="ops-record-top">
        <a class="ops-editor__back-link" href="/staff/site">← @T["ui.testimonials.back"]</a>
    </div>

    <section class="ops-editor__panel ops-testimonials-list-panel" aria-labelledby="testimonials-list">
        <div class="ops-testimonials-header">
            <h2 id="testimonials-list">@T["ui.testimonials.list"]</h2>
            <p class="ops-editor__hint">@VixlyText.Format(T, "ui.testimonials.hint", "count", OperationsSiteTestimonial.ShownOnSite)</p>
        </div>
        @if (Testimonials.Count == 0)
        {
            <div class="ops-editor__empty"><p>@T["ui.testimonials.none"]</p></div>
        }
        else
        {
            <OperationsTableViewport Label="@T["ui.testimonials.list"]">
                <table class="ops-editor__table ops-testimonials-table">
                    <thead>
                        <tr>
                            <th scope="col" style="min-width: 14rem;">@T["ui.testimonials.quote"]</th>
                            <th scope="col" style="min-width: 10rem;">@T["ui.testimonials.name"]</th>
                            <th scope="col" style="width: 5rem; text-align: center;">@T["ui.testimonials.rating"]</th>
                            <th scope="col" style="width: 5.5rem; text-align: center;">@T["ui.testimonials.shown"]</th>
                            <th scope="col" style="width: 9rem; text-align: right;"><span class="ops-visually-hidden">@T["ui.testimonials.list"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (OperationsSiteTestimonial item in Testimonials)
                        {
                            <tr>
                                <td>@item.Quote</td>
                                <td>
                                    <strong>@item.Name</strong>
                                    @if (item.Place is not null) { <br /><span>@item.Place</span> }
                                    @if (item.Source is not null) { <br /><span class="ops-editor__hint">@item.Source</span> }
                                </td>
                                <td style="text-align: center;">@(item.Rating is { } r ? $"{r} ★" : "—")</td>
                                <td style="text-align: center;">
                                    <span class="ops-editor__status" data-status="@(item.Shown ? "active" : "neutral")">
                                        @T[item.Shown ? "ui.testimonials.yes" : "ui.testimonials.no"]
                                    </span>
                                </td>
                                <td class="ops-table-actions-cell">
                                    @if (Can(OperationsPermissions.BrandEdit))
                                    {
                                        <div class="ops-table-actions">
                                            <form method="post" action="/staff/site/testimonials/@item.Id/@(item.Shown ? "hide" : "show")" class="ops-editor__inline">
                                                <AntiforgeryToken />
                                                <button type="submit" class="vx-button vx-button--secondary">@T[item.Shown ? "ui.testimonials.hide" : "ui.testimonials.show"]</button>
                                            </form>
                                            <form method="post" action="/staff/site/testimonials/@item.Id/remove" class="ops-editor__inline">
                                                <AntiforgeryToken />
                                                <button type="submit" class="vx-button vx-button--subtle">@T["ui.testimonials.remove"]</button>
                                            </form>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </OperationsTableViewport>
        }
    </section>

    @if (Can(OperationsPermissions.BrandEdit))
    {
        <form method="post" action="/staff/site/testimonials" class="ops-editor__panel ops-editor__form ops-testimonial-add-form" aria-labelledby="testimonial-new">
            <AntiforgeryToken />
            <div class="ops-testimonial-add__header span-full">
                <h2 id="testimonial-new">@T["ui.testimonials.new"]</h2>
                <p class="ops-editor__hint">@T["ui.testimonials.new_hint"]</p>
            </div>
            <label class="span-full">@T["ui.testimonials.quote"] <textarea name="quote" maxlength="@OperationsSiteTestimonial.QuoteMaxLength" rows="3" required>@Entered?.Quote</textarea></label>
            <label class="ops-editor__form-span-3">@T["ui.testimonials.name"] <input name="name" value="@Entered?.Name" maxlength="@OperationsSiteTestimonial.NameMaxLength" required autocomplete="off" /></label>
            <label class="ops-editor__form-span-3">@T["ui.testimonials.place"] <input name="place" value="@Entered?.Place" maxlength="@OperationsSiteTestimonial.PlaceMaxLength" autocomplete="off" /></label>
            <label class="ops-editor__form-span-2">@T["ui.testimonials.rating"]
                <select name="rating">
                    <option value="">—</option>
                    @for (int stars = 5; stars >= 1; stars--) { <option value="@stars" selected="@(Entered?.Rating == stars)">@stars ★</option> }
                </select>
            </label>
            <label class="ops-editor__form-span-4">@T["ui.testimonials.source"] <input name="source" value="@Entered?.Source" maxlength="@OperationsSiteTestimonial.SourceMaxLength" placeholder="@T["ui.testimonials.source_hint"]" autocomplete="off" /></label>
            <label class="ops-checkbox-label span-full"><input type="checkbox" name="agreed" value="true" required /> <span>@T["ui.testimonials.agreed"]</span></label>
            <div class="ops-editor__form-actions span-full"><button type="submit" class="vx-button vx-button--primary">@T["ui.testimonials.add"]</button></div>
        </form>
    }
</EditorShell>

@code {
    [Parameter]
    public string? Company { get; set; }

    [Parameter]
    public IReadOnlyList<OperationsSiteTestimonial> Testimonials { get; set; } = Array.Empty<OperationsSiteTestimonial>();

    [Parameter]
    public Vixly.Operations.Application.UseCases.Site.RecordOperationsSiteTestimonial.RecordOperationsSiteTestimonialRequest? Entered { get; set; }

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public string? Info { get; set; }
}
