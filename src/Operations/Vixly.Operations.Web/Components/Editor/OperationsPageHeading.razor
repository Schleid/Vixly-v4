@*
=========================================================
FILE: OperationsPageHeading.razor
PURPOSE: Compact section identity for operational screens.
RESPONSIBILITIES: Render semantic page heading without decorative illustration.
IMPORTANT NOTES: No workflow behavior or synthetic operational data.
=========================================================
*@
<header class="ops-page-heading">
    <h1>@Title</h1>
</header>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Section { get; set; } = string.Empty;

    public static string Scene(string section) => section switch
    {
        "receiving" or "locations" or "inspection_queue" or "bundles" or "dispatches" or "arrivals" or "pickup" or "delivery" or "drive" => "warehouse",
        "parcels" or "shipments" or "events" => "parcel",
        "customers" or "staff" or "account" or "company" => "people",
        "charges" or "quotes" or "billing" or "audit" or "invoices" or "cashier" or "verify" or "credit" => "document",
        "roles" or "holds" or "devices" or "legal" => "security",
        "settings" or "services" or "site" or "inspection_setup" or "invoice_settings" or "payment_settings" or "bundle_settings" or "credit_settings" or "carriers" or "event_settings" or "pickup_settings" or "delivery_settings" => "settings",
        _ => "network"
    };
}
