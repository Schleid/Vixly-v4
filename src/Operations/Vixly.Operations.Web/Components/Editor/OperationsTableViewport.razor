@* =========================================================
FILE: OperationsTableViewport.razor

PURPOSE:
A keyboard-scrollable region for dense Operations tables.

RESPONSIBILITIES:
- Confine overflow while keeping column headings visible

IMPORTANT NOTES:
- Presentation only; selection, paging and actions belong to existing forms
========================================================= *@
<div class="ops-editor__table-scroll" role="region" aria-label="@Label" tabindex="0">
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
