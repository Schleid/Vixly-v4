@*
=========================================================
FILE: SupplyStockPage.razor

PURPOSE:
Supplies stock (Slice 5E step 2): what each warehouse has, low stock, transfers in transit, and the stock actions.

RESPONSIBILITIES:
- Choose the warehouse among those the person keeps the stock of
- Show the stock, the transfers in transit (receive those sent here) and the actions

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10)
- ops.supplies.stock, per warehouse; with stock counting off, only the notice is shown
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<EditorShell Title="@T["ui.supplies.stock.page_title"]" Company="@Company" Section="supplies_stock" Error="@Error" Info="@Info">
    @if (Warehouse is { } warehouse)
    {
    @if (Warehouses.Count > 1)
    {
        <nav class="ops-editor__tabs" aria-label="@T["ui.supplies.stock.warehouses"]">
            @foreach (OperationsWarehouse item in Warehouses) { <a href="/staff/supplies/stock?warehouse=@item.Id" aria-current="@(item.Id == warehouse.Id ? "page" : null)">@item.Code · @item.Name</a> }
        </nav>
    }
    @if (!CountsStock)
    {
        <p class="ops-editor__notice">@T["ui.supplies.stock.off"]</p>
    }
    else
    {
    <section class="ops-editor__panel" aria-labelledby="stock-title">
        <h2 id="stock-title">@VixlyText.Format(T, "ui.supplies.stock.title_at", "warehouse", warehouse.Code + " · " + warehouse.Name)</h2>
        @if (Stock.Count(item => item.IsLow) is > 0 and var low) { <p class="ops-editor__notice" role="status">@VixlyText.Format(T, "ui.supplies.stock.low_count", "count", low)</p> }
        <SupplyStockTable T="T" WarehouseId="warehouse.Id" Supplies="Supplies" Stock="Stock" />
    </section>
    @if (Transfers.Count > 0)
    {
        <section class="ops-editor__panel" aria-labelledby="stock-transit">
            <h2 id="stock-transit">@T["ui.supplies.stock.in_transit"]</h2>
            <ul class="ops-editor__list">
                @foreach (OperationsSupplyTransfer transfer in Transfers)
                {
                    bool incoming = transfer.ToWarehouseId == warehouse.Id;
                    <li>
                        <strong>@Code(transfer.FromWarehouseId) → @Code(transfer.ToWarehouseId)</strong> · @transfer.CreatedUtc.ToString("g", CultureInfo.CurrentCulture)
                        · @string.Join(", ", transfer.Lines.Select(line => line.Quantity + " × " + (Supplies.FirstOrDefault(supply => supply.Id == line.SupplyId)?.Code ?? "?")))
                        @if (transfer.Note is { } note) { <small> · @note</small> }
                        @if (incoming)
                        {
                            <form method="post" action="/staff/supplies/stock/transfers/@transfer.Id/receive" class="ops-editor__inline">
                                <AntiforgeryToken />
                                <button type="submit" class="vx-button vx-button--primary">@T["ui.supplies.stock.transfer_receive"]</button>
                            </form>
                        }
                    </li>
                }
            </ul>
        </section>
    }
    <SupplyStockForms T="T" WarehouseId="warehouse.Id" Supplies="Supplies" AllWarehouses="AllWarehouses" OpenCountId="OpenCount?.Id" />
    }
    }
</EditorShell>

@code {
    [Parameter] public string? Company { get; set; }

    [Parameter] public IReadOnlyList<OperationsWarehouse> Warehouses { get; set; } = Array.Empty<OperationsWarehouse>();

    [Parameter] public OperationsWarehouse? Warehouse { get; set; }

    [Parameter] public IReadOnlyList<OperationsWarehouse> AllWarehouses { get; set; } = Array.Empty<OperationsWarehouse>();

    [Parameter] public IReadOnlyList<OperationsSupply> Supplies { get; set; } = Array.Empty<OperationsSupply>();

    [Parameter] public IReadOnlyList<OperationsSupplyStock> Stock { get; set; } = Array.Empty<OperationsSupplyStock>();

    [Parameter] public IReadOnlyList<OperationsSupplyTransfer> Transfers { get; set; } = Array.Empty<OperationsSupplyTransfer>();

    [Parameter] public OperationsSupplyCount? OpenCount { get; set; }

    [Parameter] public bool CountsStock { get; set; } = true;

    [Parameter] public string? Error { get; set; }

    [Parameter] public string? Info { get; set; }

    private string Code(Guid warehouseId) => AllWarehouses.FirstOrDefault(item => item.Id == warehouseId)?.Code ?? "?";
}
