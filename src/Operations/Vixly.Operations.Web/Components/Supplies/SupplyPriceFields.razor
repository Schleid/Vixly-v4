@*
=========================================================
FILE: SupplyPriceFields.razor

PURPOSE:
The fields of a supply price (Slice 5E, S-2): the unit price, the day it starts, quantity breaks and other prices per warehouse.

RESPONSIBILITIES:
- Show the fields with the values typed

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10)
- Inside the caller's form; prices before tax
=========================================================
*@
<div class="ops-charges-duo">
    <div>
        <label>@VixlyText.Format(T, "ui.supplies.price", "currency", Currency) <input name="price" value="@Form.Price" inputmode="decimal" required autocomplete="off" /></label>
    </div>
    <div>
        <label>@T["ui.charges.effective"] <input name="effective" type="date" value="@Form.Effective" /></label>
        <p class="ops-editor__hint">@T["ui.charges.effective_hint"]</p>
    </div>
</div>

<fieldset class="ops-editor__section">
    <legend>@T["ui.supplies.breaks"]</legend>
    <p class="ops-editor__hint">@T["ui.supplies.breaks_hint"]</p>
    <table class="ops-supply-breaks-table">
        <thead>
            <tr>
                <th style="width: 3rem;">#</th>
                <th>@T["ui.supplies.break_from"]</th>
                <th>@T["ui.supplies.break_price"]</th>
            </tr>
        </thead>
        <tbody>
            @for (int row = 1; row <= OperationsSupplyForm.BreakRows; row++)
            {
                (string? quantity, string? price) = row <= Form.Breaks.Count ? Form.Breaks[row - 1] : (null, null);
                <tr>
                    <td class="text-muted" style="font-size: 0.8125rem; font-weight: 600;">@row</td>
                    <td>
                        <input name="@("break_qty_" + row)" value="@quantity" inputmode="numeric" placeholder="e.g. 10" autocomplete="off" />
                    </td>
                    <td>
                        <input name="@("break_price_" + row)" value="@price" inputmode="decimal" placeholder="0.00" autocomplete="off" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
</fieldset>

@if (Warehouses.Count > 1)
{
    <fieldset class="ops-editor__section">
        <legend>@T["ui.supplies.warehouse_prices"]</legend>
        <p class="ops-editor__hint">@T["ui.supplies.warehouse_prices_hint"]</p>
        <div class="ops-facts-grid ops-facts-grid--compact" style="grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 0.75rem; margin-top: 0.5rem;">
            @foreach (OperationsWarehouse warehouse in Warehouses)
            {
                <label>
                    <span style="font-size: 0.75rem; font-weight: 600; color: var(--vx-color-text-muted);">@warehouse.Code · @warehouse.Name</span>
                    <input name="@("wh_" + warehouse.Id)" value="@(Form.WarehousePrices.TryGetValue(warehouse.Id, out string? typed) ? typed : null)" inputmode="decimal" placeholder="Standard price" autocomplete="off" />
                </label>
            }
        </div>
    </fieldset>
}

@code {
    [Parameter, EditorRequired] public IStringLocalizer<OperationsText> T { get; set; } = null!;

    [Parameter, EditorRequired] public OperationsSupplyForm Form { get; set; } = null!;

    [Parameter] public IReadOnlyList<OperationsWarehouse> Warehouses { get; set; } = Array.Empty<OperationsWarehouse>();

    [Parameter] public string Currency { get; set; } = string.Empty;
}
