@*
=========================================================
FILE: SiteSteps.razor

PURPOSE:
The numbered steps of a home page.

RESPONSIBILITIES:
- Render the steps when the company shows them

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText and the tenant texts; values come from the endpoint
- Tenant surface: never says "Vixly" (ADR-0012 W-1); every value is HTML-encoded by Razor
- The company's own wording, else the defaults
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

@if (Page.Site.Settings.ShowSteps)
{
    <section class="site-section site-section--steps" aria-labelledby="steps-title">
        <h2 id="steps-title">@T["site.steps.title"]</h2>
        <ol class="site-steps">
            @for (int step = 1; step <= OperationsSiteTextKeys.Steps; step++)
            {
                <li><h3>@Page.Text(T, "step." + step + ".title", "site.step." + step + ".title")</h3><p>@Page.Text(T, "step." + step + ".text", "site.step." + step + ".text")</p></li>
            }
        </ol>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public OperationsSitePage Page { get; set; } = null!;
}
