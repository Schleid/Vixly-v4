@*
=========================================================
FILE: SiteTrackForm.razor

PURPOSE:
The tracking box.

RESPONSIBILITIES:
- Render the tracking box

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText and the tenant texts; values come from the endpoint
- Tenant surface: never says "Vixly" (ADR-0012 W-1); every value is HTML-encoded by Razor
- Placeholder look: Frontend/UI designs the final experience
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<form class="site-track" method="get" action="@(Page.Home)/track" role="search" id="track">
    <label for="track-number">@T["site.track.label"]</label>
    <div class="site-track__row">
        <input id="track-number" name="number" value="@Number" maxlength="40" autocomplete="off" required />
        <button type="submit" class="site-button">@T["site.track.submit"]</button>
    </div>
</form>

@code {
    [Parameter, EditorRequired]
    public OperationsSitePage Page { get; set; } = null!;

    [Parameter]
    public string? Number { get; set; }
}
