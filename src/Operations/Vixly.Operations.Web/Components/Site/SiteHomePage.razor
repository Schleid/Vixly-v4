@*
=========================================================
FILE: SiteHomePage.razor

PURPOSE:
The tenant home page in the company's theme: Classic (below), Horizon or Air & Sea (website themes, step 1).

RESPONSIBILITIES:
- Render the tenant home page in the published theme, or the theme the Owner previews

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText and the tenant texts; values come from the endpoint
- Tenant surface: never says "Vixly" (ADR-0012 W-1); every value is HTML-encoded by Razor
- Published tenant content and service visibility remain unchanged
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

@switch (Settings.Theme)
{
    case OperationsSiteTheme.Horizon:
        <SiteHorizonHome Page="@Page" />
        break;
    case OperationsSiteTheme.AirSea:
        <SiteAirSeaHome Page="@Page" />
        break;
    default:
        <SiteShell Page="@Page" Title="@(Page.Company + " | " + Page.Text(T, "headline", "site.default.headline"))" Description="@Page.Text(T, "meta_description", "site.default.meta_description")">
            <section class="site-hero">
                <div class="site-hero__text">
                    <h1>@Page.Text(T, "headline", "site.default.headline")</h1>
                    <p>@Page.Text(T, "intro", "site.default.intro")</p>
                    <div class="site-hero__actions">
                        @if (Page.Site.PortalShown)
                        {
                            <a class="site-button" href="/customer/sign-up">@T["site.hero.create_account"] <span aria-hidden="true">↗</span></a>
                        }
                        else
                        {
                            <a class="site-button" href="@(Page.Home)#track">@T["site.hero.track"]</a>
                        }
                        <a class="site-hero__locations" href="@(Page.Home)/locations">@T["site.nav.locations"] <span aria-hidden="true">→</span></a>
                    </div>
                </div>
                <figure class="site-hero__visual">
                    <img src="@(Page.Image(Settings.HeroImageId) ?? "/images/logistics-network.webp")" alt="" width="960" height="640" fetchpriority="high" decoding="async" />
                </figure>
            </section>
            <div class="site-tracking-band"><SiteTrackForm Page="@Page" /></div>
            @if (Services.Count > 0)
            {
                <section class="site-section" aria-labelledby="services-title">
                    <h2 id="services-title">@T["site.services.title"]</h2>
                    <ul class="site-cards">
                        @foreach (string code in Services)
                        {
                            <li class="site-card site-service"><SiteServiceIcon Code="@(code)" /><h3>@T["site.service." + code + ".title"]</h3><p>@Page.Text(T, "service." + code, "site.service." + code + ".text")</p></li>
                        }
                    </ul>
                </section>
            }
            <SiteSteps Page="@Page" />
            <SiteLocations Page="@Page" />
            <SiteFaq Page="@Page" />
        </SiteShell>
        break;
}

@code {
    private OperationsBrandSettings Settings => Page.Site.Settings;

    private IReadOnlyList<string> Services => OperationsSiteHome.Services(Page);

    [Parameter, EditorRequired]
    public OperationsSitePage Page { get; set; } = null!;
}
