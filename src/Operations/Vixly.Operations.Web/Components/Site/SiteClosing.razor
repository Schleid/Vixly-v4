@*
=========================================================
FILE: SiteClosing.razor

PURPOSE:
The closing call to action of a themed home page.

RESPONSIBILITIES:
- Offer account creation and tracking once more

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText and the tenant texts; values come from the endpoint
- Tenant surface: never says "Vixly" (ADR-0012 W-1); every value is HTML-encoded by Razor
- Website themes, step 1
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<section class="site-closing" aria-labelledby="closing-title">
    @* Landing page marketing (owner, 2026-10-30): the company's own closing words, else the default. *@
    <h2 id="closing-title">@(Page.Site.Text("closing.title") ?? VixlyText.Format(T, "site.cta.title", "company", Page.Company))</h2>
    <p>@(Page.Site.Text("closing.text") ?? T["site.cta.text"].Value)</p>
    <div class="site-hero__actions">
        @if (Page.Site.PortalShown)
        {
            <a class="site-button" href="/customer/sign-up">@T["site.hero.create_account"]</a>
        }
        <a class="site-button site-button--outline" href="@(Page.Home)#track">@T["site.hero.track"]</a>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public OperationsSitePage Page { get; set; } = null!;
}
