@*
=========================================================
FILE: SiteFigures.razor

PURPOSE:
The key figures strip of a themed home page.

RESPONSIBILITIES:
- Show how many services, countries and locations the company has

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText and the tenant texts; values come from the endpoint
- Tenant surface: never says "Vixly" (ADR-0012 W-1); every value is HTML-encoded by Razor
- Real data only, never an invented statistic; hidden when there is nothing to count
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

@if (Items.Count > 0)
{
    <section class="site-figures" aria-label="@T["site.figures.label"]">
        <dl>
            @foreach ((int value, string label) in Items)
            {
                <div><dt>@T[label]</dt><dd>@value</dd></div>
            }
        </dl>
    </section>
}

@code {
    private IReadOnlyList<(int Value, string LabelKey)> Items => OperationsSiteHome.Figures(Page);

    [Parameter, EditorRequired]
    public OperationsSitePage Page { get; set; } = null!;
}
