@*
=========================================================
FILE: ForgotPasswordPage.razor

PURPOSE:
The "forgot your password" form.

RESPONSIBILITIES:
- Render the "forgot your password" form

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10); values come from the endpoint
- Tenant surface: shows the tenant name, never "Vixly" (ADR-0012 W-1)
- Placeholder look: Frontend/UI designs the final experience
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<AuthShell Title="@T["ui.forgot.title"]" Subtitle="@T["ui.forgot.subtitle"]" Company="@Company" ReturnHere="/staff/forgot-password">
    @if (Sent)
    {
        <FormMessage Info="@T["ui.forgot.sent"]" />
        <p><a href="/staff">@T["ui.forgot.back"]</a></p>
    }
    else
    {
        <form method="post" action="/staff/forgot-password" class="vx-form">
            <AntiforgeryToken />
            <div class="vx-field">
                <label for="email" class="vx-label">@T["ui.signin.email"]</label>
                <input id="email" name="email" type="email" class="vx-input" autocomplete="username" required />
            </div>
            <VxButton Variant="VxButtonVariant.Primary" Type="submit">@T["ui.forgot.submit"]</VxButton>
        </form>
        <p><a href="/staff">@T["ui.forgot.back"]</a></p>
    }
</AuthShell>

@code {
    [Parameter]
    public string? Company { get; set; }

    [Parameter]
    public bool Sent { get; set; }
}
