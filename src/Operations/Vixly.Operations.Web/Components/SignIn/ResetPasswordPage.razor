@*
=========================================================
FILE: ResetPasswordPage.razor

PURPOSE:
The form that sets a new password from an emailed link.

RESPONSIBILITIES:
- Render the form that sets a new password from an emailed link

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10); values come from the endpoint
- Tenant surface: shows the tenant name, never "Vixly" (ADR-0012 W-1)
- Placeholder look: Frontend/UI designs the final experience
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<AuthShell Title="@T["ui.reset.title"]" Subtitle="@T["ui.reset.subtitle"]" Company="@Company" ReturnHere="/staff">
    <FormMessage Error="@Error" />
    <form method="post" action="/staff/reset-password" class="vx-form">
        <AntiforgeryToken />
        <input type="hidden" name="token" value="@Token" />
        <div class="vx-field">
            <label for="password" class="vx-label">@T["ui.invitation.password"]</label>
            <input id="password" name="password" type="password" class="vx-input" autocomplete="new-password" required minlength="12" />
            <p class="vx-hint">@T["ui.invitation.password_hint"]</p>
        </div>
        <VxButton Variant="VxButtonVariant.Primary" Type="submit">@T["ui.reset.submit"]</VxButton>
    </form>
    <p><a href="/staff/forgot-password">@T["ui.reset.new_link"]</a></p>
</AuthShell>

@code {
    [Parameter]
    public string? Company { get; set; }

    [Parameter]
    public string Token { get; set; } = string.Empty;

    [Parameter]
    public string? Error { get; set; }
}
