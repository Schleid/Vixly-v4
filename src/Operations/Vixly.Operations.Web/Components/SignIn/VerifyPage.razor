@*
=========================================================
FILE: VerifyPage.razor

PURPOSE:
Sign-in step 2: the authenticator app code.

RESPONSIBILITIES:
- Render sign-in step 2: the authenticator app code

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10); values come from the endpoint
- Tenant surface: shows the tenant name, never "Vixly" (ADR-0012 W-1)
=========================================================
*@
@inject IStringLocalizer<OperationsText> T
@inject IStringLocalizer<OperationsLoginText> L

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex" />
    <title>@T["ui.verify.title"] · @(string.IsNullOrWhiteSpace(Company) ? L["portal"] : Company)</title>
    <link rel="stylesheet" href="/_content/Vixly.Shared.UI/vixly-theme.css" />
    <link rel="stylesheet" href="/_content/Vixly.Shared.UI/vixly-primitives.css" />
    <link rel="stylesheet" href="/css/ops-login.css" />
    <script src="/js/ops-theme.js"></script>
    <script src="/_content/Vixly.Shared.UI/vixly-forms.js" defer></script>
</head>
<body class="ops-login">
    <div class="ops-login__backdrop" aria-hidden="true">
        <div class="ops-login__glow-primary"></div>
        <div class="ops-login__glow-secondary"></div>
        <div class="ops-login__grid-matrix"></div>
    </div>

    <header class="ops-login__topbar">
        <div class="ops-login__topbar-inner">
            <div class="ops-login__topbar-brand">
                <span class="ops-login__topbar-mark" aria-hidden="true">
                    @(string.IsNullOrWhiteSpace(Company) ? "OP" : string.Concat(Company.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => System.Globalization.StringInfo.GetNextTextElement(w))).ToUpperInvariant())
                </span>
                <span class="ops-login__topbar-title">@(string.IsNullOrWhiteSpace(Company) ? L["portal"] : Company)</span>
                <span class="ops-login__topbar-tag">OPERATIONS</span>
            </div>
            <div class="ops-login__telemetry" role="status" aria-label="System status">
                <span class="ops-login__telemetry-dot" aria-hidden="true"></span>
                <span class="ops-login__telemetry-text">SECURITY CHECKPOINT · MFA REQUIRED</span>
            </div>
            <div class="ops-login__topbar-actions">
                <button type="button" class="ops-login__theme-toggle" data-vx-theme-toggle aria-label="Toggle theme" title="Toggle theme">
                    <svg class="ops-login__icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                    <svg class="ops-login__icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                </button>
                <nav class="ops-login__languages" aria-label="@T["ui.language"]">
                    @foreach (string language in new[] { "en", "fr", "es" })
                    {
                        <a href="/culture/@language?returnUrl=@ReturnUrl" hreflang="@language" lang="@language" aria-current="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == language ? "true" : null)">@language.ToUpperInvariant()</a>
                    }
                </nav>
            </div>
        </div>
    </header>

    <main class="ops-login__stage" style="align-items: center; justify-content: center; min-height: calc(100dvh - 56px);">
        <div class="ops-mfa-box">
            <div class="ops-mfa-box__header">
                <div class="ops-mfa-box__icon">
                    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                </div>
                <h1 class="ops-mfa-box__title">@T["ui.verify.title"]</h1>
                <p class="ops-mfa-box__subtitle">@T["ui.verify.code_label"]</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="ops-login__alert" role="alert">
                    <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                    <span>@Error</span>
                </div>
            }

            <form method="post" action="/staff/sign-in/verify" class="ops-mfa-form">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <div class="ops-mfa-form__group">
                    <input id="code" name="code" class="ops-mfa-code-input" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" placeholder="000 000" required autofocus />
                </div>
                <button type="submit" class="ops-login__submit-btn">
                    <span>@T["ui.verify.submit"]</span>
                    <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                </button>
            </form>

            <div class="ops-mfa-box__footer">
                <a href="/staff/sign-in/recovery?returnUrl=@Uri.EscapeDataString(ReturnUrl)" class="ops-mfa-link">
                    <span>@T["ui.verify.use_recovery"]</span>
                    <span aria-hidden="true">→</span>
                </a>
                <a href="/staff" class="ops-mfa-link--back">
                    <span aria-hidden="true">←</span>
                    <span>@T["ui.signin.back"]</span>
                </a>
            </div>
        </div>
    </main>
</body>
</html>

@code {
    [Parameter]
    public string? Company { get; set; }

    [Parameter]
    public string ReturnUrl { get; set; } = "/";

    [Parameter]
    public string? Error { get; set; }
}
