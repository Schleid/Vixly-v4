@*
=========================================================
FILE: SecondFactorResetPage.razor

PURPOSE:
The page a second-factor reset link from support opens.

RESPONSIBILITIES:
- Render the page a second-factor reset link from support opens

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10); values come from the endpoint
- Tenant surface: shows the tenant name, never "Vixly" (ADR-0012 W-1)
- Placeholder look: Frontend/UI designs the final experience
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<AuthShell Title="@T["ui.second_factor_reset.title"]" Subtitle="@T["ui.second_factor_reset.subtitle"]" Company="@Company" ReturnHere="/account/second-factor-reset">
    <FormMessage Error="@Error" />
    <form method="post" action="/account/second-factor-reset" class="vx-form" data-device-link>
        <AntiforgeryToken />
        <input type="hidden" name="token" value="" data-device-token />
        <div class="vx-field">
            <label for="email" class="vx-label">@T["ui.signin.email"]</label>
            <input id="email" name="email" type="email" class="vx-input" autocomplete="username" required />
        </div>
        <div class="vx-field">
            <label for="password" class="vx-label">@T["ui.signin.password"]</label>
            <input id="password" name="password" type="password" class="vx-input" autocomplete="current-password" required />
        </div>
        <p class="vx-hint" data-device-token-missing hidden>@T["ui.devices.link_missing"]</p>
        <VxButton Variant="VxButtonVariant.Primary" Type="submit">@T["ui.second_factor_reset.submit"]</VxButton>
    </form>
    <script src="/js/ops-device-link.js" defer></script>
</AuthShell>

@code {
    [Parameter]
    public string? Company { get; set; }

    [Parameter]
    public string? Error { get; set; }
}
