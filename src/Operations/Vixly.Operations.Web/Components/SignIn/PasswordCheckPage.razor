@*
=========================================================
FILE: PasswordCheckPage.razor

PURPOSE:
The daily check of a badge or PIN sign-in, for a person without an authenticator: the password (Slice 12A, owner H-8).

RESPONSIBILITIES:
- Render the password field of the day's first sign-in on this device

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10); values come from the endpoint
- Tenant surface: shows the tenant name, never "Vixly" (ADR-0012 W-1)
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<AuthShell Title="@T["ui.quick.daily_title"]" Subtitle="@T["ui.quick.daily_password"]" Company="@Company" ReturnHere="/staff">
    <FormMessage Error="@Error" />
    <form method="post" action="/staff/sign-in/password" class="vx-form">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <div class="vx-field">
            <label for="password" class="vx-label">@T["ui.signin.password"]</label>
            <input id="password" name="password" type="password" class="vx-input" autocomplete="current-password" required autofocus />
        </div>
        <VxButton Variant="VxButtonVariant.Primary" Type="submit">@T["ui.verify.submit"]</VxButton>
    </form>
    <p><a href="/staff">@T["ui.signin.back"]</a></p>
</AuthShell>

@code {
    [Parameter]
    public string? Company { get; set; }

    [Parameter]
    public string ReturnUrl { get; set; } = "/staff";

    [Parameter]
    public string? Error { get; set; }
}
