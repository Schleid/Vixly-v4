@*
=========================================================
FILE: InvitationPage.razor

PURPOSE:
The invitation link: choose a password.

RESPONSIBILITIES:
- Render the invitation link: choose a password

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10); values come from the endpoint
- Tenant surface: shows the tenant name, never "Vixly" (ADR-0012 W-1)
- Placeholder look: Frontend/UI designs the final experience
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<AuthShell Title="@T["ui.invitation.title"]" Subtitle="@T["ui.invitation.intro"]" Company="@Company">
    <FormMessage Error="@Error" />
    <form method="post" action="/invitation" class="vx-form">
        <AntiforgeryToken />
        <input type="hidden" name="token" value="@Token" />
        <div class="vx-field">
            <label for="password" class="vx-label">@T["ui.invitation.password"]</label>
            <input id="password" name="password" type="password" class="vx-input" autocomplete="new-password" minlength="12" maxlength="64" required aria-describedby="password-hint" />
            <p id="password-hint" class="vx-hint">@T["ui.invitation.password_hint"]</p>
        </div>
        <VxButton Variant="VxButtonVariant.Primary" Type="submit">@T["ui.invitation.submit"]</VxButton>
    </form>
</AuthShell>

@code {
    [Parameter]
    public string? Company { get; set; }

    [Parameter]
    public string Token { get; set; } = string.Empty;

    [Parameter]
    public string? Error { get; set; }
}
