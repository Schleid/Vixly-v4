@*
=========================================================
FILE: WorkspacePage.razor

PURPOSE:
The signed-in Operations workspace and real setup tasks.

RESPONSIBILITIES:
- Render the operational cockpit, counters of what waits, task shortcuts and setup checklist

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10); values come from the endpoint
- Tenant surface: shows the tenant name, never "Vixly" (ADR-0012 W-1)
- No invented operational metrics or unfinished workflow links
- A quick action shows only when the role allows its page, as in the menu (owner, 2026-10-18)
=========================================================
*@
@inject IStringLocalizer<OperationsText> T
@inject IStringLocalizer<OperationsWorkbenchText> L
@inherits OperationsAllowedComponent

<EditorShell Title="@T["ui.editor.nav.workspace"]" Company="@Company" Section="workspace">
    <section class="ops-workspace-hub" aria-labelledby="hub-company">
        <div class="ops-workspace-hub__header">
            <div>
                <span class="ops-workspace-hub__badge">
                    <span class="ops-workspace-hub__pulse" aria-hidden="true"></span>
                    @(Company ?? L["workspace_intro"]) &middot; OPERATIONAL
                </span>
                <h1 id="hub-company" class="ops-workspace-hub__title">@(Company ?? T["ui.editor.nav.workspace"])</h1>
            </div>
            <div class="ops-workspace-hub__meta">
                <span class="ops-workspace-hub__user">
                    <span class="ops-workspace-hub__avatar" aria-hidden="true">@UserInitials</span>
                    @T["ui.signed_in_as"] <strong>@Name</strong>
                </span>
                <a href="/staff/account" class="vx-button vx-button--secondary vx-button--sm">@T["ui.editor.nav.account"]</a>
            </div>
        </div>
        <div class="ops-workspace-hub__actions" role="toolbar" aria-label="@L["workspace_tasks"]">
            @if (Shows("/staff/counter"))
            {
                <a href="/staff/counter" class="ops-workspace-hub__action ops-workspace-hub__action--primary" accesskey="n" title="Alt+N">
                    <div class="ops-workspace-hub__action-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                    </div>
                    <div class="ops-workspace-hub__action-info">
                        <strong>@T["ui.editor.nav.counter"]</strong>
                        <span class="ops-workspace-hub__action-hint">@T["ui.cashier.next"]</span>
                    </div>
                    <kbd class="ops-workspace-hub__action-kbd" aria-hidden="true">Alt+N</kbd>
                </a>
            }
            @if (Shows("/staff/receiving"))
            {
                <a href="/staff/receiving" class="ops-workspace-hub__action">
                    <div class="ops-workspace-hub__action-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                    </div>
                    <div class="ops-workspace-hub__action-info">
                        <strong>@T["ui.editor.nav.receiving"]</strong>
                        <span class="ops-workspace-hub__action-hint">@T["ui.editor.nav.dock"]</span>
                    </div>
                </a>
            }
            @if (Shows("/staff/dispatches"))
            {
                <a href="/staff/dispatches" class="ops-workspace-hub__action">
                    <div class="ops-workspace-hub__action-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                    </div>
                    <div class="ops-workspace-hub__action-info">
                        <strong>@T["ui.editor.nav.dispatches"]</strong>
                        <span class="ops-workspace-hub__action-hint">@T["ui.editor.nav.bundles"]</span>
                    </div>
                </a>
            }
            @if (Shows("/staff/cashier"))
            {
                <a href="/staff/cashier" class="ops-workspace-hub__action">
                    <div class="ops-workspace-hub__action-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                    </div>
                    <div class="ops-workspace-hub__action-info">
                        <strong>@T["ui.editor.nav.cashier"]</strong>
                        <span class="ops-workspace-hub__action-hint">@T["ui.editor.nav.invoices"]</span>
                    </div>
                </a>
            }
            @if (Shows("/staff/events"))
            {
                <a href="/staff/events" class="ops-workspace-hub__action">
                    <div class="ops-workspace-hub__action-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    </div>
                    <div class="ops-workspace-hub__action-info">
                        <strong>@T["ui.editor.nav.events"]</strong>
                        <span class="ops-workspace-hub__action-hint">@T["ui.events.find"]</span>
                    </div>
                </a>
            }
        </div>
    </section>
    @if (Counters.Count > 0)
    {
        <section class="ops-editor__panel ops-workspace__counters" aria-labelledby="counters-title" data-counters>
            <div class="ops-workspace__counters-header">
                <h2 id="counters-title">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                    @T["ui.dashboard.title"]
                </h2>
                @if (Counters.Any(c => c.Count > 0))
                {
                    <span class="ops-workspace__counters-pill">@Counters.Count(c => c.Count > 0) @T["ui.parcels.state"]</span>
                }
            </div>
            <ul class="ops-workspace__counter-list">
                @foreach (Vixly.Operations.Application.Dashboard.OperationsDashboardCounter counter in Counters)
                {
                    <li class="ops-workspace__counter-item" data-counter="@counter.Key" data-attention="@(counter.Count > 0 ? "true" : "false")">
                        <a href="@counter.Link" class="ops-workspace__counter-card">
                            <span class="ops-workspace__counter-label">@T["ui.dashboard." + counter.Key]</span>
                            <strong class="ops-workspace__counter-num">@counter.Count.ToString("N0", System.Globalization.CultureInfo.CurrentCulture)</strong>
                        </a>
                    </li>
                }
            </ul>
        </section>
    }
    @if (Checklist.Count > 0 && Checklist.Any(item => !item.Done))
    {
        <section class="ops-editor__panel ops-workspace__checklist-panel" aria-labelledby="setup-checklist">
            <div class="ops-workspace__checklist-header">
                <h2 id="setup-checklist">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                    @T["ui.checklist.title"]
                </h2>
                <span class="ops-workspace__checklist-pill">@Checklist.Count(i => i.Done) / @Checklist.Count</span>
            </div>
            <ul class="ops-workspace__checklist">
                @foreach (Vixly.Operations.Application.Settings.OperationsSetupItem item in Checklist)
                {
                    <li data-done="@(item.Done ? "true" : "false")">
                        @if (item.Done)
                        {
                            <span class="ops-workspace__checklist-done"><span class="ops-workspace__checklist-icon" aria-hidden="true">&#x2713;</span> @T["ui.checklist." + item.Code]</span>
                        }
                        else
                        {
                            <a href="@item.Link" class="ops-workspace__checklist-link"><span class="ops-workspace__checklist-icon" aria-hidden="true">&#x25CB;</span> <span>@T["ui.checklist." + item.Code]</span> <span class="ops-workspace__checklist-arrow" aria-hidden="true">&rarr;</span></a>
                        }
                    </li>
                }
            </ul>
        </section>
    }
    @if (LowSupplies.Count > 0)
    {
        <section class="ops-editor__panel ops-workspace__low-supplies" aria-labelledby="low-supplies" data-low-supplies>
            <div class="ops-workspace__low-supplies-header">
                <h2 id="low-supplies">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#F59E0B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                    @T["ui.supplies.stock.low_title"]
                </h2>
                <span class="ops-workspace__low-supplies-badge">@LowSupplies.Count</span>
            </div>
            <ul class="ops-workspace__low-supplies-list">
                @foreach (Vixly.Operations.Application.Supplies.OperationsLowSupply item in LowSupplies)
                {
                    <li class="ops-workspace__low-supplies-item">
                        <div class="ops-workspace__low-supplies-info">
                            <span class="ops-workspace__wh-tag">@item.WarehouseCode</span>
                            <strong>@item.SupplyCode</strong> &middot; @item.SupplyName
                            <span class="ops-workspace__low-supplies-meta">@VixlyText.Format(T, "ui.supplies.stock.low_line", new Dictionary<string, object> { ["count"] = item.OnHand, ["level"] = item.ReorderLevel })</span>
                        </div>
                        <a href="/staff/supplies/stock?warehouse=@item.WarehouseId" class="vx-button vx-button--secondary vx-button--sm">@T["ui.editor.nav.supplies_stock"] &rarr;</a>
                    </li>
                }
            </ul>
        </section>
    }
    <div class="ops-workspace__section-header">
        <h2 class="ops-workspace__section-title">@L["workspace_tasks"]</h2>
    </div>
    <OperationsTaskLinks />
</EditorShell>

@code {
    [Parameter]
    public string? Company { get; set; }

    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<Vixly.Operations.Application.Dashboard.OperationsDashboardCounter> Counters { get; set; } = Array.Empty<Vixly.Operations.Application.Dashboard.OperationsDashboardCounter>();

    [Parameter]
    public IReadOnlyList<Vixly.Operations.Application.Settings.OperationsSetupItem> Checklist { get; set; } = Array.Empty<Vixly.Operations.Application.Settings.OperationsSetupItem>();

    [Parameter]
    public IReadOnlyList<Vixly.Operations.Application.Supplies.OperationsLowSupply> LowSupplies { get; set; } = Array.Empty<Vixly.Operations.Application.Supplies.OperationsLowSupply>();

    private string UserInitials => string.IsNullOrWhiteSpace(Name)
        ? "?"
        : string.Concat(Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(word => System.Globalization.StringInfo.GetNextTextElement(word))).ToUpperInvariant();

    private bool Shows(string url) => OperationsNavigation.Groups
        .SelectMany(group => group.Items)
        .Any(item => item.Url == url && OperationsNavigation.Visible(item.Permissions, Allowance));
}
