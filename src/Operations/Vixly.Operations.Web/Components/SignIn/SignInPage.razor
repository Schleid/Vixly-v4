@*
=========================================================
FILE: SignInPage.razor

PURPOSE:
The tenant landing: the staff sign-in form with the tenant name.

RESPONSIBILITIES:
- Render the tenant landing: the staff sign-in form with the tenant name

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10); values come from the endpoint
- Tenant surface: shows the tenant name, never "Vixly" (ADR-0012 W-1)
- Placeholder look: Frontend/UI designs the final experience
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<AuthShell Title="@T["ui.signin.title"]" Subtitle="@(Setup ? T["ui.signin.setup_subtitle"] : T["ui.signin.subtitle"])" Company="@Company" ReturnHere="@ReturnUrl">
    <figure class="ops-signin-visual" aria-hidden="true">
        <span class="ops-signin-visual__brand">@Company</span>
        <img src="/images/staff-security.webp" alt="" width="960" height="720" decoding="async" />
        <span class="ops-signin-visual__line"></span>
    </figure>
    <div class="ops-signin-form">
    <FormMessage Error="@Error" Info="@Info" />
    <form method="post" action="/staff/sign-in" class="vx-form">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <div class="vx-field">
            <label for="email" class="vx-label">@T["ui.signin.email"]</label>
            <input id="email" name="email" type="email" class="vx-input" autocomplete="username" required value="@Email" />
        </div>
        <div class="vx-field">
            <label for="password" class="vx-label">@T["ui.signin.password"]</label>
            <input id="password" name="password" type="password" class="vx-input" autocomplete="current-password" required />
        </div>
        <VxButton Variant="VxButtonVariant.Primary" Type="submit">@T["ui.signin.submit"]</VxButton>
    </form>
    <p class="vx-auth__aside"><a href="/staff/forgot-password">@T["ui.signin.forgot"]</a></p>
    </div>
</AuthShell>

@code {
    [Parameter]
    public string? Company { get; set; }

    [Parameter]
    public string ReturnUrl { get; set; } = "/";

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public string? Email { get; set; }

    [Parameter]
    public bool Setup { get; set; }

    [Parameter]
    public string? Info { get; set; }
}
