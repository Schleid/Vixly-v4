@* =========================================================
FILE: OperationsLogisticsArtwork.razor

PURPOSE:
Bespoke multi-modal logistics vector artwork for the Operations gateway.

RESPONSIBILITIES:
- Render high-craft SVG linework illustrating air, ocean and cross-dock logistics
- Completely decorative and aria-hidden
========================================================= *@
<figure class="ops-login__artwork" aria-hidden="true">
    <svg viewBox="0 0 460 220" fill="none" xmlns="http://www.w3.org/2000/svg" class="ops-login__artwork-svg">
        <defs>
            <linearGradient id="ops-route-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.9" />
                <stop offset="50%" stop-color="#3b82f6" stop-opacity="0.8" />
                <stop offset="100%" stop-color="#1d4ed8" stop-opacity="0.3" />
            </linearGradient>
            <linearGradient id="ops-glow-grad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.25" />
                <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.0" />
            </linearGradient>
        </defs>
        <!-- Radar / Global Grid Arcs -->
        <circle cx="230" cy="180" r="160" stroke="#334155" stroke-width="1" stroke-dasharray="4 8" opacity="0.3" />
        <circle cx="230" cy="180" r="110" stroke="#334155" stroke-width="1" stroke-dasharray="2 6" opacity="0.4" />
        <circle cx="230" cy="180" r="60" stroke="#3b82f6" stroke-width="1.2" opacity="0.5" />

        <!-- Route Flight Trajectory -->
        <path d="M 40 160 C 120 70, 260 50, 420 120" stroke="url(#ops-route-grad)" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="6 4" />
        <path d="M 40 160 C 120 70, 260 50, 420 120 L 420 200 L 40 200 Z" fill="url(#ops-glow-grad)" opacity="0.6" />

        <!-- Waypoint Nodes -->
        <g class="ops-node" transform="translate(60, 150)">
            <circle cx="0" cy="0" r="6" fill="#0284c7" />
            <circle cx="0" cy="0" r="12" stroke="#38bdf8" stroke-width="1.5" opacity="0.6" />
            <text x="-16" y="22" fill="#94a3b8" font-size="9" font-family="monospace">HUB-A</text>
        </g>
        <g class="ops-node" transform="translate(210, 72)">
            <circle cx="0" cy="0" r="5" fill="#3b82f6" />
            <circle cx="0" cy="0" r="10" stroke="#60a5fa" stroke-width="1" opacity="0.5" />
            <text x="-18" y="-12" fill="#93c5fd" font-size="9" font-family="monospace">AIR-CORRIDOR</text>
        </g>
        <g class="ops-node" transform="translate(380, 115)">
            <circle cx="0" cy="0" r="6" fill="#10b981" />
            <circle cx="0" cy="0" r="13" stroke="#34d399" stroke-width="1.5" opacity="0.7" />
            <text x="-16" y="24" fill="#94a3b8" font-size="9" font-family="monospace">DEST-PORT</text>
        </g>

        <!-- Stylized Cargo Jet Vector on Trajectory -->
        <g transform="translate(270, 75) rotate(16)">
            <path d="M0 -3 L18 -1 L26 -8 L30 -7 L24 0 L36 1 L40 -3 L42 -3 L41 2 L36 3 L22 3 L12 11 L7 10 L12 3 L0 3 Z" fill="#ffffff" />
            <circle cx="28" cy="1" r="2" fill="#38bdf8" />
        </g>

        <!-- Stylized Maritime Container Vessel Silhouette on baseline -->
        <g transform="translate(100, 172)">
            <path d="M0 12 L14 0 L110 0 L124 12 Z" fill="#1e293b" stroke="#475569" stroke-width="1" />
            <!-- Stacked Multi-Modal Containers -->
            <rect x="20" y="-8" width="16" height="8" rx="1" fill="#2563eb" />
            <rect x="38" y="-8" width="16" height="8" rx="1" fill="#0284c7" />
            <rect x="56" y="-8" width="16" height="8" rx="1" fill="#f59e0b" />
            <rect x="74" y="-8" width="16" height="8" rx="1" fill="#3b82f6" />
            <rect x="28" y="-16" width="16" height="8" rx="1" fill="#0284c7" />
            <rect x="46" y="-16" width="16" height="8" rx="1" fill="#2563eb" />
            <rect x="64" y="-16" width="16" height="8" rx="1" fill="#10b981" />
        </g>

        <!-- Barcode Laser Scanner Beam -->
        <g transform="translate(280, 155)">
            <line x1="0" y1="0" x2="80" y2="0" stroke="#ef4444" stroke-width="1.5" opacity="0.85" />
            <line x1="10" y1="-8" x2="10" y2="8" stroke="#cbd5e1" stroke-width="2" />
            <line x1="16" y1="-8" x2="16" y2="8" stroke="#cbd5e1" stroke-width="1" />
            <line x1="22" y1="-8" x2="22" y2="8" stroke="#cbd5e1" stroke-width="3" />
            <line x1="30" y1="-8" x2="30" y2="8" stroke="#cbd5e1" stroke-width="1.5" />
            <line x1="38" y1="-8" x2="38" y2="8" stroke="#cbd5e1" stroke-width="2.5" />
            <line x1="48" y1="-8" x2="48" y2="8" stroke="#cbd5e1" stroke-width="1" />
            <line x1="56" y1="-8" x2="56" y2="8" stroke="#cbd5e1" stroke-width="2" />
            <line x1="66" y1="-8" x2="66" y2="8" stroke="#cbd5e1" stroke-width="3" />
        </g>
    </svg>
</figure>
