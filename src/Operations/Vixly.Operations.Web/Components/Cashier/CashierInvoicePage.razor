@*
=========================================================
FILE: CashierInvoicePage.razor

PURPOSE:
Pay an invoice at the cashier (Slice 5F, F-4, C-3 to C-5): the amount owed, one or more tenders adding up to it, the Zelle terms and details.

RESPONSIBILITIES:
- Show the invoice's summary and what is owed
- The tender rows: method, amount, cash given, reference
- Zelle: the warning, the terms in the customer's language, the acceptance, then the QR, tag, contact, amount and memo

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10)
- Paid in full: the rules refuse more or less than what is owed
- Cash needs the person's open drawer at this warehouse
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<EditorShell Title="@(Invoice?.Number ?? T["ui.cashier.title"].Value)" Company="@Company" Section="cashier" Error="@Error" Info="@Info">
    <p><a href="/staff/cashier?customer=@Invoice?.CustomerId">@T["ui.cashier.back"]</a></p>
    @if (Invoice is { } invoice && Settings is { } settings)
    {
    <section class="ops-editor__panel ops-cashier__summary" aria-labelledby="pay-title">
        <h2 id="pay-title">@invoice.Number · @invoice.Reference · @OperationsBillingRows.Customer(invoice)</h2>
        <InvoiceLines T="T" Invoice="invoice" />
        @if (invoice.PayAtDestination) { <p class="ops-editor__hint">@T["ui.invoice.pdf.pay_at_destination"]</p> }
    </section>
    @if (invoice.Owed > 0m)
    {
    <BillAccountPanel Invoice="invoice" Account="Account" Position="Position" />
    @if (CardOffered)
    {
        @* Slice 5F step 4: a card through the company's Stripe account; recorded only once Stripe says it is paid. *@
        <section class="ops-editor__panel ops-cashier__card" aria-labelledby="card-title">
            <h2 id="card-title">@T["ui.cards.pay_title"]</h2>
            <p class="ops-editor__hint">@T["ui.cards.pay_hint"]</p>
            <div class="ops-editor__inline">
                <form method="post" action="/staff/cashier/invoices/@invoice.Id/card">
                    <AntiforgeryToken />
                    <button type="submit" class="vx-button vx-button--primary">@T["ui.cards.payment_page"]</button>
                </form>
                @foreach (OperationsCardReaderRow reader in CardReaders)
                {
                    <form method="post" action="/staff/cashier/invoices/@invoice.Id/card">
                        <AntiforgeryToken />
                        <input type="hidden" name="reader" value="@reader.ReaderId" />
                        <button type="submit" class="vx-button vx-button--secondary">@VixlyText.Format(T, "ui.cards.on_reader", "reader", reader.Label)</button>
                    </form>
                }
            </div>
        </section>
    }
    <form method="post" action="/staff/cashier/invoices/@invoice.Id/pay" class="ops-editor__panel ops-editor__form ops-cashier__pay" aria-labelledby="tenders-title">
        <AntiforgeryToken />
        <input type="hidden" name="key" value="@Key" />
        <h2 id="tenders-title">@VixlyText.Format(T, "ui.cashier.to_pay_now", "amount", OperationsInvoiceWords.Money(invoice.Owed, invoice.CurrencyCode))</h2>
        <p class="ops-editor__hint">@T["ui.cashier.in_full"]</p>
        @if (Drawer is null && Methods.Contains(OperationsPaymentMethod.Cash))
        {
            <p class="ops-editor__notice">@T["ui.cashier.cash_needs_drawer"] <a href="/staff/cashier/drawers">@T["ui.cashier.open_drawer"]</a></p>
        }
        @for (int row = 1; row <= 3; row++)
        {
            int index = row;
            <div class="ops-cashier__tender" data-row="@index">
                <label>@T["ui.cashier.method"]
                    <select name="method_@index">
                        @foreach (OperationsPaymentMethod method in Methods)
                        {
                            <option value="@method">@OperationsPaymentWords.Method(T, method, Others)</option>
                        }
                    </select>
                </label>
                <label>@T["ui.cashier.amount"] <input name="amount_@index" inputmode="decimal" size="9" value="@(index == 1 ? invoice.Owed.ToString("0.00", CultureInfo.InvariantCulture) : null)" /></label>
                <label>@T["ui.cashier.cash_given"] <input name="given_@index" inputmode="decimal" size="9" /></label>
                <label>@T["ui.cashier.reference"] <input name="reference_@index" maxlength="60" size="14" /></label>
            </div>
        }
        @if (Methods.Contains(OperationsPaymentMethod.Zelle))
        {
            <ZelleTermsPanel T="T" Settings="settings" Invoice="invoice" HasQr="@(settings.ZelleQrKey is not null)" />
        }
        <button type="submit" class="vx-button vx-button--primary">@T["ui.cashier.take"]</button>
    </form>
    }
    else
    {
        <p class="ops-editor__notice">@T["ui.payments.state." + OperationsPaymentWords.State(invoice.PaymentState)]</p>
    }
    @* Slice 5F step 3 (P-2): the customer pays on the customer screen: card on Stripe's page, or Zelle with its terms accepted there. *@
    @if (invoice.Owed > 0m && Screens.Count > 0)
    {
        <Vixly.Operations.Web.Components.Screens.ScreenSendPanel T="T" Screens="Screens" InvoiceId="invoice.Id" Back="invoice" />
    }
    <PaymentsList T="T" Payments="Payments" Refunds="Refunds" Others="Others" />
    }
</EditorShell>

@code {
    [Parameter] public string? Company { get; set; }

    [Parameter] public OperationsInvoice? Invoice { get; set; }

    [Parameter] public OperationsTenantSettings? Settings { get; set; }

    [Parameter] public IReadOnlyList<OperationsPaymentMethod> Methods { get; set; } = Array.Empty<OperationsPaymentMethod>();

    [Parameter] public bool CardOffered { get; set; }

    [Parameter] public IReadOnlyList<OperationsCardReaderRow> CardReaders { get; set; } = Array.Empty<OperationsCardReaderRow>();

    [Parameter] public OperationsCashDrawer? Drawer { get; set; }

    [Parameter] public IReadOnlyList<OperationsPayment> Payments { get; set; } = Array.Empty<OperationsPayment>();

    [Parameter] public IReadOnlyList<OperationsRefund> Refunds { get; set; } = Array.Empty<OperationsRefund>();

    // Slice 5F step 2b: the customer's credit account, when the company allows credit.
    [Parameter] public OperationsCreditAccount? Account { get; set; }

    [Parameter] public OperationsCreditPosition? Position { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public string? Info { get; set; }

    [Parameter] public IReadOnlyList<Vixly.Operations.Application.Screens.OperationsScreenRow> Screens { get; set; } = Array.Empty<Vixly.Operations.Application.Screens.OperationsScreenRow>();

    private IReadOnlyDictionary<OperationsPaymentMethod, string> Others => Settings is null ? new Dictionary<OperationsPaymentMethod, string>() : OperationsPaymentNames.Others(Settings);

    // The form's key: the same payment sent twice is taken once (ADR-0019).
    private readonly string Key = Guid.NewGuid().ToString("N");
}
