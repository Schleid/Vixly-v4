@*
=========================================================
FILE: PaymentSettingsPage.razor

PURPOSE:
Settings → Payments (Slice 5F, C-1 and P-8): the methods the company accepts and its Zelle details.

RESPONSIBILITIES:
- The methods on or off and the names of the company's other methods
- Zelle: the QR picture, tag, email or phone, name and terms in three languages

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10)
- Zelle is offered only with a tag or an email or phone, and its terms in English
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<EditorShell Title="@T["ui.payment_settings.title"]" Company="@Company" Section="payment_settings" Error="@Error" Info="@Info">
    @if (Settings is { } settings)
    {
    <form method="post" action="/staff/settings/payments" enctype="multipart/form-data" class="ops-editor__form" style="margin-bottom: 2.5rem;">
        <AntiforgeryToken />
        <fieldset class="ops-editor__panel ops-setting-card" disabled="@(!CanEdit)">
            <legend>@T["ui.payment_settings.methods"]</legend>
            <div class="ops-checkbox-group" style="margin-bottom: 1rem;">
                <label class="ops-checkbox-label"><input type="checkbox" name="cash" value="true" checked="@settings.AcceptCash" /> <span>@T["ui.payments.method.Cash"]</span></label>
                <label class="ops-checkbox-label"><input type="checkbox" name="zelle" value="true" checked="@settings.AcceptZelle" /> <span>@T["ui.payments.method.Zelle"]</span></label>
                <label class="ops-checkbox-label"><input type="checkbox" name="cheque" value="true" checked="@settings.AcceptCheque" /> <span>@T["ui.payments.method.Cheque"]</span></label>
                <label class="ops-checkbox-label"><input type="checkbox" name="transfer" value="true" checked="@settings.AcceptBankTransfer" /> <span>@T["ui.payments.method.BankTransfer"]</span></label>
            </div>
            <div class="ops-charges-trio">
                <div><label><span class="ops-label-text">@T["ui.payment_settings.other"] 1</span><input name="other1" value="@settings.OtherMethod1" maxlength="30" /></label></div>
                <div><label><span class="ops-label-text">@T["ui.payment_settings.other"] 2</span><input name="other2" value="@settings.OtherMethod2" maxlength="30" /></label></div>
                <div><label><span class="ops-label-text">@T["ui.payment_settings.other"] 3</span><input name="other3" value="@settings.OtherMethod3" maxlength="30" /></label></div>
            </div>
            <p class="ops-editor__hint">@T["ui.payment_settings.other_hint"]</p>
        </fieldset>
        <fieldset class="ops-editor__panel ops-setting-card" disabled="@(!CanEdit)" style="margin-top: 1rem;">
            <legend>@T["ui.payments.method.Zelle"]</legend>
            <div class="ops-charges-duo" style="margin-bottom: 0.75rem;">
                <div>
                    @if (settings.ZelleQrKey is not null)
                    {
                        <div style="margin-bottom: 0.75rem;">
                            <img src="/staff/settings/payments/zelle-qr" alt="@T["ui.cashier.zelle_qr"]" width="140" height="140" style="border: 1px solid var(--vx-color-border); border-radius: 0.35rem; display: block; margin-bottom: 0.4rem;" />
                            <div class="ops-checkbox-group">
                                <label class="ops-checkbox-label"><input type="checkbox" name="removeQr" value="true" /> <span>@T["ui.payment_settings.remove_qr"]</span></label>
                            </div>
                        </div>
                    }
                    <div>
                        <span class="ops-label-text" style="min-height: auto; margin-bottom: 0.35rem;">@T["ui.payment_settings.qr"]</span>
                        <input type="file" name="qr" accept="image/png,image/jpeg" class="ops-file-input" />
                    </div>
                </div>
                <div>
                    <label style="margin-bottom: 0.5rem;"><span class="ops-label-text">@T["ui.cashier.zelle_tag"]</span><input name="zelleTag" value="@settings.ZelleTag" maxlength="120" /></label>
                    <label style="margin-bottom: 0.5rem;"><span class="ops-label-text">@T["ui.cashier.zelle_contact"]</span><input name="zelleContact" value="@settings.ZelleContact" maxlength="120" /></label>
                    <label><span class="ops-label-text">@T["ui.cashier.zelle_name"]</span><input name="zelleName" value="@settings.ZelleName" maxlength="120" /></label>
                </div>
            </div>
            <div class="ops-charges-trio">
                <div><label><span class="ops-label-text">@T["ui.payment_settings.terms_en"]</span><textarea name="termsEn" rows="3" maxlength="2000">@settings.ZelleTermsEn</textarea></label></div>
                <div><label><span class="ops-label-text">@T["ui.payment_settings.terms_fr"]</span><textarea name="termsFr" rows="3" maxlength="2000">@settings.ZelleTermsFr</textarea></label></div>
                <div><label><span class="ops-label-text">@T["ui.payment_settings.terms_es"]</span><textarea name="termsEs" rows="3" maxlength="2000">@settings.ZelleTermsEs</textarea></label></div>
            </div>
            <p class="ops-editor__hint">@T["ui.payment_settings.zelle_hint"]</p>
        </fieldset>
        @if (CanEdit)
        {
            <div style="margin-top: 1.25rem; margin-bottom: 2.5rem; display: flex; justify-content: flex-start;">
                <button type="submit" class="vx-button vx-button--primary">@T["ui.payment_settings.save"]</button>
            </div>
        }
    </form>
    }
    @if (Card is { Succeeded: true } card)
    {
        <CardSettingsPanel Card="card" WebhookUrl="@WebhookUrl" />
    }
</EditorShell>

@code {
    [Parameter] public string? Company { get; set; }

    [Parameter] public OperationsTenantSettings? Settings { get; set; }

    [Parameter] public bool CanEdit { get; set; }

    // Slice 5F step 4: the company's Stripe account and readers.
    [Parameter] public GetOperationsCardSettingsResponse? Card { get; set; }

    [Parameter] public string WebhookUrl { get; set; } = string.Empty;

    [Parameter] public string? Error { get; set; }

    [Parameter] public string? Info { get; set; }
}