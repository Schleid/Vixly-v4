@inject IStringLocalizer<OperationsText> T

<EditorShell Title="@VixlyText.Format(T, "ui.inspection.work.title", "number", Parcel.Number ?? string.Empty)" Company="@Company" Section="inspection_queue" Error="@Error" Info="@Info">
    <div class="customer-portal__actions--top">
        <a href="/staff/inspection/queue" class="customer-portal__back-link">← @T["ui.inspection.queue.back"]</a>
    </div>
    <div class="ops-record-layout" data-editable="@(CanPerform ? "true" : "false")">
        <aside class="ops-record-rail">
            <section class="ops-record-summary" aria-labelledby="work-parcel">
                <h2 id="work-parcel">@Parcel.Number</h2>
                <p class="ops-inspection__customer">@(Parcel.CustomerCode ?? T["ui.hold.Unidentified"].Value)</p>
                <dl>
                    <dt>@T["ui.inspection.queue.why"]</dt><dd>@OperationsInspectionWords.Why(T, Inspection.Why, Inspection.Reason)</dd>
                    <dt>@T["ui.inspection.queue.status"]</dt><dd><span class="ops-ticket-status" data-status="@Inspection.Status">@T["ui.inspection.status." + Inspection.Status]</span></dd>
                    <dt>@T["ui.parcels.tracking"]</dt><dd class="ops-editor__code">@Parcel.CarrierTrackingNumber @Parcel.Carrier</dd>
                    <dt>@T["ui.parcels.contents"]</dt><dd>@(Parcel.DeclaredContents ?? T["ui.parcels.not_declared"].Value)</dd>
                    @if (Parcel.DeclaredValue is { } val) { <dt>@T["ui.inspection.value"]</dt><dd>@val.ToString("0.00") @Parcel.CurrencyCode</dd> }
                </dl>
                <p><a href="/staff/parcels/@Parcel.ParcelId" class="vx-button vx-button--secondary">@T["ui.parcels.open"]</a></p>
            </section>
            <ShipmentInstructionsPanel T="T" Shipment="Shipment" />
            <section class="ops-editor__panel" aria-labelledby="work-list">
                <h2 id="work-list">@T["ui.inspection.work.list"]</h2>
                @if (Applicable.Count == 0) { <p>@T["ui.inspection.work.list_none"]</p> }
                <ul>
                    @foreach (OperationsRestrictedItem it in Applicable) {
                        <li><strong>@it.Name</strong> · @T["ui.inspection.kind." + it.Kind] @(Named.Contains(it.Id) ? "· " + T["ui.inspection.named"].Value : null)
                            @if (it.Requirement is { } need) { <br /><small>@need</small> }</li>
                    }
                </ul>
            </section>
        </aside>
        <div class="ops-record-workflows">
            @if (Inspection.Status == OperationsInspectionStatus.Waiting && CanPerform)
            {
                <form method="post" action="/staff/inspection/queue/@Inspection.Id/start" class="ops-editor__panel ops-editor__form">
                    <AntiforgeryToken /><input type="hidden" name="key" value="@CommandKey" />
                    <p>@T["ui.inspection.work.start_hint"]</p>
                    <div class="ops-editor__form-actions"><button type="submit" class="vx-button vx-button--primary">@T["ui.inspection.work.start"]</button></div>
                </form>
            }
            else if (Inspection.Status == OperationsInspectionStatus.InProgress && CanPerform)
            {
                <InspectionOutcomeForm T="T" InspectionId="Inspection.Id" Applicable="Applicable" Named="Named" CurrencyCode="@CurrencyCode" CommandKey="@CommandKey" />
            }
            else
            {
                <section class="ops-editor__panel" aria-labelledby="work-outcome">
                    <h2 id="work-outcome">@T["ui.inspection.outcome.title"]</h2>
                    @if (Inspection.Status == OperationsInspectionStatus.AwaitingApproval) { <p class="ops-editor__hint">@T["ui.inspection.work.awaiting_approval"]</p> }
                    <dl class="ops-editor__facts">
                        @if (Inspection.Result is { } r) { <dt>@T["ui.inspection.outcome.result"]</dt><dd>@T["ui.inspection.result." + r]</dd> }
                        @if (Inspection.ItemsFound is { } f) { <dt>@T["ui.inspection.outcome.found"]</dt><dd>@f</dd> }
                        @if (Inspection.Notes is { } n) { <dt>@T["ui.inspection.outcome.notes"]</dt><dd>@n</dd> }
                        @if (Inspection.CustomerAction is { } a) { <dt>@T["ui.inspection.outcome.action"]</dt><dd>@a</dd> }
                        @if (Inspection.Fee is { } fee) { <dt>@VixlyText.Format(T, "ui.inspection.outcome.fee", "currency", Inspection.FeeCurrency ?? CurrencyCode)</dt><dd>@fee.ToString("0.00")</dd> }
                        @if (Inspection.CalledCustomerUtc is { } c) { <dt>@T["ui.inspection.outcome.called_on"]</dt><dd>@c.ToString("yyyy-MM-dd") · @Inspection.CallNotes</dd> }
                    </dl>
                </section>
            }
        </div>
    </div>
</EditorShell>

@code {
    [Parameter] public string? Company { get; set; }
    [Parameter] public OperationsInspection Inspection { get; set; } = null!;
    [Parameter] public OperationsParcelSummary Parcel { get; set; } = null!;
    [Parameter] public Vixly.Operations.Application.Shipments.OperationsCustomerShipment? Shipment { get; set; }
    [Parameter] public IReadOnlyList<OperationsRestrictedItem> Applicable { get; set; } = Array.Empty<OperationsRestrictedItem>();
    [Parameter] public IReadOnlyList<Guid> Named { get; set; } = Array.Empty<Guid>();
    [Parameter] public bool CanPerform { get; set; }
    [Parameter] public string CurrencyCode { get; set; } = string.Empty;
    [Parameter] public string CommandKey { get; set; } = string.Empty;
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? Info { get; set; }
}
