@*
=========================================================
FILE: InspectionSetupPage.razor

PURPOSE:
The company's restricted-items list, inspection rules and random share (Slice 3C design section 3).

RESPONSIBILITIES:
- Change the random share
- Add rules and take them in or out of use
- Copy the starting list, add entries and change them

IMPORTANT NOTES:
- Markup only. Text comes from OperationsText (L-10)
- Company-wide (ops.inspection.configure); entries and rules are taken out of use, never deleted
- Structured enterprise table layout with status pills and responsive drawer forms
=========================================================
*@
@inject IStringLocalizer<OperationsText> T

<EditorShell Title="@T["ui.inspection.setup.title"]" Company="@Company" Section="inspection_setup" Error="@Error" Info="@Info">
    <div class="ops-compact-tabs" data-section-tabs="inspection-rules" data-tabs-label="@T["ui.inspection.setup.title"]">
    <p class="ops-editor__hint" style="margin-bottom: 1rem;">@T["ui.inspection.setup.intro"]</p>
    
    <section class="ops-editor__panel" aria-labelledby="share-title">
        <h2 id="share-title" style="margin: 0 0 0.25rem;">@T["ui.inspection.share.title"]</h2>
        <p class="ops-editor__hint">@T["ui.inspection.share.hint"]</p>
        <form method="post" action="/staff/inspection/setup/share" style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.75rem;">
            <AntiforgeryToken />
            <label style="display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.8125rem; font-weight: 600; color: var(--vx-color-text-muted);">
                @T["ui.inspection.share.percent"]
                <input name="percent" type="number" min="0" max="100" step="1" value="@Percent" required style="width: 5rem; height: 32px; min-height: 32px; text-align: center; font-size: 0.8125rem; border: 1px solid var(--vx-color-border-control); border-radius: 0.35rem; background: var(--vx-color-surface);" />
            </label>
            <button type="submit" class="vx-button vx-button--secondary">@T["ui.editor.save"]</button>
        </form>
    </section>

    <section class="ops-editor__panel" aria-labelledby="rules-title">
        <h2 id="rules-title" style="margin: 0 0 0.5rem;">@T["ui.inspection.rules.title"]</h2>
        @if (Rules.Count == 0)
        {
            <p class="ops-editor__empty-message">@T["ui.inspection.rules.none"]</p>
        }
        else
        {
            <OperationsTableViewport Label="@T["ui.inspection.rules.title"]">
                <table class="ops-editor__table">
                    <thead>
                        <tr>
                            <th scope="col">@T["ui.inspection.rules.title"]</th>
                            <th scope="col" style="text-align: right;"><span class="vx-visually-hidden">@T["ui.storage.link"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (OperationsInspectionRule rule in Rules)
                        {
                            <tr>
                                <td>
                                    <strong>@OperationsInspectionWords.Rule(T, rule, CurrencyCode)</strong>
                                </td>
                                <td style="text-align: right; white-space: nowrap;">
                                    <form method="post" action="/staff/inspection/setup/rules" class="ops-editor__inline" style="display: inline-flex; align-items: center; gap: 0.65rem;">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="rule" value="@rule.Id" />
                                        <label class="ops-checkbox-label">
                                            <input type="checkbox" name="active" value="true" checked="@rule.IsActive" />
                                            @T["ui.inspection.in_use"]
                                        </label>
                                        <button type="submit" class="vx-button vx-button--secondary">@T["ui.storage.change"]</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </OperationsTableViewport>
        }

        <form method="post" action="/staff/inspection/setup/rules" style="display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap; margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid var(--vx-color-border);">
            <AntiforgeryToken />
            <input type="hidden" name="active" value="true" />
            <label style="display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.8125rem; font-weight: 600; color: var(--vx-color-text-muted);">
                @T["ui.inspection.rules.kind"]
                <select name="kind" style="height: 32px; min-height: 32px; font-size: 0.8125rem; border: 1px solid var(--vx-color-border-control); border-radius: 0.35rem; background: var(--vx-color-surface);">
                    @foreach (OperationsInspectionRuleKind kind in Enum.GetValues<OperationsInspectionRuleKind>())
                    {
                        <option value="@kind">@T["ui.inspection.rules.kind." + kind]</option>
                    }
                </select>
            </label>
            <label style="display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.8125rem; font-weight: 600; color: var(--vx-color-text-muted);">
                @T["ui.inspection.rules.value"]
                <input name="value" maxlength="@OperationsInspectionLimits.RuleValueMaxLength" style="height: 32px; min-height: 32px; font-size: 0.8125rem; border: 1px solid var(--vx-color-border-control); border-radius: 0.35rem; background: var(--vx-color-surface); padding: 0.25rem 0.5rem;" />
            </label>
            <button type="submit" class="vx-button vx-button--primary">@T["ui.inspection.rules.add"]</button>
        </form>
        <p class="ops-editor__hint" style="margin-top: 0.5rem;">@T["ui.inspection.rules.hint"]</p>
    </section>

    <section class="ops-editor__panel" aria-labelledby="items-title">
        <h2 id="items-title" style="margin: 0 0 0.5rem;">@T["ui.inspection.items.title"]</h2>
        @if (Items.Count == 0)
        {
            <div class="ops-editor__empty" style="margin-bottom: 1rem;">
                <p>@T["ui.inspection.items.none"]</p>
                <form method="post" action="/staff/inspection/setup/starting-list">
                    <AntiforgeryToken />
                    <button type="submit" class="vx-button vx-button--primary">@T["ui.inspection.items.copy"]</button>
                </form>
                <p class="ops-editor__hint">@T["ui.inspection.items.copy_hint"]</p>
            </div>
        }
        @foreach (OperationsRestrictedItem item in Items)
        {
            <details class="ops-task-panel" style="margin-bottom: 0.65rem;">
                <summary style="display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap;">
                    <strong>@item.Name</strong>
                    <span class="ops-editor__status" data-status="@(item.Kind == OperationsRestrictedItemKind.Prohibited ? "suspended" : "pending")">@T["ui.inspection.kind." + item.Kind]</span>
                    <span class="ops-badge">@(item.Countries ?? T["ui.inspection.everywhere"].Value)</span>
                    <span class="ops-editor__status" data-status="@(item.IsActive ? "active" : "ending")">@T[item.IsActive ? "ui.inspection.in_use" : "ui.inspection.not_in_use"]</span>
                    <span aria-hidden="true" style="margin-left: auto;">+</span>
                </summary>
                <form method="post" action="/staff/inspection/setup/items" class="ops-editor__form" style="padding: 1rem;">
                    <AntiforgeryToken />
                    <input type="hidden" name="item" value="@item.Id" />
                    <RestrictedItemFields T="T" Item="item" />
                    <label class="ops-checkbox-label" style="grid-column: 1 / -1;"><input type="checkbox" name="active" value="true" checked="@item.IsActive" /> @T["ui.inspection.in_use"]</label>
                    <div class="ops-editor__form-actions" style="margin-top: 0.5rem;"><button type="submit" class="vx-button vx-button--primary">@T["ui.editor.save"]</button></div>
                </form>
            </details>
        }
        <details class="ops-task-panel" style="margin-top: 1rem;">
            <summary style="font-weight: 600;">@T["ui.inspection.items.add"]<span aria-hidden="true" style="margin-left: auto;">+</span></summary>
            <form method="post" action="/staff/inspection/setup/items" class="ops-editor__form" style="padding: 1rem;">
                <AntiforgeryToken />
                <input type="hidden" name="active" value="true" />
                <RestrictedItemFields T="T" />
                <div class="ops-editor__form-actions" style="margin-top: 0.5rem;"><button type="submit" class="vx-button vx-button--primary">@T["ui.inspection.items.add"]</button></div>
            </form>
        </details>
    </section>
    </div>
</EditorShell>

@code {
    [Parameter] public string? Company { get; set; }

    [Parameter] public IReadOnlyList<OperationsRestrictedItem> Items { get; set; } = Array.Empty<OperationsRestrictedItem>();

    [Parameter] public IReadOnlyList<OperationsInspectionRule> Rules { get; set; } = Array.Empty<OperationsInspectionRule>();

    [Parameter] public int Percent { get; set; }

    [Parameter] public string CurrencyCode { get; set; } = string.Empty;

    [Parameter] public string? Error { get; set; }

    [Parameter] public string? Info { get; set; }
}
