@*
=========================================================
FILE: App.razor

PURPOSE:
The console document: Blazor with interactive server rendering after sign-in.
Hands the request's client IP, browser and correlation id to the circuit
(PlatformInteractiveRequest), because interactive calls have no HttpContext.

IMPORTANT NOTES:
- Markup only. Text comes from PlatformText (L-10); values
  come from the endpoint or presenter (ADR-0001)
- Placeholder look: the Frontend/UI team designs the final
  experience (Frontend Guide)
=========================================================
*@
@inject IStringLocalizer<PlatformText> T

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <title>@T["ui.app.name"]</title>
    <script src="@Assets["js/control-theme.js"]"></script>
    <link rel="stylesheet" href="@Assets["_content/Vixly.Shared.UI/vixly-theme.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Vixly.Shared.UI/vixly-primitives.css"]" />
    <link rel="stylesheet" href="@Assets["css/vixly.css"]" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" ClientIp="@HttpContext?.Connection.RemoteIpAddress?.ToString()" UserAgent="@HttpContext?.Request.Headers.UserAgent.ToString()" CorrelationId="@HttpContext?.TraceIdentifier" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/keepalive.js"]"></script>
    <script src="@Assets["js/passkeys.js"]"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }
}
