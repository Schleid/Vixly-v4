@*
=========================================================
FILE: RedirectToSignIn.razor

PURPOSE:
Sends an unauthenticated visitor to the sign-in page.

IMPORTANT NOTES:
- Markup only. Text comes from PlatformText (L-10); values
  come from the endpoint or presenter (ADR-0001)
- Placeholder look: the Frontend/UI team designs the final
  experience (Frontend Guide)
=========================================================
*@
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        string returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo("/sign-in?returnUrl=" + Uri.EscapeDataString(returnUrl), forceLoad: true);
    }
}
