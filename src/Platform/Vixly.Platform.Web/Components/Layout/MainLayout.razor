@*
=========================================================
FILE: MainLayout.razor

PURPOSE:
The signed-in console frame: brand, navigation, user, sign-out.

IMPORTANT NOTES:
- Markup only. Text comes from PlatformText (L-10); values
  come from the endpoint or presenter (ADR-0001)
- Polished by Frontend/UI per ADR-0013 and Frontend Guide
=========================================================
*@
@inherits LayoutComponentBase
@inject IStringLocalizer<PlatformText> T

<div class="vx-shell">
    <header class="vx-shell__header">
        <a href="/" class="vx-shell__brand" aria-label="@T["ui.app.name"]">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
            </svg>
            <span>@T["ui.app.name"]</span>
        </a>
        <AuthorizeView>
            <Authorized>
                <nav class="vx-shell__nav" aria-label="@T["ui.nav.label"]">
                    <NavLink href="/" Match="NavLinkMatch.All">@T["ui.home.title"]</NavLink>
                    <NavLink href="/users">@T["ui.users.title"]</NavLink>
                    <NavLink href="/roles">@T["ui.roles.title"]</NavLink>
                    <NavLink href="/departments">@T["ui.departments.title"]</NavLink>
                    <NavLink href="/audit">@T["ui.audit.title"]</NavLink>
                    <NavLink href="/account">@T["ui.account.title"]</NavLink>
                </nav>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView>
            <Authorized>
                <div class="vx-shell__user">
                    <span>@VixlyText.Format(T, "ui.home.welcome", "name", context.User.Identity?.Name ?? string.Empty)</span>
                    <form method="post" action="/sign-out" data-enhance="false">
                        <AntiforgeryToken />
                        <button type="submit" class="vx-button">@T["ui.signout"]</button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </header>
    <main class="vx-shell__main" id="vx-main-content">
        @Body
    </main>
</div>
