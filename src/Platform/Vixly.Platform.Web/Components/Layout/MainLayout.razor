@*
=========================================================
FILE: MainLayout.razor

PURPOSE:
The signed-in Control workspace shell.

RESPONSIBILITIES:
Present localized navigation, tenant search and account controls.

IMPORTANT NOTES:
Tenant search navigates to the existing authorized directory.
No connection or network health values are simulated.
=========================================================
*@
@inherits LayoutComponentBase
@inject IStringLocalizer<PlatformText> T
@inject NavigationManager Navigation

<a class="vx-skip-link" href="@($"{new Uri(Navigation.Uri).PathAndQuery}#vx-main-content")">@T["ui.control.skip"]</a>
<div class="vx-shell">
    <!-- Left Executive Sidebar Navigation -->
    <aside class="vx-sidebar" aria-label="@T["ui.nav.label"]">
        <!-- Brand Header -->
        <div class="vx-sidebar__brand">
            <a href="/" class="vx-sidebar__brand-link" aria-label="@T["ui.app.name"]">
                <div class="vx-sidebar__brand-icon">
                    <img src="/img/vixly-icon.png" alt="Vixly" class="vx-sidebar__logo-img" width="30" height="30" />
                </div>
                <div class="vx-sidebar__brand-titles">
                    <span class="vx-sidebar__brand-name">VIXLY</span>
                    <span class="vx-sidebar__brand-badge">CONTROL</span>
                </div>
            </a>
        </div>

        <!-- Grouped Navigation -->
        <nav class="vx-sidebar__nav">
            <!-- CORE OVERVIEW -->
            <details class="vx-nav-group" open>
                <summary class="vx-nav-group__title">@T["ui.control.overview"]</summary>
                <NavLink href="/" Match="NavLinkMatch.All" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                    <span class="vx-nav-item__label">@T["ui.home.title"]</span>
                </NavLink>
            </details>

            <!-- TENANTS & ORGANIZATIONS -->
            <details class="vx-nav-group" open>
                <summary class="vx-nav-group__title">@T["ui.control.organizations"]</summary>
                <NavLink href="/tenants" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M3 7v14M21 7v14M6 11h2M6 15h2M16 11h2M16 15h2M9 21v-5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v5M9 7l3-4 3 4M9 7h6"></path></svg>
                    <span class="vx-nav-item__label">@T["ui.tenants.title"]</span>
                </NavLink>
                <NavLink href="/tenants/registrations" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><polyline points="16 11 18 13 22 9"></polyline></svg>
                    <span class="vx-nav-item__label">@T["ui.registrations.title"]</span>
                </NavLink>
            </details>

            <!-- COMMERCIAL & BILLING -->
            <details class="vx-nav-group" open>
                <summary class="vx-nav-group__title">@T["ui.control.commercial"]</summary>
                <NavLink href="/subscriptions" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
                    <span class="vx-nav-item__label">@T["ui.subscriptions.title"]</span>
                </NavLink>
                <NavLink href="/plans" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                    <span class="vx-nav-item__label">@T["ui.plans.title"]</span>
                </NavLink>
                <NavLink href="/offers" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                    <span class="vx-nav-item__label">@T["ui.offers.title"]</span>
                </NavLink>
                <NavLink href="/promotions" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg>
                    <span class="vx-nav-item__label">@T["ui.promotions.title"]</span>
                </NavLink>
                <NavLink href="/approvals" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
                    <span class="vx-nav-item__label">@T["ui.approvals.title"]</span>
                </NavLink>
                <NavLink href="/invoices" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="8" y1="13" x2="16" y2="13"></line><line x1="8" y1="17" x2="13" y2="17"></line></svg>
                    <span class="vx-nav-item__label">@T["ui.invoices.title"]</span>
                </NavLink>
                <NavLink href="/payments/transactions" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line><line x1="5" y1="15" x2="9" y2="15"></line></svg>
                    <span class="vx-nav-item__label">@T["ui.card_payments.list_title"]</span>
                </NavLink>
                <NavLink href="/payments/zelle" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect><line x1="14" y1="14" x2="21" y2="21"></line></svg>
                    <span class="vx-nav-item__label">@T["ui.zelle.title"]</span>
                </NavLink>
                <NavLink href="/collections" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    <span class="vx-nav-item__label">@T["ui.collections.title"]</span>
                </NavLink>
                <NavLink href="/devices" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                    <span class="vx-nav-item__label">@T["ui.devices.title"]</span>
                </NavLink>
            </details>

            <!-- SECURITY & ACCESS -->
            <details class="vx-nav-group" open>
                <summary class="vx-nav-group__title">@T["ui.control.security"]</summary>
                <NavLink href="/users" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    <span class="vx-nav-item__label">@T["ui.users.title"]</span>
                </NavLink>
                <NavLink href="/roles" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    <span class="vx-nav-item__label">@T["ui.roles.title"]</span>
                </NavLink>
                <NavLink href="/departments" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                    <span class="vx-nav-item__label">@T["ui.departments.title"]</span>
                </NavLink>
                <NavLink href="/audit" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                    <span class="vx-nav-item__label">@T["ui.audit.title"]</span>
                </NavLink>
            </details>

            <!-- SYSTEM SETTINGS -->
            <details class="vx-nav-group" open>
                <summary class="vx-nav-group__title">@T["ui.control.system"]</summary>
                <NavLink href="/account" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    <span class="vx-nav-item__label">@T["ui.account.title"]</span>
                </NavLink>
                <NavLink href="/sales/settings" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                    <span class="vx-nav-item__label">@T["ui.sales_settings.title"]</span>
                </NavLink>
                <NavLink href="/billing/settings" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"></rect><line x1="6" y1="9" x2="18" y2="9"></line><line x1="6" y1="13" x2="12" y2="13"></line><line x1="6" y1="17" x2="10" y2="17"></line></svg>
                    <span class="vx-nav-item__label">@T["ui.billing_settings.title"]</span>
                </NavLink>
                <NavLink href="/payments/settings" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2"></rect><circle cx="17" cy="14" r="2"></circle><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                    <span class="vx-nav-item__label">@T["ui.payments_settings.title"]</span>
                </NavLink>
                <NavLink href="/collections/settings" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline><line x1="19" y1="19" x2="22" y2="22"></line></svg>
                    <span class="vx-nav-item__label">@T["ui.collections_settings.title"]</span>
                </NavLink>
                <NavLink href="/legal" class="vx-nav-item">
                    <svg class="vx-nav-item__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="8" y1="13" x2="16" y2="13"></line><line x1="8" y1="17" x2="13" y2="17"></line></svg>
                    <span class="vx-nav-item__label">@T["ui.legal.title"]</span>
                </NavLink>
            </details>
        </nav>

        <!-- User Profile & Sign-Out Footer -->
        <AuthorizeView>
            <Authorized>
                <div class="vx-sidebar__footer">
                    <div class="vx-user-card">
                        <div class="vx-user-card__avatar">@(context.User.Identity?.Name?.Length > 0 ? context.User.Identity.Name.Substring(0, 1).ToUpperInvariant() : "U")</div>
                        <div class="vx-user-card__meta">
                            <span class="vx-user-card__name">@(context.User.Identity?.Name ?? "Admin")</span>
                            <span class="vx-user-card__role">@T["ui.control.workspace"]</span>
                        </div>
                        <form method="post" action="/sign-out" data-enhance="false" class="vx-user-card__signout">
                            <AntiforgeryToken />
                            <button type="submit" class="vx-user-card__signout-btn" title="@T["ui.signout"]" aria-label="@T["ui.signout"]">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                            </button>
                        </form>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
    </aside>

    <!-- Main Workspace Area -->
    <div class="vx-shell__body">
        <!-- Top Executive Command Bar -->
        <header class="vx-topbar">
            <form class="vx-topbar__search" method="get" action="/tenants" role="search" data-enhance="false">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <input type="search" name="search" id="vx-tenant-search" maxlength="100" placeholder="@T["ui.tenants.search"]" class="vx-topbar__search-input" aria-label="@T["ui.tenants.search"]" />
                <kbd class="vx-topbar__kbd" aria-hidden="true">Ctrl / ⌘ K</kbd>
            </form>

            <div class="vx-topbar__actions">
                <button type="button" class="vx-topbar__theme-btn" id="vx-theme-toggle" title="@T["ui.control.theme"]" aria-label="@T["ui.control.theme"]" data-vx-theme-toggle aria-pressed="false">
                    <svg class="vx-theme-icon vx-theme-icon--dark" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                    <svg class="vx-theme-icon vx-theme-icon--light" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                </button>
                <div class="vx-topbar__divider" aria-hidden="true"></div>
                <nav class="vx-topbar__lang" aria-label="@T["ui.language"]">
                    <a href="/culture/en?returnUrl=/" class="@(CurrentLang == "en" ? "active" : null)">EN</a>
                    <a href="/culture/fr?returnUrl=/" class="@(CurrentLang == "fr" ? "active" : null)">FR</a>
                    <a href="/culture/es?returnUrl=/" class="@(CurrentLang == "es" ? "active" : null)">ES</a>
                </nav>
            </div>
        </header>

        <!-- Main Body Canvas -->
        <main class="vx-shell__main" id="vx-main-content" tabindex="-1">
            @Body
        </main>
    </div>
</div>

@code {
    private string CurrentLang => System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
