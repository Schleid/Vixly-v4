@*
=========================================================
FILE: MainLayout.razor

PURPOSE:
The signed-in console frame: Direction A sidebar navigation,
brand, user profile, top bar, and main content area.

IMPORTANT NOTES:
- Markup only. Text comes from PlatformText (L-10); values
  come from the endpoint or presenter (ADR-0001)
- Direction A: Precision Workstation sidebar menu
- Top bar left as is per owner instruction
=========================================================
*@
@inherits LayoutComponentBase
@inject IStringLocalizer<PlatformText> T

<div class="vx-shell">
    <AuthorizeView>
        <Authorized>
            <aside class="vx-sidebar" aria-label="@T["ui.nav.label"]">
                <div class="vx-sidebar__brand">
                    <a href="/" class="vx-sidebar__brand-link" aria-label="@T["ui.app.name"]">
                        <svg class="vx-sidebar__brand-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
                        </svg>
                        <span class="vx-sidebar__brand-name">@T["ui.app.name"]</span>
                    </a>
                    <span class="vx-sidebar__env-badge">v4</span>
                </div>

                <div class="vx-sidebar__section">
                    <span class="vx-sidebar__section-title">@T["ui.nav.label"]</span>
                    <nav class="vx-sidebar__nav">
                        <NavLink href="/" Match="NavLinkMatch.All" class="vx-sidebar__link">
                            <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
                                <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h3a1 1 0 001-1v-3a1 1 0 011-1h2a1 1 0 011 1v3a1 1 0 001 1h3a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
                            </svg>
                            <span>@T["ui.home.title"]</span>
                        </NavLink>
                        <NavLink href="/users" class="vx-sidebar__link">
                            <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
                                <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z" />
                            </svg>
                            <span>@T["ui.users.title"]</span>
                        </NavLink>
                        <NavLink href="/roles" class="vx-sidebar__link">
                            <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            <span>@T["ui.roles.title"]</span>
                        </NavLink>
                        <NavLink href="/departments" class="vx-sidebar__link">
                            <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd" />
                            </svg>
                            <span>@T["ui.departments.title"]</span>
                        </NavLink>
                        <NavLink href="/account" class="vx-sidebar__link">
                            <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
                            </svg>
                            <span>@T["ui.account.title"]</span>
                        </NavLink>
                    </nav>
                </div>

                <div class="vx-sidebar__footer">
                    <div class="vx-sidebar__user">
                        <div class="vx-avatar" aria-hidden="true">
                            @GetInitials(context.User.Identity?.Name)
                        </div>
                        <div class="vx-sidebar__user-details">
                            <span class="vx-sidebar__user-name">@context.User.Identity?.Name</span>
                        </div>
                    </div>
                    <form method="post" action="/sign-out" data-enhance="false" class="vx-sidebar__signout-form">
                        <AntiforgeryToken />
                        <button type="submit" class="vx-sidebar__signout-btn" title="@T["ui.signout"]">
                            <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L14.586 9H7a1 1 0 100 2h7.586l-1.293 1.293z" clip-rule="evenodd" />
                            </svg>
                            <span>@T["ui.signout"]</span>
                        </button>
                    </form>
                </div>
            </aside>
        </Authorized>
    </AuthorizeView>

    <div class="vx-shell__content">
        <header class="vx-shell__header">
            <div class="vx-shell__brand-area">
                <a href="/" class="vx-shell__brand" aria-label="@T["ui.app.name"]">
                    <svg class="vx-shell__brand-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
                    </svg>
                    <span>@T["ui.app.name"]</span>
                </a>
                <span class="vx-shell__env-badge">v4</span>
            </div>

            <AuthorizeView>
                <Authorized>
                    <nav class="vx-shell__nav" aria-label="@T["ui.nav.label"]">
                        <NavLink href="/" Match="NavLinkMatch.All">
                            <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                                <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h3a1 1 0 001-1v-3a1 1 0 011-1h2a1 1 0 011 1v3a1 1 0 001 1h3a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
                            </svg>
                            <span>@T["ui.home.title"]</span>
                        </NavLink>
                        <NavLink href="/users">
                            <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                                <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z" />
                            </svg>
                            <span>@T["ui.users.title"]</span>
                        </NavLink>
                        <NavLink href="/roles">
                            <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            <span>@T["ui.roles.title"]</span>
                        </NavLink>
                        <NavLink href="/departments">
                            <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd" />
                            </svg>
                            <span>@T["ui.departments.title"]</span>
                        </NavLink>
                        <NavLink href="/account">
                            <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
                            </svg>
                            <span>@T["ui.account.title"]</span>
                        </NavLink>
                    </nav>

                    <div class="vx-shell__user-profile">
                        <div class="vx-avatar" aria-hidden="true">
                            @GetInitials(context.User.Identity?.Name)
                        </div>
                        <span class="vx-shell__user-name">@context.User.Identity?.Name</span>
                        <form method="post" action="/sign-out" data-enhance="false">
                            <AntiforgeryToken />
                            <button type="submit" class="vx-button vx-button--subtle vx-button--signout" title="@T["ui.signout"]">
                                <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L14.586 9H7a1 1 0 100 2h7.586l-1.293 1.293z" clip-rule="evenodd" />
                                </svg>
                                <span>@T["ui.signout"]</span>
                            </button>
                        </form>
                    </div>
                </Authorized>
            </AuthorizeView>
        </header>

        <main class="vx-shell__main" id="vx-main-content">
            @Body
        </main>
    </div>
</div>

@code {
    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "VX";
        }

        string[] parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
        {
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        }

        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }
}
