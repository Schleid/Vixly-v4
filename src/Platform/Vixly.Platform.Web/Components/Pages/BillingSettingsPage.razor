@*
=========================================================
FILE: BillingSettingsPage.razor

PURPOSE:
Billing settings and the company profile printed on documents.

IMPORTANT NOTES:
- Page (UI-6): route and composition only
- Text comes from PlatformText (UI-10)
=========================================================
*@
@page "/billing/settings"
@attribute [Authorize]
@inject IStringLocalizer<PlatformText> T

<PageTitle>@T["ui.billing_settings.title"]</PageTitle>
<div class="vx-summary-strip">
    <div class="vx-summary-strip__main">
        <h1 class="vx-summary-strip__title">@T["ui.billing_settings.title"]</h1>
    </div>
    <div class="vx-summary-strip__actions">
        <a href="/invoices" class="vx-button vx-button--secondary">@T["ui.invoices.title"]</a>
        <a href="/billing/tax-rates" class="vx-button vx-button--secondary">@T["ui.tax_rates.title"]</a>
        <a href="/payments/settings" class="vx-button vx-button--secondary">@T["ui.payments_settings.title"]</a>
    </div>
</div>
<BillingSettingsForm />
