@*
=========================================================
FILE: UsersPage.razor

PURPOSE:
The staff user list.

IMPORTANT NOTES:
- Page (UI-6): route and composition only
- Text comes from PlatformText (UI-10)
=========================================================
*@
@page "/users"
@attribute [Authorize]
@inject IStringLocalizer<PlatformText> T

<PageTitle>@T["ui.users.title"]</PageTitle>

<h1>@T["ui.users.title"]</h1>
<UserList Search="@Search" Status="@Status" Page="@Page" />

@code {
    [SupplyParameterFromQuery]
    public string? Search { get; set; }

    [SupplyParameterFromQuery]
    public string? Status { get; set; }

    [SupplyParameterFromQuery]
    public int? Page { get; set; }
}
