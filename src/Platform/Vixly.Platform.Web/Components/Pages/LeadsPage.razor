@*
=========================================================
FILE: LeadsPage.razor

PURPOSE:
Contact requests from the public site.

IMPORTANT NOTES:
- Page (UI-6): route and composition only
- Text comes from PlatformText (UI-10)
=========================================================
*@
@page "/leads"
@attribute [Authorize]
@inject IStringLocalizer<PlatformText> T

<PageTitle>@T["ui.leads.title"]</PageTitle>
<h1>@T["ui.leads.title"]</h1>
<LeadsOverview Status="@Status" Search="@Search" Page="@Page" />

@code {
    [SupplyParameterFromQuery]
    public string? Status { get; set; }

    [SupplyParameterFromQuery]
    public string? Search { get; set; }

    [SupplyParameterFromQuery]
    public int? Page { get; set; }
}
