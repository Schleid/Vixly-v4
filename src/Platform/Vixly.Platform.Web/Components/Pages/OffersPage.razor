@*
=========================================================
FILE: OffersPage.razor

PURPOSE:
The offer links for valued customers, filtered by status (D-S21).

IMPORTANT NOTES:
- Page (UI-6): route and composition only
- Text comes from PlatformText (UI-10)
=========================================================
*@
@page "/offers"
@attribute [Authorize]
@inject IStringLocalizer<PlatformText> T

<PageTitle>@T["ui.offers.title"]</PageTitle>
<h1>@T["ui.offers.title"]</h1>
<OfferList Search="@Search" Status="@Status" Page="@Page" />

@code {
    [SupplyParameterFromQuery]
    public string? Search { get; set; }

    [SupplyParameterFromQuery]
    public string? Status { get; set; }

    [SupplyParameterFromQuery]
    public int? Page { get; set; }
}
