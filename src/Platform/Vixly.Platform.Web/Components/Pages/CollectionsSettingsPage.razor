@*
=========================================================
FILE: CollectionsSettingsPage.razor

PURPOSE:
Collections settings: timeline, block levels, extensions.

IMPORTANT NOTES:
- Page (UI-6): route and composition only
- Text comes from PlatformText (UI-10)
=========================================================
*@
@page "/collections/settings"
@attribute [Authorize]
@inject IStringLocalizer<PlatformText> T

<PageTitle>@T["ui.collections_settings.title"]</PageTitle>
<div class="vx-summary-strip">
    <div class="vx-summary-strip__main">
        <h1 class="vx-summary-strip__title">@T["ui.collections_settings.title"]</h1>
    </div>
    <div class="vx-summary-strip__actions">
        <a href="/collections" class="vx-button vx-button--secondary">@T["ui.collections.title"]</a>
        <a href="/billing/settings" class="vx-button vx-button--secondary">@T["ui.billing_settings.title"]</a>
    </div>
</div>
<CollectionsSettingsForm />
