@*
=========================================================
FILE: ZelleClaimPage.razor

PURPOSE:
One Zelle payment report.

IMPORTANT NOTES:
- Page (UI-6): route and composition only
- Text comes from PlatformText (UI-10)
=========================================================
*@
@page "/payments/zelle/{ClaimId:guid}"
@attribute [Authorize]
@inject IStringLocalizer<PlatformText> T

<PageTitle>@T["ui.zelle.claim"]</PageTitle>
<ZelleClaimView ClaimId="ClaimId" />

@code {
    [Parameter]
    public Guid ClaimId { get; set; }
}
