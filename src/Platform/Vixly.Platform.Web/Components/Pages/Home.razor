@*
=========================================================
FILE: Home.razor

PURPOSE:
Console home landing page with quick navigation cards.

IMPORTANT NOTES:
- Page (UI-6): 80 lines or fewer, no business logic
- Text comes from PlatformText (UI-10)
=========================================================
*@
@page "/"
@attribute [Authorize]
@inject IStringLocalizer<PlatformText> T

<PageTitle>@T["ui.home.title"] · @T["ui.app.name"]</PageTitle>

<VxCard Title="@T["ui.home.title"]">
    <p>@T["ui.app.name"]</p>
    <div class="vx-actions">
        <a href="/tenants" class="vx-button vx-button--primary">@T["ui.tenants.title"]</a>
        <a href="/users" class="vx-button">@T["ui.users.title"]</a>
        <a href="/roles" class="vx-button">@T["ui.roles.title"]</a>
        <a href="/departments" class="vx-button">@T["ui.departments.title"]</a>
        <a href="/audit" class="vx-button">@T["ui.audit.title"]</a>
        <a href="/account" class="vx-button">@T["ui.account.title"]</a>
    </div>
</VxCard>
