@page "/"
@attribute [Authorize]
@using Vixly.Platform.Web.Features.Dashboard
@inject IStringLocalizer<PlatformText> T
@* =========================================================
   FILE: Home.razor

   PURPOSE:
   The signed-in Control overview and administration shortcuts.

   RESPONSIBILITIES:
   Present existing authorized Control data and navigation.

   IMPORTANT NOTES:
   Uses existing presenters; no business rules or sample values.
   ========================================================= *@
<PageTitle>@T["ui.home.title"] · @T["ui.app.name"]</PageTitle>
<div class="vx-dashboard">
    <header class="vx-dashboard__header">
        <div><p class="vx-control-eyebrow">@T["ui.control.workspace"]</p><h1 class="vx-page-title">@T["ui.home.title"]</h1><p class="vx-dashboard__subtitle">@T["ui.home.subtitle"]</p></div>
        <div class="vx-dashboard__actions">
            <a href="/offers/new" class="vx-button vx-button--primary">+ @T["ui.offers.new"]</a>
            <a href="/users/invite" class="vx-button vx-button--secondary">@T["ui.invite.title"]</a>
        </div>
    </header>
    <ControlOverview />
    <nav class="vx-control-shortcuts" aria-label="@T["ui.control.shortcuts"]">
        <a href="/collections"><span>@T["ui.collections.title"]</span><span aria-hidden="true">↗</span></a>
        <a href="/plans"><span>@T["ui.plans.title"]</span><span aria-hidden="true">↗</span></a>
        <a href="/users"><span>@T["ui.users.title"]</span><span aria-hidden="true">↗</span></a>
        <a href="/audit"><span>@T["ui.audit.title"]</span><span aria-hidden="true">↗</span></a>
    </nav>
</div>
