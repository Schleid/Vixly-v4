@*
=========================================================
FILE: Home.razor

PURPOSE:
Console home overview dashboard: welcome hero and domain summaries.

IMPORTANT NOTES:
- Page (UI-6): 80 lines or fewer, no business logic
- Text comes from PlatformText (UI-10)
=========================================================
*@
@page "/"
@attribute [Authorize]
@inject IStringLocalizer<PlatformText> T

<PageTitle>@T["ui.home.title"] · @T["ui.app.name"]</PageTitle>

<div class="vx-home">
    <div class="vx-home__hero">
        <h1 class="vx-page-title">@T["ui.invite.title"]</h1>
        <p class="vx-home__subtitle">@T["ui.home.subtitle"]</p>
    </div>

    <div class="vx-dashboard-grid">
        <VxCard Title="@T["ui.tenants.title"]">
            <p>@T["ui.home.tenants_desc"]</p>
            <div class="vx-actions">
                <a href="/tenants" class="vx-button vx-button--primary">@T["ui.home.tenants_action"]</a>
            </div>
        </VxCard>

        <VxCard Title="@T["ui.users.title"]">
            <p>@T["ui.home.users_desc"]</p>
            <div class="vx-actions">
                <a href="/users" class="vx-button vx-button--primary">@T["ui.home.users_action"]</a>
            </div>
        </VxCard>

        <VxCard Title="@T["ui.audit.title"]">
            <p>@T["ui.home.audit_desc"]</p>
            <div class="vx-actions">
                <a href="/audit" class="vx-button vx-button--primary">@T["ui.home.audit_action"]</a>
            </div>
        </VxCard>
    </div>
</div>

