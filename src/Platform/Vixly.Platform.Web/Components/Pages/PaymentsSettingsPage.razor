@*
=========================================================
FILE: PaymentsSettingsPage.razor

PURPOSE:
Card payment settings: provider, mode, currencies, on or off.

IMPORTANT NOTES:
- Page (UI-6): route and composition only
- Text comes from PlatformText (UI-10)
=========================================================
*@
@page "/payments/settings"
@attribute [Authorize]
@inject IStringLocalizer<PlatformText> T

<PageTitle>@T["ui.payments_settings.title"]</PageTitle>
<div class="vx-summary-strip">
    <div class="vx-summary-strip__main">
        <h1 class="vx-summary-strip__title">@T["ui.payments_settings.title"]</h1>
    </div>
    <div class="vx-summary-strip__actions">
        <a href="/payments/transactions" class="vx-button vx-button--secondary">@T["ui.card_payments.list_title"]</a>
        <a href="/billing/settings" class="vx-button vx-button--secondary">@T["ui.billing_settings.title"]</a>
    </div>
</div>
<PaymentsSettingsForm />
<ZelleSettingsForm />
