@*
=========================================================
FILE: SalesSettingsPage.razor

PURPOSE:
The sales manager's limits for discounts and offers (D-S22).

IMPORTANT NOTES:
- Page (UI-6): route and composition only
- Text comes from PlatformText (UI-10)
=========================================================
*@
@page "/sales/settings"
@attribute [Authorize]
@inject IStringLocalizer<PlatformText> T

<PageTitle>@T["ui.sales_settings.title"]</PageTitle>
<div class="vx-summary-strip">
    <div class="vx-summary-strip__main">
        <h1 class="vx-summary-strip__title">@T["ui.sales_settings.title"]</h1>
    </div>
    <div class="vx-summary-strip__actions">
        <a href="/approvals" class="vx-button vx-button--secondary">@T["ui.approvals.title"]</a>
    </div>
</div>
<SalesSettingsForm />
