@*
=========================================================
FILE: CollectionsPage.razor

PURPOSE:
Collections: the dashboard and every case.

IMPORTANT NOTES:
- Page (UI-6): route and composition only
- Text comes from PlatformText (UI-10)
=========================================================
*@
@page "/collections"
@attribute [Authorize]
@inject IStringLocalizer<PlatformText> T

<PageTitle>@T["ui.collections.title"]</PageTitle>
<div class="vx-summary-strip">
    <div class="vx-summary-strip__main">
        <h1 class="vx-summary-strip__title">@T["ui.collections.title"]</h1>
    </div>
    <div class="vx-summary-strip__actions">
        <a href="/invoices" class="vx-button vx-button--secondary">@T["ui.invoices.title"]</a>
        <a href="/collections/settings" class="vx-button vx-button--secondary">@T["ui.collections_settings.title"]</a>
    </div>
</div>
<CollectionsOverview Status="@Status" Stage="@Stage" Currency="@Currency" Extension="@(Extension ?? false)" Search="@Search" Page="@Page" />

@code {
    [SupplyParameterFromQuery]
    public string? Status { get; set; }

    [SupplyParameterFromQuery]
    public string? Stage { get; set; }

    [SupplyParameterFromQuery]
    public string? Currency { get; set; }

    [SupplyParameterFromQuery]
    public bool? Extension { get; set; }

    [SupplyParameterFromQuery]
    public string? Search { get; set; }

    [SupplyParameterFromQuery]
    public int? Page { get; set; }
}
