@*
=========================================================
FILE: EnrolPage.razor

PURPOSE:
First sign-in: add an authenticator app (QR code or setup key) and confirm it with a code.

IMPORTANT NOTES:
- Markup only. Text comes from PlatformText (L-10); values
  come from the endpoint or presenter (ADR-0001)
- Placeholder look: the Frontend/UI team designs the final
  experience (Frontend Guide)
=========================================================
*@
@inject IStringLocalizer<PlatformText> T

<AuthShell Title="@T["ui.enrol.title"]">
    <FormMessage Error="@Error" />
    <div class="vx-passkey" data-passkey-enrol hidden>
        <p class="vx-auth__intro">@T["ui.enrol.passkey_intro"]</p>
        <form method="post" action="/sign-in/enrol/passkey" data-options="/sign-in/enrol/passkey/options">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <input type="hidden" name="attestation" />
            <button type="button" class="vx-button vx-button--primary vx-button--wide" data-passkey-start>@T["ui.enrol.passkey_button"]</button>
        </form>
        <p class="vx-message vx-message--error" role="alert" data-passkey-error hidden>@T["ui.passkey.cancelled"]</p>
        <p class="vx-divider"><span>@T["ui.enrol.or_app"]</span></p>
    </div>
    <p class="vx-auth__intro">@T["ui.enrol.intro"]</p>
    <div class="vx-qr-container">
        <img class="vx-qr" src="@QrDataUri" alt="@T["ui.enrol.qr_alt"]" width="200" height="200" />
    </div>
    <div class="vx-key-display">
        <span class="vx-key-label">@T["ui.enrol.key"]</span>
        <code class="vx-key">@ManualKey</code>
    </div>
    <form method="post" action="/sign-in/enrol" class="vx-form">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <div class="vx-field">
            <label for="code" class="vx-label">@T["ui.verify.code_label"]</label>
            <input id="code" name="code" class="vx-input vx-input--code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" required />
        </div>
        <VxButton Variant="VxButtonVariant.Primary" Type="submit">@T["ui.enrol.submit"]</VxButton>
    </form>
</AuthShell>

@code {
    [Parameter]
    public string ReturnUrl { get; set; } = "/";

    [Parameter]
    public string QrDataUri { get; set; } = string.Empty;

    [Parameter]
    public string ManualKey { get; set; } = string.Empty;

    [Parameter]
    public string? Error { get; set; }
}
