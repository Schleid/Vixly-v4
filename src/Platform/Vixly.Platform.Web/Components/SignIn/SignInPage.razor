@*
=========================================================
FILE: SignInPage.razor
PURPOSE: Step 1 of sign-in: email, password, and passkeys.
=========================================================
*@
@inject IStringLocalizer<PlatformText> T

<ControlLoginShell Title="@T["ui.auth.welcome_back"]" Subtitle="@T["ui.auth.signin_subtitle"]" ReturnHere="/sign-in">
    <FormMessage Error="@Error" Info="@Info" />
    <form method="post" action="/sign-in" class="vx-form">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <div class="vx-field">
            <label for="email" class="vx-label">@T["ui.signin.email"]</label>
            <div class="vx-input-container">
                <svg class="vx-input-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
                <input id="email" name="email" type="email" class="vx-input vx-input--with-icon" autocomplete="username webauthn" placeholder="@T["ui.auth.email_placeholder"]" required value="@Email" />
            </div>
        </div>
        <div class="vx-field">
            <div class="vx-field__header">
                <label for="password" class="vx-label">@T["ui.signin.password"]</label>
                <a href="/forgot-password" class="vx-auth__forgot">@T["ui.signin.forgot"]</a>
            </div>
            <div class="vx-input-container">
                <svg class="vx-input-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                <input id="password" name="password" type="password" class="vx-input vx-input--with-icon" autocomplete="current-password" placeholder="@T["ui.auth.password_placeholder"]" required />
            </div>
        </div>
        <VxButton Variant="VxButtonVariant.Primary" Type="submit">
            @T["ui.auth.signin_button"]
            <svg class="vx-auth__submit-arrow" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg>
        </VxButton>
    </form>
    <div class="vx-passkey" data-passkey-signin hidden>
        <div class="vx-divider"><span>@T["ui.signin.or"]</span></div>
        <form method="post" action="/sign-in/passkey" data-options="/sign-in/passkey/options">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <input type="hidden" name="assertion" />
            <button type="button" class="vx-button--passkey" data-passkey-start>
                <div class="vx-passkey__icon-box" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M19 12a7 7 0 1 0-14 0" /><path d="M12 5v2" /><path d="M12 17v2" /><path d="M5 12H3" /><path d="M21 12h-2" /></svg>
                </div>
                <div class="vx-passkey__info">
                    <span class="vx-passkey__label">@T["ui.signin.passkey"]</span>
                </div>
            </button>
        </form>
        <p class="vx-message vx-message--error" role="alert" data-passkey-error hidden>@T["ui.passkey.cancelled"]</p>
    </div>
</ControlLoginShell>

@code {
    [Parameter]
    public string ReturnUrl { get; set; } = "/";

    [Parameter]
    public string? Email { get; set; }

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public string? Info { get; set; }
}
