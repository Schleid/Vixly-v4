@*
=========================================================
FILE: AuthShell.razor

PURPOSE:
The full HTML document around every sign-in page. Static; the only script is
passkeys.js, which adds the passkey button when the browser supports it.

IMPORTANT NOTES:
- Markup only. Text comes from PlatformText (L-10); values
  come from the endpoint or presenter (ADR-0001)
- Polished by Frontend/UI per ADR-0013 and Frontend Guide
=========================================================
*@
@inject IStringLocalizer<PlatformText> T

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>@Title · @T["ui.app.name"]</title>
    <link rel="stylesheet" href="/_content/Vixly.Shared.UI/vixly-theme.css" />
    <link rel="stylesheet" href="/css/vixly.css" />
    <link rel="stylesheet" href="/_content/Vixly.Shared.UI/vixly-primitives.css" />
    <script src="/js/passkeys.js" defer></script>
</head>
<body class="vx-auth">
    <!-- Atmospheric backdrop & micro-mesh -->
    <div class="vx-auth__backdrop" aria-hidden="true">
        <div class="vx-auth__glow-primary"></div>
        <div class="vx-auth__glow-secondary"></div>
        <div class="vx-auth__grid-texture"></div>
    </div>

    <!-- Top Executive Nav Header -->
    <header class="vx-auth__topbar">
        <div class="vx-auth__topbar-inner">
            <div class="vx-auth__brand">
                <div class="vx-auth__brand-emblem" aria-hidden="true">
                    <svg viewBox="0 0 28 28" width="22" height="22" fill="none">
                        <polygon points="14 2 26 8 26 20 14 26 2 20 2 8" stroke="url(#vx-emblem-grad)" stroke-width="2.2" stroke-linejoin="round" />
                        <path d="M14 6v16M2 8l12 8 12-8" stroke="rgba(96, 165, 250, 0.7)" stroke-width="1.8" stroke-linejoin="round" />
                        <defs>
                            <linearGradient id="vx-emblem-grad" x1="2" y1="2" x2="26" y2="26" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#60A5FA" />
                                <stop offset="1" stop-color="#1D4ED8" />
                            </linearGradient>
                        </defs>
                    </svg>
                </div>
                <div class="vx-auth__brand-titles">
                    <span class="vx-auth__brand-title">VIXLY</span>
                    <span class="vx-auth__brand-badge">@T["ui.auth.badge"]</span>
                </div>
            </div>

            <div class="vx-auth__telemetry-pill" role="status" aria-label="@T["ui.auth.telemetry_status"]">
                <span class="vx-auth__status-dot" aria-hidden="true"></span>
                <span class="vx-auth__telemetry-label">@T["ui.auth.telemetry_status"]</span>
            </div>

            <div class="vx-auth__topbar-actions">
                <span class="vx-auth__security-tag">@T["ui.auth.zero_trust"]</span>
                <nav class="vx-auth__languages" aria-label="@T["ui.language"]">
                    <a href="/culture/en?returnUrl=@ReturnHere" hreflang="en" lang="en" class="@(CurrentLang == "en" ? "active" : null)">EN</a>
                    <a href="/culture/fr?returnUrl=@ReturnHere" hreflang="fr" lang="fr" class="@(CurrentLang == "fr" ? "active" : null)">FR</a>
                    <a href="/culture/es?returnUrl=@ReturnHere" hreflang="es" lang="es" class="@(CurrentLang == "es" ? "active" : null)">ES</a>
                </nav>
            </div>
        </div>
    </header>

    <!-- Main Content Stage: Focused Command Terminal -->
    <main id="main-content" class="vx-auth__stage" aria-labelledby="vx-page-title">
        <div class="vx-auth__terminal">
            <div class="vx-auth__horizon-line" aria-hidden="true"></div>
            
            <header class="vx-auth__header">
                <div class="vx-auth__portal-badge" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                </div>
                <h1 id="vx-page-title" class="vx-auth__title">@Title</h1>
                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <p class="vx-auth__subtitle">@Subtitle</p>
                }
            </header>

            <div class="vx-auth__content">
                @ChildContent
            </div>

            <div class="vx-auth__terminal-footer">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
                <span>@T["ui.auth.authorized_only"]</span>
            </div>
        </div>
    </main>

    <!-- Global System Footer -->
    <footer class="vx-auth__footer">
        <p>@T["ui.auth.footer_text"]</p>
    </footer>
</body>
</html>

@code {
    private string CurrentLang => System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string ReturnHere { get; set; } = "/sign-in";
}