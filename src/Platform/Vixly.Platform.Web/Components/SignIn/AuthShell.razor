@*
=========================================================
FILE: AuthShell.razor

PURPOSE:
The full HTML document around every sign-in page. Static; the only script is
passkeys.js, which adds the passkey button when the browser supports it.

IMPORTANT NOTES:
- Markup only. Text comes from PlatformText (L-10); values
  come from the endpoint or presenter (ADR-0001)
- Polished by Frontend/UI per ADR-0013 and Frontend Guide
=========================================================
*@
@inject IStringLocalizer<PlatformText> T

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>@Title · @T["ui.app.name"]</title>
    <link rel="stylesheet" href="/_content/Vixly.Shared.UI/vixly-theme.css" />
    <link rel="stylesheet" href="/css/vixly.css" />
    <link rel="stylesheet" href="/_content/Vixly.Shared.UI/vixly-primitives.css" />
    <script src="/js/passkeys.js" defer></script>
</head>
<body class="vx-auth">
    <div class="vx-auth__card">
        <aside class="vx-auth__showcase" aria-label="@T["ui.auth.headline"]">
            <div class="vx-auth__showcase-glow" aria-hidden="true"></div>
            <div class="vx-auth__showcase-inner">
                <div class="vx-auth__badge">
                    <span class="vx-auth__badge-dot" aria-hidden="true"></span>
                    <span>@T["ui.auth.badge"]</span>
                </div>
                <div class="vx-auth__showcase-hero">
                    <div class="vx-auth__logo-squircle" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
                        </svg>
                    </div>
                    <h2 class="vx-auth__showcase-title">@T["ui.auth.headline"]</h2>
                    <p class="vx-auth__showcase-desc">@T["ui.auth.description"]</p>
                </div>
                <div class="vx-auth__telemetry" role="region" aria-label="@T["ui.auth.telemetry.badge"]">
                    <div class="vx-auth__telemetry-header">
                        <span class="vx-auth__telemetry-dot" aria-hidden="true"></span>
                        <span class="vx-auth__telemetry-badge">@T["ui.auth.telemetry.badge"]</span>
                    </div>
                    <div class="vx-auth__telemetry-grid">
                        <div class="vx-auth__telemetry-item">
                            <div class="vx-auth__telemetry-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                                    <path d="M9 12l2 2 4-4" />
                                </svg>
                            </div>
                            <div class="vx-auth__telemetry-text">
                                <div class="vx-auth__telemetry-title">@T["ui.auth.telemetry.p1_title"]</div>
                                <div class="vx-auth__telemetry-desc">@T["ui.auth.telemetry.p1_desc"]</div>
                            </div>
                        </div>
                        <div class="vx-auth__telemetry-item">
                            <div class="vx-auth__telemetry-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="2" width="20" height="8" rx="2" ry="2" />
                                    <rect x="2" y="14" width="20" height="8" rx="2" ry="2" />
                                    <line x1="6" y1="6" x2="6.01" y2="6" />
                                    <line x1="6" y1="18" x2="6.01" y2="18" />
                                </svg>
                            </div>
                            <div class="vx-auth__telemetry-text">
                                <div class="vx-auth__telemetry-title">@T["ui.auth.telemetry.p2_title"]</div>
                                <div class="vx-auth__telemetry-desc">@T["ui.auth.telemetry.p2_desc"]</div>
                            </div>
                        </div>
                        <div class="vx-auth__telemetry-item">
                            <div class="vx-auth__telemetry-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
                                </svg>
                            </div>
                            <div class="vx-auth__telemetry-text">
                                <div class="vx-auth__telemetry-title">@T["ui.auth.telemetry.p3_title"]</div>
                                <div class="vx-auth__telemetry-desc">@T["ui.auth.telemetry.p3_desc"]</div>
                            </div>
                        </div>
                    </div>
                    <div class="vx-auth__telemetry-footer">
                        <span>@T["ui.auth.telemetry.footer"]</span>
                    </div>
                </div>
                <div class="vx-auth__compliance">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                    <span>@T["ui.auth.compliance"]</span>
                </div>
            </div>
        </aside>
        <main id="main-content" class="vx-auth__form-pane" aria-labelledby="vx-page-title">
            <div class="vx-auth__form-badge">
                <span class="vx-auth__badge-dot" aria-hidden="true"></span>
                <span>@T["ui.auth.form_badge"]</span>
            </div>
            <header class="vx-auth__header">
                <h1 id="vx-page-title" class="vx-auth__title">@Title</h1>
                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <p class="vx-auth__subtitle">@Subtitle</p>
                }
            </header>
            @ChildContent
            <div class="vx-auth__disclaimer">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
                <span>@T["ui.auth.authorized_only"]</span>
            </div>
            <nav class="vx-auth__languages" aria-label="@T["ui.language"]">
                <a href="/culture/en?returnUrl=@ReturnHere" hreflang="en" lang="en" class="@(CurrentLang == "en" ? "active" : null)">English</a>
                <a href="/culture/fr?returnUrl=@ReturnHere" hreflang="fr" lang="fr" class="@(CurrentLang == "fr" ? "active" : null)">Français</a>
                <a href="/culture/es?returnUrl=@ReturnHere" hreflang="es" lang="es" class="@(CurrentLang == "es" ? "active" : null)">Español</a>
            </nav>
        </main>
    </div>
</body>
</html>

@code {
    private string CurrentLang => System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string ReturnHere { get; set; } = "/sign-in";
}