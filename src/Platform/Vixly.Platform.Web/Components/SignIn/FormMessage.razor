@*
=========================================================
FILE: FormMessage.razor

PURPOSE:
An error or information message on a sign-in form, announced to screen readers.

IMPORTANT NOTES:
- Markup only. Text comes from PlatformText (L-10); values
  come from the endpoint or presenter (ADR-0001)
- Placeholder look: the Frontend/UI team designs the final
  experience (Frontend Guide)
=========================================================
*@
@if (!string.IsNullOrEmpty(Error))
{
    <VxMessage Type="VxMessageType.Error">@Error</VxMessage>
}
@if (!string.IsNullOrEmpty(Info))
{
    <VxMessage Type="VxMessageType.Info">@Info</VxMessage>
}

@code {
    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public string? Info { get; set; }
}
