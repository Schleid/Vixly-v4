@*
=========================================================
FILE: ForgotPasswordPage.razor

PURPOSE:
Ask for a password-reset link. The answer never says whether the email exists.

IMPORTANT NOTES:
- Markup only. Text comes from PlatformText (L-10); values
  come from the endpoint or presenter (ADR-0001)
- Placeholder look: the Frontend/UI team designs the final
  experience (Frontend Guide)
=========================================================
*@
@inject IStringLocalizer<PlatformText> T

<AuthShell Title="@T["ui.forgot.title"]" ReturnHere="/forgot-password">
    @if (Sent)
    {
        <FormMessage Info="@T["ui.forgot.sent"]" />
    }
    else
    {
        <p>@T["ui.forgot.intro"]</p>
        <form method="post" action="/forgot-password" class="vx-form">
            <AntiforgeryToken />
            <label for="email">@T["ui.signin.email"]</label>
            <input id="email" name="email" type="email" autocomplete="username" required />
            <button type="submit" class="vx-button vx-button--primary">@T["ui.forgot.submit"]</button>
        </form>
    }
    <p><a href="/sign-in">@T["ui.signin.back"]</a></p>
</AuthShell>

@code {
    [Parameter]
    public bool Sent { get; set; }
}
