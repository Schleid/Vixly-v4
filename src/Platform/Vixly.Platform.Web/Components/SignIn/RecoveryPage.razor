@*
=========================================================
FILE: RecoveryPage.razor

PURPOSE:
Step 2 of sign-in with a single-use recovery code.

IMPORTANT NOTES:
- Markup only. Text comes from PlatformText (L-10); values
  come from the endpoint or presenter (ADR-0001)
- Placeholder look: the Frontend/UI team designs the final
  experience (Frontend Guide)
=========================================================
*@
@inject IStringLocalizer<PlatformText> T

<AuthShell Title="@T["ui.recovery.title"]">
    <FormMessage Error="@Error" />
    <form method="post" action="/sign-in/recovery" class="vx-form">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <div class="vx-field">
            <label for="code" class="vx-label">@T["ui.recovery.code_label"]</label>
            <input id="code" name="code" class="vx-input vx-input--code" autocomplete="off" spellcheck="false" required autofocus />
        </div>
        <VxButton Variant="VxButtonVariant.Primary" Type="submit">@T["ui.verify.submit"]</VxButton>
    </form>
    <div class="vx-auth__links">
        <p><a href="/sign-in">@T["ui.signin.back"]</a></p>
    </div>
</AuthShell>

@code {
    [Parameter]
    public string ReturnUrl { get; set; } = "/";

    [Parameter]
    public string? Error { get; set; }
}
