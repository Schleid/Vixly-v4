@*
=========================================================
FILE: ControlLoginShell.razor
PURPOSE: Focused executive entry document for the Vixly Control console.
RESPONSIBILITIES:
- Present the dual-wing sign-in console with brand assurance and language navigation
IMPORTANT NOTES:
- Presentation only; existing endpoints, passkeys and form guards are preserved
- Other authentication screens keep their own shell
=========================================================
*@
@inject IStringLocalizer<PlatformText> T
<!DOCTYPE html>
<html lang="@CurrentLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex" />
    <title>@Title · @T["ui.app.name"]</title>
    <link rel="icon" type="image/png" href="/img/vixly-icon.png" />
    <link rel="stylesheet" href="/_content/Vixly.Shared.UI/vixly-theme.css" />
    <link rel="stylesheet" href="/css/vixly.css" />
    <link rel="stylesheet" href="/_content/Vixly.Shared.UI/vixly-primitives.css" />
    <link rel="stylesheet" href="/css/control-entry.css?v=20261020-3" />
    <script src="/js/control-theme.js"></script>
    <script src="/js/passkeys.js" defer></script>
    <script src="/_content/Vixly.Shared.UI/vixly-forms.js" defer></script>
</head>
<body class="vx-auth control-entry">
    <header class="control-entry__bar">
        <div class="control-entry__brand">
            <img src="/img/vixly-icon.png" alt="Vixly" width="30" height="30" />
            <span class="control-entry__brand-title">VIXLY</span>
            <span class="control-entry__brand-badge">CONTROL</span>
        </div>
        <div class="control-entry__telemetry" role="status" aria-label="Status: Operational">
            <span class="control-entry__status-dot" aria-hidden="true"></span>
            <span class="control-entry__telemetry-label">ZERO TRUST · OPERATIONAL</span>
        </div>
        <div class="control-entry__header-actions">
            <button type="button" class="control-entry__theme-btn" data-vx-theme-toggle aria-label="Toggle theme" title="Toggle theme">
                <svg class="control-entry__icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                <svg class="control-entry__icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            </button>
            <nav class="control-entry__languages" aria-label="@T["ui.language"]">
                @foreach (string language in new[] { "en", "fr", "es" })
                {
                    <a href="/culture/@language?returnUrl=@ReturnHere" lang="@language" hreflang="@language" aria-current="@(CurrentLang == language ? "true" : null)">@language.ToUpperInvariant()</a>
                }
            </nav>
        </div>
    </header>
    <main id="main-content" class="control-entry__stage" aria-labelledby="vx-page-title">
        <div class="control-card">
            <!-- Left Wing: Visual & Security Showcase -->
            <section class="control-card__showcase" aria-hidden="true">
                <div class="control-card__showcase-header">
                    <span class="control-card__showcase-pill">PLATFORM GOVERNANCE</span>
                    <h2 class="control-card__showcase-headline">@T["ui.auth.headline"]</h2>
                    <p class="control-card__showcase-desc">@T["ui.auth.description"]</p>
                </div>
                <figure class="control-card__artwork">
                    <img src="/img/control-login-security-cutout.webp" alt="" width="960" height="720" decoding="async" fetchpriority="high" />
                </figure>
                <div class="control-card__security-badges">
                    <span>FIPS 140-3</span>
                    <span>WebAuthn FIDO2</span>
                    <span>Immutable Audit</span>
                </div>
            </section>

            <!-- Right Wing: Credential Console -->
            <section class="control-card__console">
                <header class="control-card__heading">
                    <h1 id="vx-page-title">@Title</h1>
                    @if (!string.IsNullOrWhiteSpace(Subtitle))
                    {
                        <p class="control-card__subtitle">@Subtitle</p>
                    }
                </header>
                <div class="control-card__body">
                    @ChildContent
                </div>
                <p class="control-entry__access">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m12 3 8 3v6c0 4-8 9-8 9s-8-5-8-9V6z" /><path d="m8 12 3 3 5-6" /></svg>
                    <span>@T["ui.auth.authorized_only"]</span>
                </p>
            </section>
        </div>
    </main>
</body>
</html>

@code {
    private string CurrentLang => System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string ReturnHere { get; set; } = "/sign-in";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
