@*
=========================================================
FILE: UserList.razor

PURPOSE:
The staff user list: search, status filter, pages.

IMPORTANT NOTES:
- Feature component (ADR-0001): behaviour lives in the
  presenter; this file holds markup and UI glue only
- Text comes from PlatformText (UI-10); placeholder look until
  the Frontend/UI team designs it
- Search, status and page live in the URL (UI-3)
=========================================================
*@
@inherits PlatformPresenterComponent<UserListPresenter>
@using Vixly.Platform.Domain.Identity
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors
@inject NavigationManager Navigation

<form class="vx-toolbar" role="search" @onsubmit="ApplyFilters">
    <label for="user-search">@T["ui.users.search"]</label>
    <input id="user-search" type="search" @bind="_search" maxlength="100" />
    <label for="user-status">@T["ui.users.status"]</label>
    <select id="user-status" @bind="_status">
        <option value="">@T["ui.users.status.all"]</option>
        @foreach (PlatformUserAccountStatus status in Enum.GetValues<PlatformUserAccountStatus>())
        {
            <option value="@status">@T[PlatformDisplay.StatusKey(status)]</option>
        }
    </select>
    <VxButton Type="submit">@T["ui.users.apply"]</VxButton>
    @if (Presenter.State.CanInvite)
    {
        <a class="vx-button vx-button--primary" href="/users/invite">@T["ui.users.invite"]</a>
    }
</form>

@if (Presenter.State.Error is not null)
{
    <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
}
else
{
    <VxDataTable Items="Presenter.State.Users" IsLoading="@(!Presenter.State.Loaded)" Caption="@(Presenter.State.Loaded ? VixlyText.Format(T, "ui.users.count", "count", Presenter.State.TotalCount) : null)">
        <HeaderContent>
            <th scope="col">@T["ui.users.name"]</th>
            <th scope="col">@T["ui.signin.email"]</th>
            <th scope="col">@T["ui.users.status"]</th>
            <th scope="col">@T["ui.users.authority"]</th>
            <th scope="col">@T["ui.users.last_sign_in"]</th>
        </HeaderContent>
        <RowTemplate Context="user">
            <td><a href="/users/@user.PlatformUserId">@user.LastName, @user.FirstName</a></td>
            <td>@user.Email</td>
            <td><VxStatusBadge Status="@PlatformDisplay.UserBadge(user.Status)" Text="@T[PlatformDisplay.StatusKey(user.Status)]" /></td>
            <td>@T[PlatformDisplay.AuthorityKey(user.AuthorityLevel)]</td>
            <td>@PlatformDisplay.Utc(T, user.LastSignInUtc)</td>
        </RowTemplate>
        <EmptyContent>
            <VxEmptyState Title="@T["ui.users.empty"]" />
        </EmptyContent>
    </VxDataTable>
    @if (Presenter.State.Loaded && Presenter.State.Users.Count > 0)
    {
        <VxPager CurrentPage="Presenter.State.Page" TotalPages="Presenter.State.TotalPages" PageChanged="GoToPage" />
    }
}

@code {
    private string? _search;

    private string _status = string.Empty;

    [Parameter]
    public string? Search { get; set; }

    [Parameter]
    public string? Status { get; set; }

    [Parameter]
    public int? Page { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _search = Search;
        PlatformUserAccountStatus? status = Enum.TryParse(Status, true, out PlatformUserAccountStatus parsed) ? parsed : null;
        _status = status?.ToString() ?? string.Empty;

        await Presenter.LoadAsync(Search, status, Page ?? 1);
    }

    private void ApplyFilters()
    {
        Navigation.NavigateTo(Url(_search, _status, 1));
    }

    private string PageUrl(int page)
    {
        return Url(Search, _status, page);
    }

    private static string Url(string? search, string status, int page)
    {
        return WithQuery("/users", new Dictionary<string, object?>
        {
            ["search"] = string.IsNullOrWhiteSpace(search) ? null : search.Trim(),
            ["status"] = string.IsNullOrEmpty(status) ? null : status,
            ["page"] = page > 1 ? page : null
        });
    }

    private static string WithQuery(string path, Dictionary<string, object?> query)
    {
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(
            path,
            query.Where(pair => pair.Value is not null)
                .Select(pair => new KeyValuePair<string, string?>(pair.Key, Convert.ToString(pair.Value, System.Globalization.CultureInfo.InvariantCulture))));
    }

    private void GoToPage(int page)
    {
        Navigation.NavigateTo(PageUrl(page));
    }
}
