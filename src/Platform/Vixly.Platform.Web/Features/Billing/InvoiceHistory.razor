@*
=========================================================
FILE: InvoiceHistory.razor

PURPOSE:
What happened to an invoice, newest first.

IMPORTANT NOTES:
- Markup only; values come from the invoice detail
- History is append-only in the database (D-2)
=========================================================
*@
@using Vixly.Platform.Application.UseCases.Billing
@inject IStringLocalizer<PlatformText> T

<div id="invoice-history"><VxCard Title="@T["ui.invoices.history"]">
    <VxDataTable Items="Items" IsLoading="false">
        <HeaderContent>
            <th scope="col">@T["ui.audit.when"]</th>
            <th scope="col">@T["ui.audit.what"]</th>
            <th scope="col">@T["ui.audit.who"]</th>
            <th scope="col">@T["ui.tenants.reason"]</th>
        </HeaderContent>
        <RowTemplate Context="item">
            <td>@PlatformDisplay.Utc(T, item.OccurredUtc)</td>
            <td>@BillingDisplay.History(T, item)</td>
            <td>@(item.ActorName ?? T["ui.audit.no_actor"].Value)</td>
            <td>@item.Reason</td>
        </RowTemplate>
        <EmptyContent>
            <VxEmptyState Title="@T["ui.subscriptions.history_empty"]" />
        </EmptyContent>
    </VxDataTable>
</VxCard></div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<PlatformInvoiceEventItem> Items { get; set; } = Array.Empty<PlatformInvoiceEventItem>();
}
