@*
=========================================================
FILE: CompanyProfileForm.razor

PURPOSE:
The company profile printed on invoices, credit notes and
receipts, and its logo (D-B12).

IMPORTANT NOTES:
- Markup and UI glue only; the parent presenter saves
- Text comes from PlatformText (UI-10); placeholder look until
  the Frontend/UI team designs it
- The logo is stored with the profile (PNG or JPEG, size
  limited); documents never fetch a URL
=========================================================
*@
@using Vixly.Platform.Application.UseCases.Billing
@using Vixly.Platform.Domain.Billing
@using Vixly.Shared.Kernel.Errors
@inject IStringLocalizer<PlatformText> T

<div id="company-profile"><VxCard Title="@T["ui.billing_settings.company_profile"]">
    <p class="vx-hint">@T["ui.billing_settings.company_profile_help"]</p>
    <form class="vx-form" @onsubmit="() => OnSave.InvokeAsync(_model)">
        <fieldset class="vx-fieldset" disabled="@(!CanEdit)">
            <label for="profile-legal">@T["ui.tenants.legal_name"]</label>
            <input id="profile-legal" @bind="_model.LegalName" maxlength="200" required />
            <label for="profile-trading">@T["ui.tenants.trading_name"]</label>
            <input id="profile-trading" @bind="_model.TradingName" maxlength="200" />
            <label for="profile-email">@T["ui.billing_settings.email"]</label>
            <input id="profile-email" type="email" @bind="_model.Email" maxlength="254" required />
            <label for="profile-phone">@T["ui.billing_settings.phone"]</label>
            <input id="profile-phone" type="tel" @bind="_model.Phone" maxlength="30" required />
            <label for="profile-line1">@T["ui.tenants.address_line1"]</label>
            <input id="profile-line1" @bind="_model.Line1" maxlength="200" required />
            <label for="profile-line2">@T["ui.tenants.address_line2"]</label>
            <input id="profile-line2" @bind="_model.Line2" maxlength="200" />
            <label for="profile-city">@T["ui.tenants.city"]</label>
            <input id="profile-city" @bind="_model.City" maxlength="100" required />
            <label for="profile-region">@T["ui.tenants.state_province"]</label>
            <input id="profile-region" @bind="_model.StateProvince" maxlength="100" />
            <label for="profile-postal">@T["ui.tenants.postal_code"]</label>
            <input id="profile-postal" @bind="_model.PostalCode" maxlength="20" />
            <label for="profile-country">@T["ui.tenants.country"]</label>
            <select id="profile-country" @bind="_model.CountryCode" required>
                <option value="">-</option>
                @foreach ((string country, string name) in PlatformDisplay.Countries(T))
                {
                    <option value="@country">@name</option>
                }
            </select>
            <label for="profile-tax">@T["ui.billing_settings.tax_id"]</label>
            <input id="profile-tax" @bind="_model.TaxId" maxlength="50" />
            <label for="profile-website">@T["ui.billing_settings.website"]</label>
            <input id="profile-website" type="url" @bind="_model.Website" maxlength="200" placeholder="https://" />
            <label for="profile-support-email">@T["ui.billing_settings.support_email"]</label>
            <input id="profile-support-email" type="email" @bind="_model.SupportEmail" maxlength="254" />
            <label for="profile-support-phone">@T["ui.billing_settings.support_phone"]</label>
            <input id="profile-support-phone" type="tel" @bind="_model.SupportPhone" maxlength="32" aria-describedby="profile-support-help" />
            <p id="profile-support-help" class="vx-hint">@T["ui.billing_settings.support_help"]</p>
        </fieldset>
        @if (CanEdit)
        {
            <div class="vx-actions">
                <VxButton Variant="VxButtonVariant.Primary" Type="submit" IsBusy="@IsBusy">@T["ui.billing_settings.save_profile"]</VxButton>
            </div>
        }
    </form>
    @if (Profile is not null)
    {
        <p>@T[Profile.HasLogo ? "ui.billing_settings.logo_set" : "ui.billing_settings.logo_none"]</p>
        @if (CanEdit)
        {
            <label for="profile-logo">@T["ui.billing_settings.logo"]</label>
            <InputFile id="profile-logo" accept="image/png,image/jpeg" OnChange="UploadAsync" aria-describedby="profile-logo-help" />
            <p id="profile-logo-help" class="vx-hint">@VixlyText.Format(T, "ui.billing_settings.logo_help", "maxKilobytes", PlatformBillingLimits.MaxLogoKilobytes)</p>
        }
    }
</VxCard></div>

@code {
    private CompanyProfileModel _model = new();

    private int _seenVersion = -1;

    [Parameter]
    public PlatformCompanyProfileItem? Profile { get; set; }

    [Parameter]
    public bool CanEdit { get; set; }

    [Parameter]
    public int Version { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback<CompanyProfileModel> OnSave { get; set; }

    [Parameter]
    public EventCallback<(byte[] Content, string ContentType)> OnLogo { get; set; }

    [Parameter]
    public EventCallback<Error> OnRefused { get; set; }

    protected override void OnParametersSet()
    {
        if (_seenVersion != Version)
        {
            _seenVersion = Version;
            _model = CompanyProfileModel.From(Profile);
        }
    }

    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        long limit = PlatformBillingLimits.MaxLogoKilobytes * 1024L;

        if (args.File.Size > limit)
        {
            await OnRefused.InvokeAsync(PlatformBillingErrors.LogoInvalid);
            return;
        }

        using MemoryStream buffer = new();
        await using Stream stream = args.File.OpenReadStream(limit);
        await stream.CopyToAsync(buffer);
        await OnLogo.InvokeAsync((buffer.ToArray(), args.File.ContentType));
    }
}
