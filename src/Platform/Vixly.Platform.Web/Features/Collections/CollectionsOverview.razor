@*
=========================================================
FILE: CollectionsOverview.razor

PURPOSE:
The collections dashboard and the paged list of cases, with
stage, status, currency, extension and tenant filters.

IMPORTANT NOTES:
- Feature component (ADR-0001): behaviour lives in the
  presenter; this file holds markup and UI glue only
- Text comes from PlatformText (UI-10); placeholder look until
  the Frontend/UI team designs it
- Filters live in the URL so a view can be bookmarked
=========================================================
*@
@inherits PlatformPresenterComponent<CollectionsOverviewPresenter>
@using Vixly.Platform.Application.Queries
@using Vixly.Platform.Domain.Collections
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors
@inject NavigationManager Navigation

@if (Presenter.State.Error is not null)
{
    <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
}
@if (Presenter.State.Dashboard is { } dashboard)
{
    <div id="collections-dashboard" class="vx-collections-dashboard-grid">
        <!-- Card 1: Lifecycle Pipeline by Stage -->
        <div class="vx-kpi-card">
            <div class="vx-kpi-card__header">
                <h2 class="vx-kpi-card__title">@T["ui.collections.stage"]</h2>
                <span class="vx-kpi-card__badge">@T["ui.collections.dashboard"]</span>
            </div>
            <div class="vx-stage-pipeline">
                @foreach (PlatformCollectionStage stage in Enum.GetValues<PlatformCollectionStage>())
                {
                    <a href="@Url(1, stage.ToString(), "Open")" class="vx-stage-step">
                        <span class="vx-stage-step__label">@T[CollectionsDisplay.StageKey(stage)]</span>
                        <span class="vx-stage-step__count">@(dashboard.OpenByStage.TryGetValue(stage, out int count) ? count : 0)</span>
                    </a>
                }
            </div>
        </div>

        <!-- Card 2: Financial Exposure & Recoveries -->
        <div class="vx-kpi-card">
            <div class="vx-kpi-card__header">
                <h2 class="vx-kpi-card__title">@T["ui.collections.overdue"]</h2>
                <span class="vx-kpi-card__badge">@T["ui.invoices.title"]</span>
            </div>
            <div class="vx-financial-stat">
                <div class="vx-financial-stat__label">@T["ui.collections.overdue_total"]</div>
                <div class="vx-financial-stat__value vx-financial-stat__value--highlight">@CollectionsDisplay.Amounts(dashboard.Overdue)</div>
            </div>
            <div class="vx-stat-rows">
                @foreach (IGrouping<int, PlatformAgeingItem> bucket in dashboard.Ageing.GroupBy(item => item.Bucket))
                {
                    <div class="vx-stat-row">
                        <span class="vx-stat-row__label">@T[CollectionsDisplay.AgeingKey(bucket.Key)]</span>
                        <span class="vx-stat-row__value">@CollectionsDisplay.Amounts(bucket.Select(item => new PlatformMoneyItem(item.CurrencyCode, item.Amount)).ToArray())</span>
                    </div>
                }
                <div class="vx-stat-row" style="margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px solid var(--vx-color-border);">
                    <span class="vx-stat-row__label">@T["ui.collections.recovered"]</span>
                    <span class="vx-stat-row__value" style="color: #16a34a;">@CollectionsDisplay.Amounts(dashboard.Recovered)</span>
                </div>
            </div>
        </div>

        <!-- Card 3: Subscription Status & System Flags -->
        <div class="vx-kpi-card">
            <div class="vx-kpi-card__header">
                <h2 class="vx-kpi-card__title">@T["ui.collections.case"]</h2>
                <span class="vx-kpi-card__badge">@T["ui.tenants.status"]</span>
            </div>
            <div class="vx-stat-rows">
                <div class="vx-stat-row">
                    <span class="vx-stat-row__label">@T["ui.collections.blocked_subscriptions"]</span>
                    <span class="vx-stat-row__value" style="color: @(dashboard.Blocked > 0 ? "#dc2626" : "inherit");">@dashboard.Blocked</span>
                </div>
                <div class="vx-stat-row">
                    <span class="vx-stat-row__label">@T["ui.collections.extensions_ending"]</span>
                    <span class="vx-stat-row__value" style="color: @(dashboard.ExtensionsEndingSoon > 0 ? "#d97706" : "inherit");">@dashboard.ExtensionsEndingSoon</span>
                </div>
                <div class="vx-stat-row">
                    <span class="vx-stat-row__label">@T["ui.collections.long_blocks"]</span>
                    <span class="vx-stat-row__value" style="color: @(dashboard.LongBlocks > 0 ? "#dc2626" : "inherit");">@dashboard.LongBlocks</span>
                </div>
                <div class="vx-stat-row">
                    <span class="vx-stat-row__label">@T["ui.collections.failed_retries"]</span>
                    <span class="vx-stat-row__value">@dashboard.FailedRetries</span>
                </div>
            </div>
        </div>
    </div>
}

<form class="vx-toolbar" role="search" @onsubmit="Apply" style="display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.75rem; margin-bottom: 0.5rem;">
    <div style="flex: 1 1 14rem; min-width: 12rem;">
        <label for="collections-search" style="display: block; font-size: 0.72rem; font-weight: 700; color: var(--vx-color-text-muted); text-transform: uppercase; margin-bottom: 0.25rem;">@T["ui.collections.search"]</label>
        <input id="collections-search" @bind="_search" maxlength="100" style="width: 100%;" placeholder="@T["ui.collections.search"]" />
    </div>
    <div style="flex: 0 1 10rem;">
        <label for="collections-status" style="display: block; font-size: 0.72rem; font-weight: 700; color: var(--vx-color-text-muted); text-transform: uppercase; margin-bottom: 0.25rem;">@T["ui.collections.status"]</label>
        <select id="collections-status" @bind="_status" style="width: 100%;">
            <option value="">@T["ui.invoices.status.all"]</option>
            @foreach (PlatformCollectionCaseStatus status in Enum.GetValues<PlatformCollectionCaseStatus>())
            {
                <option value="@status">@T[CollectionsDisplay.StatusKey(status)]</option>
            }
        </select>
    </div>
    <div style="flex: 0 1 11rem;">
        <label for="collections-stage" style="display: block; font-size: 0.72rem; font-weight: 700; color: var(--vx-color-text-muted); text-transform: uppercase; margin-bottom: 0.25rem;">@T["ui.collections.stage"]</label>
        <select id="collections-stage" @bind="_stage" style="width: 100%;">
            <option value="">@T["ui.collections.stage.all"]</option>
            @foreach (PlatformCollectionStage stage in Enum.GetValues<PlatformCollectionStage>())
            {
                <option value="@stage">@T[CollectionsDisplay.StageKey(stage)]</option>
            }
        </select>
    </div>
    <div style="flex: 0 1 5rem;">
        <label for="collections-currency" style="display: block; font-size: 0.72rem; font-weight: 700; color: var(--vx-color-text-muted); text-transform: uppercase; margin-bottom: 0.25rem;">@T["ui.collections.currency"]</label>
        <input id="collections-currency" @bind="_currency" maxlength="3" size="4" style="width: 100%; text-transform: uppercase;" placeholder="USD" />
    </div>
    <div style="display: flex; align-items: center; gap: 0.5rem; height: 36px; padding-bottom: 4px;">
        <label style="display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.8125rem; font-weight: 500; cursor: pointer; text-transform: none; margin: 0;">
            <input type="checkbox" @bind="_extension" /> @T["ui.collections.in_extension"]
        </label>
    </div>
    <div style="padding-bottom: 4px;">
        <VxButton Type="submit">@T["ui.users.apply"]</VxButton>
    </div>
</form>
<p class="vx-hint">@(Presenter.State.Loaded ? VixlyText.Format(T, "ui.collections.count", "count", Presenter.State.TotalCount) : T["ui.common.loading"].Value)</p>
<div id="collections-cases"><CollectionCaseTable Items="Presenter.State.Items" /></div>
@if (Presenter.State.Loaded && Presenter.State.TotalPages > 1)
{
    <VxPager CurrentPage="Presenter.State.Page" TotalPages="Presenter.State.TotalPages" PageChanged="page => Navigation.NavigateTo(Url(page, _stage, _status))" />
}

@code {
    private string _status = string.Empty;

    private string _stage = string.Empty;

    private string? _currency;

    private string? _search;

    private bool _extension;

    [Parameter]
    public string? Status { get; set; }

    [Parameter]
    public string? Stage { get; set; }

    [Parameter]
    public string? Currency { get; set; }

    [Parameter]
    public bool Extension { get; set; }

    [Parameter]
    public string? Search { get; set; }

    [Parameter]
    public int? Page { get; set; }

    protected override Task OnParametersSetAsync()
    {
        PlatformCollectionCaseStatus? status = Enum.TryParse(Status, true, out PlatformCollectionCaseStatus parsedStatus) ? parsedStatus : null;
        PlatformCollectionStage? stage = Enum.TryParse(Stage, true, out PlatformCollectionStage parsedStage) ? parsedStage : null;
        _status = status?.ToString() ?? string.Empty;
        _stage = stage?.ToString() ?? string.Empty;
        _currency = Currency;
        _search = Search;
        _extension = Extension;
        return Presenter.LoadAsync(status, stage, Currency, Extension ? true : null, Search, Page ?? 1);
    }

    private void Apply()
    {
        Navigation.NavigateTo(Url(1, _stage, _status));
    }

    private string Url(int page, string? stage, string? status)
    {
        Dictionary<string, string?> query = new()
        {
            ["status"] = string.IsNullOrEmpty(status) ? null : status,
            ["stage"] = string.IsNullOrEmpty(stage) ? null : stage,
            ["currency"] = string.IsNullOrWhiteSpace(_currency) ? null : _currency.Trim().ToUpperInvariant(),
            ["extension"] = _extension ? "true" : null,
            ["search"] = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
            ["page"] = page > 1 ? page.ToString(System.Globalization.CultureInfo.InvariantCulture) : null
        };

        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/collections", query.Where(pair => pair.Value is not null));
    }
}
