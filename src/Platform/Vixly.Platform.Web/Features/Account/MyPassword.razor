@*
=========================================================
FILE: MyPassword.razor

PURPOSE:
Changes the signed-in user's password.

IMPORTANT NOTES:
- Feature component (ADR-0001): behaviour lives in the
  presenter; this file holds markup and UI glue only
- Text comes from PlatformText (UI-10); placeholder look until
  the Frontend/UI team designs it
- Clears the fields after every attempt
=========================================================
*@
@inherits PlatformPresenterComponent<MyPasswordPresenter>
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors
@inject NavigationManager Navigation

<VxCard Title="@T["ui.account.password"]">
    @if (Presenter.State.Error is not null)
    {
        <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
    }
    @if (Presenter.State.Changed)
    {
        <VxMessage Type="VxMessageType.Info">@VixlyText.Format(T, "ui.account.password_changed", "count", Presenter.State.OtherSessionsEnded)</VxMessage>
    }
    <form class="vx-form" @onsubmit="ChangeAsync">
        <label for="pw-current">@T["ui.account.current_password"]</label>
        <input id="pw-current" type="password" autocomplete="current-password" @bind="_current" required />
        <label for="pw-new">@T["ui.invite.password"]</label>
        <input id="pw-new" type="password" autocomplete="new-password" minlength="12" maxlength="64" @bind="_new" required />
        <label for="pw-confirm">@T["ui.account.confirm_password"]</label>
        <input id="pw-confirm" type="password" autocomplete="new-password" @bind="_confirm" required />
        <div class="vx-actions">
            <VxButton Variant="VxButtonVariant.Primary" Type="submit" IsBusy="@Presenter.IsBusy">@T["ui.account.change_password"]</VxButton>
        </div>
    </form>
</VxCard>

@code {
    private string _current = string.Empty;

    private string _new = string.Empty;

    private string _confirm = string.Empty;

    private async Task ChangeAsync()
    {
        await Presenter.ChangeAsync(_current, _new, _confirm);
        _current = _new = _confirm = string.Empty;

        if (Presenter.State.SessionEnded)
        {
            Navigation.NavigateTo("/sign-in", forceLoad: true);
        }
    }
}
