@*
=========================================================
FILE: MyProfile.razor

PURPOSE:
Who the signed-in user is, and the language of their console
and emails.

IMPORTANT NOTES:
- Feature component (ADR-0001): behaviour lives in the
  presenter; this file holds markup and UI glue only
- Text comes from PlatformText (UI-10); placeholder look until
  the Frontend/UI team designs it
- Reloads the page after a language change (the circuit keeps
  its culture until then)
=========================================================
*@
@inherits PlatformPresenterComponent<MyProfilePresenter>
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors
@inject NavigationManager Navigation

<VxCard Title="@T["ui.users.profile"]">
    @if (Presenter.State.Error is not null)
    {
        <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
    }
    @if (Presenter.State.Account is { } account)
    {
        <dl class="vx-facts">
            <dt>@T["ui.users.name"]</dt><dd>@account.FirstName @account.LastName</dd>
            <dt>@T["ui.signin.email"]</dt><dd>@account.Email</dd>
            <dt>@T["ui.users.authority"]</dt><dd>@T[PlatformDisplay.AuthorityKey(account.AuthorityLevel)]</dd>
        </dl>
        <form class="vx-form" @onsubmit="ChangeLanguageAsync">
            <label for="my-language">@T["ui.account.language"]</label>
            <select id="my-language" @bind="_language">
                @foreach (string language in VixlyCultures.Supported.Select(culture => culture.TwoLetterISOLanguageName))
                {
                    <option value="@language">@T["ui.language." + language]</option>
                }
            </select>
            <div class="vx-actions">
                <VxButton Type="submit" IsBusy="@Presenter.IsBusy">@T["ui.account.save"]</VxButton>
            </div>
        </form>
    }
    else if (Presenter.State.Error is null)
    {
        <p role="status">@T["ui.common.loading"]</p>
    }
</VxCard>

@code {
    private string _language = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (Presenter.State.Account is null)
        {
            await Presenter.LoadAsync();
            _language = Presenter.State.Account?.PreferredLanguage ?? string.Empty;
        }
    }

    private async Task ChangeLanguageAsync()
    {
        await Presenter.ChangeLanguageAsync(_language);

        if (Presenter.State.LanguageChanged)
        {
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
    }
}
