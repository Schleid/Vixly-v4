@*
=========================================================
FILE: MySessions.razor

PURPOSE:
The signed-in user's open sessions, with a way to end them.

IMPORTANT NOTES:
- Feature component (ADR-0001): behaviour lives in the
  presenter; this file holds markup and UI glue only
- Text comes from PlatformText (UI-10); placeholder look until
  the Frontend/UI team designs it
=========================================================
*@
@inherits PlatformPresenterComponent<MySessionsPresenter>
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors

<VxCard Title="@T["ui.users.sessions"]">
    @if (Presenter.State.Error is not null)
    {
        <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
    }
    @if (Presenter.State.EndedCount is int ended)
    {
        <VxMessage Type="VxMessageType.Info">@VixlyText.Format(T, "ui.account.sessions_ended", "count", ended)</VxMessage>
    }
    <VxDataTable Items="Presenter.State.Sessions">
        <HeaderContent>
            <th scope="col">@T["ui.users.session_started"]</th>
            <th scope="col">@T["ui.users.session_last_seen"]</th>
            <th scope="col">@T["ui.users.session_ip"]</th>
            <th scope="col">@T["ui.users.session_browser"]</th>
            <th scope="col"><span class="vx-visually-hidden">@T["ui.account.session_action"]</span></th>
        </HeaderContent>
        <RowTemplate Context="session">
            <td>@PlatformDisplay.Utc(T, session.StartedUtc)</td>
            <td>@PlatformDisplay.Utc(T, session.LastSeenUtc)</td>
            <td>@session.IpAddress</td>
            <td class="vx-truncate" title="@session.UserAgent">@session.UserAgent</td>
            <td>
                @if (session.SessionId == Presenter.State.CurrentSessionId)
                {
                    <strong>@T["ui.account.this_device"]</strong>
                }
                else
                {
                    <VxButton Variant="VxButtonVariant.Danger" IsBusy="@Presenter.IsBusy" OnClick="() => Presenter.EndAsync(session.SessionId)">@T["ui.account.end_session"]</VxButton>
                }
            </td>
        </RowTemplate>
    </VxDataTable>
    @if (Presenter.State.Sessions.Count > 1)
    {
        <div class="vx-actions">
            <VxButton Variant="VxButtonVariant.Danger" IsBusy="@Presenter.IsBusy" OnClick="() => Presenter.EndAsync(null)">@T["ui.account.end_other_sessions"]</VxButton>
        </div>
    }
</VxCard>

@code {
    protected override Task OnParametersSetAsync()
    {
        return Presenter.LoadAsync();
    }
}
