@*
=========================================================
FILE: DepartmentCreateForm.razor

PURPOSE:
Creates a department, then opens it.

IMPORTANT NOTES:
- Feature component (ADR-0001): behaviour lives in the
  presenter; this file holds markup and UI glue only
- Text comes from PlatformText (UI-10); placeholder look until
  the Frontend/UI team designs it
=========================================================
*@
@inherits PlatformPresenterComponent<DepartmentCreatePresenter>
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors
@inject NavigationManager Navigation

@if (!Presenter.State.Loaded)
{
    <p role="status">@T["ui.common.loading"]</p>
}
else if (!Presenter.State.CanCreate)
{
    <VxMessage Type="VxMessageType.Error">@T["platform.security.access_denied"]</VxMessage>
}
else
{
    <p>@T["ui.departments.new_intro"]</p>
    @if (Presenter.State.Error is not null)
    {
        <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
    }
    <form class="vx-form vx-card" @onsubmit="CreateAsync">
        <label for="department-name">@T["ui.departments.name"]</label>
        <input id="department-name" @bind="_name" maxlength="100" required autocomplete="off" />
        <label for="department-description">@T["ui.departments.description_optional"]</label>
        <textarea id="department-description" @bind="_description" maxlength="500"></textarea>
        <div class="vx-actions">
            <VxButton Variant="VxButtonVariant.Primary" Type="submit" IsBusy="@Presenter.IsBusy">@T["ui.departments.create"]</VxButton>
            <a class="vx-button" href="/departments">@T["ui.common.cancel"]</a>
        </div>
    </form>
}

@code {
    private string _name = string.Empty;

    private string? _description;

    protected override Task OnParametersSetAsync()
    {
        return Presenter.State.Loaded ? Task.CompletedTask : Presenter.LoadAsync();
    }

    private async Task CreateAsync()
    {
        await Presenter.CreateAsync(_name, _description);

        if (Presenter.State.CreatedDepartmentId is Guid created)
        {
            Navigation.NavigateTo("/departments/" + created);
        }
    }
}
