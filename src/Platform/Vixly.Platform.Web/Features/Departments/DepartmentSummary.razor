@*
=========================================================
FILE: DepartmentSummary.razor

PURPOSE:
One department: name, description and state, with edit,
deactivate and reactivate.

IMPORTANT NOTES:
- Feature component (ADR-0001): behaviour lives in the
  presenter; this file holds markup and UI glue only
- Text comes from PlatformText (UI-10); placeholder look until
  the Frontend/UI team designs it
- No step-up: departments are labels and grant nothing (D-S3)
=========================================================
*@
@inherits PlatformPresenterComponent<DepartmentSummaryPresenter>
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors

@if (Presenter.State.Department is { } department)
{
    <PageTitle>@department.Name</PageTitle>
    <h1>@department.Name</h1>
    <VxCard Title="@T["ui.roles.details"]">
        @if (Presenter.State.DoneKey is { } done)
        {
            <VxMessage Type="VxMessageType.Info">@T[done]</VxMessage>
        }
        @if (Presenter.State.Error is not null)
        {
            <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
        }
        <dl class="vx-facts">
            <dt>@T["ui.departments.description"]</dt><dd>@(department.Description ?? T["ui.common.none"].Value)</dd>
            <dt>@T["ui.roles.status"]</dt>
            <dd><VxStatusBadge Status="@PlatformDisplay.ActiveBadge(department.IsActive)" Text="@T[department.IsActive ? "ui.roles.active" : "ui.roles.inactive"]" /></dd>
            <dt>@T["ui.roles.created"]</dt><dd>@PlatformDisplay.Utc(T, department.CreatedUtc)</dd>
        </dl>
        @if (Presenter.State.Editing)
        {
            <form class="vx-form" @onsubmit="SaveAsync">
                <label for="department-edit-name">@T["ui.departments.name"]</label>
                <input id="department-edit-name" @bind="_name" maxlength="100" required autocomplete="off" />
                <label for="department-edit-description">@T["ui.departments.description_optional"]</label>
                <textarea id="department-edit-description" @bind="_description" maxlength="500"></textarea>
                <div class="vx-actions">
                    <VxButton Variant="VxButtonVariant.Primary" Type="submit" IsBusy="@Presenter.IsBusy">@T["ui.departments.save"]</VxButton>
                    <VxButton OnClick="Presenter.Cancel">@T["ui.common.cancel"]</VxButton>
                </div>
            </form>
        }
        else if (Presenter.State.ConfirmingDeactivate)
        {
            <p>@T["ui.departments.deactivate_help"]</p>
            <div class="vx-actions">
                <VxButton Variant="VxButtonVariant.Danger" IsBusy="@Presenter.IsBusy" OnClick="() => Presenter.DeactivateAsync(DepartmentId)">@T["ui.departments.deactivate_confirm"]</VxButton>
                <VxButton OnClick="Presenter.Cancel">@T["ui.common.cancel"]</VxButton>
            </div>
        }
        else
        {
            <div class="vx-actions">
                @if (Presenter.State.Actions.CanEdit)
                {
                    <VxButton OnClick="StartEdit">@T["ui.departments.edit"]</VxButton>
                }
                @if (Presenter.State.Actions.CanDeactivate)
                {
                    <VxButton OnClick="Presenter.StartDeactivate">@T["ui.roles.deactivate"]</VxButton>
                }
                @if (Presenter.State.Actions.CanReactivate)
                {
                    <VxButton IsBusy="@Presenter.IsBusy" OnClick="() => Presenter.ReactivateAsync(DepartmentId)">@T["ui.roles.reactivate"]</VxButton>
                }
            </div>
        }
    </VxCard>
}
else if (Presenter.State.Error is not null)
{
    <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
}
else
{
    <p role="status">@T["ui.common.loading"]</p>
}

@code {
    private string _name = string.Empty;

    private string? _description;

    [Parameter, EditorRequired]
    public Guid DepartmentId { get; set; }

    protected override Task OnParametersSetAsync()
    {
        return Presenter.LoadAsync(DepartmentId);
    }

    private void StartEdit()
    {
        _name = Presenter.State.Department?.Name ?? string.Empty;
        _description = Presenter.State.Department?.Description;
        Presenter.StartEdit();
    }

    private Task SaveAsync()
    {
        return Presenter.UpdateAsync(DepartmentId, _name, _description);
    }
}
