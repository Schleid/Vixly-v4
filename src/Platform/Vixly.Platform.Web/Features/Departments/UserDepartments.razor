@*
=========================================================
FILE: UserDepartments.razor

PURPOSE:
The departments a staff user belongs to, with add, remove
and make primary for an administrator who may manage members.

IMPORTANT NOTES:
- Feature component (ADR-0001): behaviour lives in the
  presenter; this file holds markup and UI glue only
- Text comes from PlatformText (UI-10); placeholder look until
  the Frontend/UI team designs it
- No step-up: departments are labels and grant nothing (D-S3)
- Reports a change through PlatformUserWorkspace (UI-3)
=========================================================
*@
@inherits PlatformPresenterComponent<UserDepartmentsPresenter>
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors
@inject PlatformUserWorkspace Workspace

<VxCard Title="@T["ui.users.departments"]">
    @if (Presenter.State.DoneKey is { } done)
    {
        <VxMessage Type="VxMessageType.Info">@T[done]</VxMessage>
    }
    @if (Presenter.State.Error is not null)
    {
        <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
    }
    @if (!Presenter.State.Loaded)
    {
        <p role="status">@T["ui.common.loading"]</p>
    }
    else if (Presenter.State.Memberships.Count == 0)
    {
        <p>@T["ui.users.no_departments"]</p>
    }
    else
    {
        <ul class="vx-list">
            @foreach (var membership in Presenter.State.Memberships)
            {
                <li>
                    <a href="/departments/@membership.PlatformDepartmentId">@membership.Name</a>
                    @if (membership.IsPrimary)
                    {
                        <VxStatusBadge Status="VxBadgeStatus.Active" Text="@T["ui.departments.primary"]" />
                    }
                    @if (!membership.DepartmentIsActive)
                    {
                        <VxStatusBadge Status="VxBadgeStatus.Suspended" Text="@T["ui.roles.inactive"]" />
                    }
                    @if (Presenter.State.CanManage)
                    {
                        @if (!membership.IsPrimary)
                        {
                            <VxButton IsBusy="@Presenter.IsBusy" OnClick="() => ChangedAsync(Presenter.MakePrimaryAsync(UserId, membership.PlatformDepartmentId))">@T["ui.departments.make_primary"]</VxButton>
                        }
                        <VxButton IsBusy="@Presenter.IsBusy" OnClick="() => ChangedAsync(Presenter.RemoveAsync(UserId, membership.PlatformDepartmentId))">@T["ui.user_roles.revoke"]</VxButton>
                    }
                </li>
            }
        </ul>
    }
    @if (Presenter.State.CanManage && Presenter.State.Joinable.Count > 0)
    {
        <form class="vx-form" @onsubmit="AddAsync">
            <label for="join-department">@T["ui.departments.add_to"]</label>
            <select id="join-department" @bind="_departmentId" required>
                <option value="">@T["ui.departments.choose"]</option>
                @foreach (var department in Presenter.State.Joinable)
                {
                    <option value="@department.PlatformDepartmentId">@department.Name</option>
                }
            </select>
            <div class="vx-actions">
                <VxButton Variant="VxButtonVariant.Primary" Type="submit" Disabled="@(Presenter.IsBusy || _departmentId is null)">@T["ui.departments.add"]</VxButton>
            </div>
        </form>
    }
</VxCard>

@code {
    private Guid? _departmentId;

    [Parameter, EditorRequired]
    public Guid UserId { get; set; }

    protected override Task OnParametersSetAsync()
    {
        return Presenter.LoadAsync(UserId);
    }

    private async Task AddAsync()
    {
        if (_departmentId is Guid departmentId)
        {
            await ChangedAsync(Presenter.AddAsync(UserId, departmentId));
            _departmentId = null;
        }
    }

    private async Task ChangedAsync(Task<bool> change)
    {
        if (await change)
        {
            Workspace.NotifyUserChanged(UserId);
        }
    }
}
