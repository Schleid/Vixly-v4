@*
=========================================================
FILE: DepartmentMembers.razor

PURPOSE:
The people in one department, with remove for an
administrator who may manage members.

IMPORTANT NOTES:
- Feature component (ADR-0001): behaviour lives in the
  presenter; this file holds markup and UI glue only
- Text comes from PlatformText (UI-10); placeholder look until
  the Frontend/UI team designs it
- No step-up: departments are labels and grant nothing (D-S3)
- People are added from their user page
=========================================================
*@
@inherits PlatformPresenterComponent<DepartmentMembersPresenter>
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors

<VxCard Title="@T["ui.departments.members"]">
    @if (Presenter.State.Removed)
    {
        <VxMessage Type="VxMessageType.Info">@T["ui.departments.member_removed"]</VxMessage>
    }
    @if (Presenter.State.Error is not null)
    {
        <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
    }
    <VxDataTable Items="Presenter.State.Members" IsLoading="@(!Presenter.State.Loaded)">
        <HeaderContent>
            <th scope="col">@T["ui.users.name"]</th>
            <th scope="col">@T["ui.signin.email"]</th>
            <th scope="col">@T["ui.departments.primary"]</th>
            @if (Presenter.State.CanManage)
            {
                <th scope="col"><span class="vx-visually-hidden">@T["ui.departments.actions"]</span></th>
            }
        </HeaderContent>
        <RowTemplate Context="member">
            <td><a href="/users/@member.PlatformUserId">@member.LastName, @member.FirstName</a></td>
            <td>@member.Email</td>
            <td>@T[member.IsPrimary ? "ui.common.yes" : "ui.common.no"]</td>
            @if (Presenter.State.CanManage)
            {
                <td><VxButton IsBusy="@Presenter.IsBusy" OnClick="() => Presenter.RemoveAsync(DepartmentId, member.PlatformUserId)">@T["ui.user_roles.revoke"]</VxButton></td>
            }
        </RowTemplate>
        <EmptyContent>
            <VxEmptyState Title="@T["ui.departments.no_members"]" />
        </EmptyContent>
    </VxDataTable>
    <p>@T["ui.departments.add_from_user"]</p>
</VxCard>

@code {
    [Parameter, EditorRequired]
    public Guid DepartmentId { get; set; }

    protected override Task OnParametersSetAsync()
    {
        return Presenter.LoadAsync(DepartmentId);
    }
}
