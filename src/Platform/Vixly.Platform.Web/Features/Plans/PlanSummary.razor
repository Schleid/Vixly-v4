@*
=========================================================
FILE: PlanSummary.razor

PURPOSE:
One plan: overview, catalogue settings, retire or reactivate,
then the draft, the versions and the translations.

IMPORTANT NOTES:
- Feature component (ADR-0001): behaviour lives in the
  presenter; this file holds markup and UI glue only
- Text comes from PlatformText (UI-10); placeholder look until
  the Frontend/UI team designs it
- Retiring a plan hides it from new subscribers; existing
  subscriptions keep it (D-S2)
=========================================================
*@
@inherits PlatformPresenterComponent<PlanPresenter>
@using Vixly.Platform.Domain.Subscriptions
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors

@if (Presenter.State.Plan is { } plan)
{
    <PageTitle>@plan.Name</PageTitle>
    <h1>
        @plan.Name
        <VxStatusBadge Status="@SubscriptionDisplay.PlanBadge(plan.Status)" Text="@T[SubscriptionDisplay.PlanStatusKey(plan.Status)]" />
    </h1>
    @if (Presenter.State.DoneKey is { } done)
    {
        <VxMessage Type="VxMessageType.Success">@T[done]</VxMessage>
    }
    @if (Presenter.State.Error is not null)
    {
        <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
    }
    <div id="plan-overview"><VxCard Title="@T["ui.plans.overview"]">
        <dl class="vx-facts">
            <dt>@T["ui.plans.code"]</dt><dd>@plan.Code</dd>
            <dt>@T["ui.plans.version"]</dt><dd>@(plan.Current is { } current ? VixlyText.Format(T, "ui.plans.version_number", "number", current.Number) : T["ui.plans.not_published"].Value)</dd>
            <dt>@T["ui.plans.currency"]</dt><dd>@(plan.Current?.CurrencyCode ?? plan.Draft?.CurrencyCode)</dd>
            <dt>@T["ui.plans.subscribers"]</dt><dd><a href="/subscriptions?plan=@plan.PlatformPlanId">@plan.Subscribers</a></dd>
            <dt>@T["ui.roles.created"]</dt><dd>@PlatformDisplay.Utc(T, plan.CreatedUtc)</dd>
        </dl>
        @if (Presenter.State.Abilities.CanManage)
        {
            <form class="vx-form" @onsubmit="SaveCatalogueAsync">
                <label><input type="checkbox" @bind="_isPublic" /> @T["ui.plans.public_help"]</label>
                <label for="plan-display-order">@T["ui.plans.display_order"]</label>
                <input id="plan-display-order" type="number" min="0" max="1000" @bind="_displayOrder" />
                <div class="vx-actions">
                    <VxButton Type="submit" IsBusy="@Presenter.IsBusy">@T["ui.plans.save_catalogue"]</VxButton>
                    @if (plan.Status == PlatformPlanStatus.Active)
                    {
                        <VxButton Variant="VxButtonVariant.Danger" OnClick="() => Presenter.RetireAsync(PlanId)">@T["ui.plans.retire"]</VxButton>
                    }
                    else
                    {
                        <VxButton OnClick="() => Presenter.ReactivateAsync(PlanId)">@T["ui.plans.reactivate"]</VxButton>
                    }
                </div>
            </form>
        }
        else
        {
            <p>@(plan.IsPublic ? T["ui.plans.is_public"] : T["ui.plans.is_private"])</p>
        }
    </VxCard></div>
    <PlanApproval Plan="plan" CanDecide="Presenter.State.Abilities.CanDecide" OnChanged="ReloadAsync" />
    <PlanDraftEditor Plan="plan" Abilities="Presenter.State.Abilities" Version="Presenter.State.Version" OnChanged="ReloadAsync" />
    <PlanVersions Versions="plan.Versions" />
    <PlanTranslations Translations="plan.Translations" CanEdit="Presenter.State.Abilities.CanManage" IsBusy="Presenter.IsBusy" OnSave="SaveTranslationAsync" />
}
else if (Presenter.State.Error is not null)
{
    <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
}
else
{
    <p role="status">@T["ui.common.loading"]</p>
}

@code {
    private bool _isPublic;

    private int _displayOrder;

    [Parameter, EditorRequired]
    public Guid PlanId { get; set; }

    protected override Task OnParametersSetAsync()
    {
        return ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        await Presenter.LoadAsync(PlanId);

        if (Presenter.State.Plan is { } plan)
        {
            _isPublic = plan.IsPublic;
            _displayOrder = plan.DisplayOrder;
        }
    }

    private Task SaveCatalogueAsync()
    {
        return Presenter.SaveCatalogueAsync(PlanId, _isPublic, _displayOrder);
    }

    private Task SaveTranslationAsync(string language, string? name, string? description)
    {
        return Presenter.SaveTranslationAsync(PlanId, language, name, description);
    }
}
