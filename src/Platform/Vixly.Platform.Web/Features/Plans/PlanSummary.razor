@*
=========================================================
FILE: PlanSummary.razor

PURPOSE:
One plan: summary strip, tabs for draft, versions,
translations, catalogue settings, and approval.

IMPORTANT NOTES:
- Feature component (ADR-0001): behaviour lives in the
  presenter; this file holds markup and UI glue only
- Text comes from PlatformText (UI-10)
- Brief §5 record page anatomy: summary strip and tabs
=========================================================
*@
@inherits PlatformPresenterComponent<PlanPresenter>
@using Vixly.Platform.Domain.Subscriptions
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors

@if (Presenter.State.Plan is { } plan)
{
    <PageTitle>@plan.Name · @T["ui.plans.title"]</PageTitle>

    <div class="vx-summary-strip">
        <div class="vx-summary-strip__main">
            <h1 class="vx-summary-strip__title">
                @plan.Name
                <VxStatusBadge Status="@SubscriptionDisplay.PlanBadge(plan.Status)" Text="@T[SubscriptionDisplay.PlanStatusKey(plan.Status)]" />
            </h1>
            <div class="vx-summary-strip__facts">
                <span class="vx-summary-strip__fact">
                    <span class="vx-summary-strip__fact-label">@T["ui.plans.code"]:</span>
                    <span class="vx-summary-strip__fact-value">@plan.Code</span>
                </span>
                <span class="vx-summary-strip__fact">
                    <span class="vx-summary-strip__fact-label">@T["ui.plans.version"]:</span>
                    <span class="vx-summary-strip__fact-value">@(plan.Current is { } current ? VixlyText.Format(T, "ui.plans.version_number", "number", current.Number) : T["ui.plans.not_published"].Value)</span>
                </span>
                <span class="vx-summary-strip__fact">
                    <span class="vx-summary-strip__fact-label">@T["ui.plans.currency"]:</span>
                    <span class="vx-summary-strip__fact-value">@(plan.Current?.CurrencyCode ?? plan.Draft?.CurrencyCode)</span>
                </span>
                <span class="vx-summary-strip__fact">
                    <span class="vx-summary-strip__fact-label">@T["ui.plans.subscribers"]:</span>
                    <a href="/subscriptions?plan=@plan.PlatformPlanId" class="vx-summary-strip__fact-value">@plan.Subscribers</a>
                </span>
                <span class="vx-summary-strip__fact">
                    <span class="vx-summary-strip__fact-label">@T["ui.roles.created"]:</span>
                    <span class="vx-summary-strip__fact-value">@PlatformDisplay.Utc(T, plan.CreatedUtc)</span>
                </span>
            </div>
        </div>
    </div>

    @if (Presenter.State.DoneKey is { } done)
    {
        <VxMessage Type="VxMessageType.Success">@T[done]</VxMessage>
    }
    @if (Presenter.State.Error is not null)
    {
        <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
    }

    <nav class="vx-tabs" aria-label="@T["ui.plans.title"]">
        <button type="button" class="vx-tab-btn @(_activeTab == "draft" ? "active" : null)" @onclick='() => _activeTab = "draft"'>
            @T["ui.plans.draft"]
            @if (plan.Draft is not null)
            {
                <span class="vx-tab-badge">v@(plan.Draft.Number)</span>
            }
        </button>
        <button type="button" class="vx-tab-btn @(_activeTab == "versions" ? "active" : null)" @onclick='() => _activeTab = "versions"'>
            @T["ui.plans.versions"]
            <span class="vx-tab-badge">@plan.Versions.Count</span>
        </button>
        <button type="button" class="vx-tab-btn @(_activeTab == "translations" ? "active" : null)" @onclick='() => _activeTab = "translations"'>
            @T["ui.plans.translations"]
        </button>
        <button type="button" class="vx-tab-btn @(_activeTab == "catalogue" ? "active" : null)" @onclick='() => _activeTab = "catalogue"'>
            @T["ui.plans.overview"]
        </button>
        @if (Presenter.State.Abilities.CanDecide || plan.Draft?.SubmittedUtc is not null)
        {
            <button type="button" class="vx-tab-btn @(_activeTab == "approval" ? "active" : null)" @onclick='() => _activeTab = "approval"'>
                @T["ui.plans.approval"]
            </button>
        }
    </nav>

    @if (_activeTab == "draft")
    {
        <PlanDraftEditor Plan="plan" Abilities="Presenter.State.Abilities" Version="Presenter.State.Version" OnChanged="ReloadAsync" />
    }
    else if (_activeTab == "versions")
    {
        <PlanVersions Versions="plan.Versions" />
    }
    else if (_activeTab == "translations")
    {
        <PlanTranslations Translations="plan.Translations" CanEdit="Presenter.State.Abilities.CanManage" IsBusy="Presenter.IsBusy" OnSave="SaveTranslationAsync" />
    }
    else if (_activeTab == "catalogue")
    {
        <div id="plan-overview"><VxCard Title="@T["ui.plans.overview"]">
            @if (Presenter.State.Abilities.CanManage)
            {
                <form class="vx-form" @onsubmit="SaveCatalogueAsync">
                    <label><input type="checkbox" @bind="_isPublic" /> @T["ui.plans.public_help"]</label>
                    <label for="plan-display-order">@T["ui.plans.display_order"]</label>
                    <input id="plan-display-order" type="number" min="0" max="1000" @bind="_displayOrder" />
                    <div class="vx-actions">
                        <VxButton Type="submit" IsBusy="@Presenter.IsBusy">@T["ui.plans.save_catalogue"]</VxButton>
                        @if (plan.Status == PlatformPlanStatus.Active)
                        {
                            <VxButton Variant="VxButtonVariant.Danger" OnClick="() => Presenter.RetireAsync(PlanId)">@T["ui.plans.retire"]</VxButton>
                        }
                        else
                        {
                            <VxButton OnClick="() => Presenter.ReactivateAsync(PlanId)">@T["ui.plans.reactivate"]</VxButton>
                        }
                    </div>
                </form>
            }
            else
            {
                <p>@(plan.IsPublic ? T["ui.plans.is_public"] : T["ui.plans.is_private"])</p>
            }
        </VxCard></div>
    }
    else if (_activeTab == "approval")
    {
        <PlanApproval Plan="plan" CanDecide="Presenter.State.Abilities.CanDecide" OnChanged="ReloadAsync" />
    }
}
else if (Presenter.State.Error is not null)
{
    <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
}
else
{
    <p role="status">@T["ui.common.loading"]</p>
}

@code {
    private string _activeTab = "draft";

    private bool _isPublic;

    private int _displayOrder;

    [Parameter, EditorRequired]
    public Guid PlanId { get; set; }

    protected override Task OnParametersSetAsync()
    {
        return ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        await Presenter.LoadAsync(PlanId);

        if (Presenter.State.Plan is { } plan)
        {
            _isPublic = plan.IsPublic;
            _displayOrder = plan.DisplayOrder;
        }
    }

    private Task SaveCatalogueAsync()
    {
        return Presenter.SaveCatalogueAsync(PlanId, _isPublic, _displayOrder);
    }

    private Task SaveTranslationAsync(string language, string? name, string? description)
    {
        return Presenter.SaveTranslationAsync(PlanId, language, name, description);
    }
}