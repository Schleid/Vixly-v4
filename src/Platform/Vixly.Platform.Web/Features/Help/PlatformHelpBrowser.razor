@inherits PlatformPresenterComponent<PlatformHelpPresenter>
@using System.Globalization
@using Vixly.Shared.UI.Primitives
@inject IStringLocalizer<PlatformText> T
@inject NavigationManager Navigation
@* =========================================================
   FILE: PlatformHelpBrowser.razor

   PURPOSE:
   Presents Control help, with permission-filtered search.

   RESPONSIBILITIES:
   - Bind the reader's visible content to accessible markup.

   IMPORTANT NOTES:
   - Hidden and unknown slugs share a normal not-found response.
   - Only validated catalogue HTML reaches the article primitive.
   ========================================================= *@
<PageTitle>@(Presenter.State.Article?.Metadata.Title ?? T["ui.help.title"].Value)</PageTitle>
@if (Presenter.State.NotFound)
{
    <h1>@T["ui.help.not_found"]</h1>
    <p><a href="/help">@T["ui.help.back"]</a></p>
}
else
{
    <section class="control-help">
        @if (Presenter.State.Article is { } article)
        {
            <p><a href="/help">@T["ui.help.back"]</a></p>
            <VxHelpArticle Title="@article.Metadata.Title" Html="@article.Html" RelatedLabel="@T["ui.help.related"]"
                Related="@Presenter.State.Related.Select(item => new VxHelpRelatedLink(item.Metadata.Title, PlatformHelpCatalogue.Address(item.Language, item.Metadata.Slug))).ToArray()" />
        }
        else
        {
            <h1>@T["ui.help.title"]</h1>
            <p>@T["ui.help.summary"]</p>
            <form method="get" action="/help" role="search" data-enhance="false" class="control-help__search">
                <label for="help-query">@T["ui.help.search"]</label>
                <input id="help-query" class="vx-input" type="search" name="q" maxlength="160" value="@Presenter.State.Query" />
                <VxButton Type="submit">@T["ui.help.search_go"]</VxButton>
            </form>
            @if (Presenter.State.Query.Length > 0)
            {
                <h2>@T["ui.help.results"]</h2>
                <PlatformHelpList Articles="Presenter.State.Articles" />
                <p><a href="/help">@T["ui.help.clear"]</a></p>
            }
            else
            {
                @foreach (string section in PlatformHelpCatalogue.Sections)
                {
                    var items = Presenter.State.Articles.Where(item => item.Metadata.Section == section).ToArray();
                    @if (items.Length > 0)
                    {
                        <section>
                            <h2>@T["ui.help.section." + section]</h2>
                            <PlatformHelpList Articles="items" />
                        </section>
                    }
                }
            }
        }
    </section>
}

@code {
    [Parameter] public string? Slug { get; set; }
    [Parameter] public string? Query { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await Presenter.LoadAsync(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, Slug, Query);
        if (Presenter.State.NotFound) Navigation.NotFound();
    }
}
