@inherits PlatformPresenterComponent<TenantListPresenter>
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors
@* =========================================================
   FILE: TenantOverview.razor

   PURPOSE:
   A live metric and first-page preview for the Control overview.

   RESPONSIBILITIES:
   Present existing authorized Control data and navigation.

   IMPORTANT NOTES:
   Uses existing presenters; no business rules or sample values.
   ========================================================= *@
<div class="vx-control-module">
    <a class="vx-control-metric-link" href="/tenants">
        <VxMetricCard Label="@T["ui.tenants.title"]" Value="@(Presenter.State.Loaded && Presenter.State.Error is null ? Presenter.State.TotalCount.ToString("N0") : "—")" Detail="@T["ui.control.tenants_context"]" />
    </a>
    <section class="vx-control-panel" aria-busy="@(!Presenter.State.Loaded ? "true" : "false")">
        <header class="vx-control-panel__header"><h2>@T["ui.tenants.title"]</h2><a href="/tenants">@T["ui.control.view_all"] →</a></header>
        @if (Presenter.State.Error is not null)
        {
            <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
        }
        else
        {
            <VxDataTable Items="Presenter.State.Tenants.Take(5).ToArray()" IsLoading="@(!Presenter.State.Loaded)" Caption="@T["ui.control.tenants_context"]">
                <HeaderContent><th scope="col">@T["ui.tenants.name"]</th><th scope="col">@T["ui.tenants.code"]</th><th scope="col">@T["ui.tenants.status"]</th></HeaderContent>
                <RowTemplate Context="tenant"><td><a href="/tenants/@tenant.PlatformTenantId">@tenant.DisplayName</a></td><td class="vx-table__number">@tenant.TenantCode</td><td><VxStatusBadge Status="@PlatformDisplay.TenantBadge(tenant.Status)" Text="@T[PlatformDisplay.TenantStatusKey(tenant.Status)]" /></td></RowTemplate>
                <EmptyContent><VxEmptyState Title="@T["ui.tenants.empty"]" /></EmptyContent>
            </VxDataTable>
        }
    </section>
</div>
@code {
    protected override Task OnParametersSetAsync() => Presenter.LoadAsync(null, null, null, 1);
}
