@inherits PlatformPresenterComponent<ApprovalListPresenter>
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors
@* =========================================================
   FILE: ApprovalOverview.razor

   PURPOSE:
   A live metric and first-page preview for the Control overview.

   RESPONSIBILITIES:
   Present existing authorized Control data and navigation.

   IMPORTANT NOTES:
   Uses existing presenters; no business rules or sample values.
   ========================================================= *@
<div class="vx-control-module">
    <a class="vx-control-metric-link" href="/approvals">
        <VxMetricCard Label="@T["ui.approvals.title"]" Value="@(Presenter.State.Loaded && Presenter.State.Error is null ? Presenter.State.Items.Count.ToString("N0") : "—")" Detail="@T["ui.control.approvals_context"]" />
    </a>
    <section class="vx-control-panel" aria-busy="@(!Presenter.State.Loaded ? "true" : "false")">
        <header class="vx-control-panel__header"><h2>@T["ui.approvals.title"]</h2><a href="/approvals">@T["ui.control.view_all"] →</a></header>
        @if (Presenter.State.Error is not null)
        {
            <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
        }
        else
        {
            <VxDataTable Items="Presenter.State.Items.Take(5).ToArray()" IsLoading="@(!Presenter.State.Loaded)" Caption="@T["ui.control.approvals_context"]">
                <HeaderContent><th scope="col">@T["ui.approvals.item"]</th><th scope="col">@T["ui.approvals.kind"]</th><th scope="col">@T["ui.approvals.requested_by"]</th></HeaderContent>
                <RowTemplate Context="item"><td><a href="@SalesDisplay.ApprovalLink(item)">@item.Title</a></td><td>@T[SalesDisplay.ApprovalKindKey(item.Kind)]</td><td>@item.RequestedByName</td></RowTemplate>
                <EmptyContent><VxEmptyState Title="@T["ui.approvals.empty"]" /></EmptyContent>
            </VxDataTable>
        }
    </section>
</div>
@code {
    protected override Task OnParametersSetAsync() => Presenter.LoadAsync();
}
