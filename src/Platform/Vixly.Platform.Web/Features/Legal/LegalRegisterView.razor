@*
=========================================================
FILE: LegalRegisterView.razor

PURPOSE:
The acceptance register: tenants that must accept the current
Terms, with status, deadline, acceptance and last reminder
(D-Lg12).

IMPORTANT NOTES:
- Feature component (ADR-0001): behaviour lives in the
  presenter; this file holds markup and UI glue only
- Text comes from PlatformText (UI-10); placeholder look until
  the Frontend/UI team designs it
- Overdue tenants are read-only for their staff until the owner
  accepts; their customers are not affected
=========================================================
*@
@inherits PlatformPresenterComponent<LegalRegisterPresenter>
@using Vixly.Platform.Domain.Legal
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors
@inject NavigationManager Navigation

@if (Presenter.State.Error is not null)
{
    <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
}
@if (Presenter.State.Loaded && Presenter.State.Required is null)
{
    <p class="vx-hint">@T["ui.legal.nothing_required"]</p>
}
else if (Presenter.State.Required is { } required)
{
    <p>@VixlyText.Format(T, "ui.legal.register_for", new Dictionary<string, object> { ["version"] = required.Version, ["deadline"] = LegalDisplay.Date(required.DeadlineUtc) })</p>
    <p class="vx-hint">@T["ui.legal.read_only_help"]</p>
}
<form class="vx-toolbar" role="search" @onsubmit="Apply">
    <label for="register-search">@T["ui.legal.search"]</label>
    <input id="register-search" @bind="_search" maxlength="100" />
    <label for="register-status">@T["ui.legal.status"]</label>
    <select id="register-status" @bind="_status">
        <option value="">@T["ui.legal.status.all"]</option>
        @foreach (PlatformLegalStatus status in new[] { PlatformLegalStatus.Due, PlatformLegalStatus.Overdue, PlatformLegalStatus.Accepted })
        {
            <option value="@status">@T[LegalDisplay.StatusKey(status)]</option>
        }
    </select>
    <VxButton Type="submit">@T["ui.users.apply"]</VxButton>
</form>
<p class="vx-hint">@(Presenter.State.Loaded ? VixlyText.Format(T, "ui.legal.count", "count", Presenter.State.TotalCount) : T["ui.common.loading"].Value)</p>
<div id="legal-register">
    <VxDataTable Items="Presenter.State.Items" IsLoading="!Presenter.State.Loaded">
        <HeaderContent>
            <th scope="col">@T["ui.legal.tenant"]</th>
            <th scope="col">@T["ui.legal.status"]</th>
            <th scope="col">@T["ui.legal.deadline"]</th>
            <th scope="col">@T["ui.legal.accepted"]</th>
            <th scope="col">@T["ui.legal.last_reminder"]</th>
        </HeaderContent>
        <RowTemplate Context="row">
            <td><a href="/tenants/@row.PlatformTenantId#tenant-legal">@row.TenantName</a> <span class="vx-hint">@row.TenantCode</span></td>
            <td><VxStatusBadge Status="@LegalDisplay.Badge(row.Status)" Text="@T[LegalDisplay.StatusKey(row.Status)]" /></td>
            <td>@LegalDisplay.Date(row.DeadlineUtc)</td>
            <td>@(row.AcceptedUtc is { } accepted ? PlatformDisplay.Utc(T, accepted) + " · " + row.AcceptedVersion : "-")</td>
            <td>@(row.LastReminderUtc is { } reminded ? PlatformDisplay.Utc(T, reminded) : "-")</td>
        </RowTemplate>
    </VxDataTable>
</div>
@if (Presenter.State.Loaded && Presenter.State.TotalPages > 1)
{
    <VxPager CurrentPage="Presenter.State.Page" TotalPages="Presenter.State.TotalPages" PageChanged="page => Navigation.NavigateTo(Url(page))" />
}

@code {
    private string _status = string.Empty;

    private string? _search;

    [Parameter]
    public string? Status { get; set; }

    [Parameter]
    public string? Search { get; set; }

    [Parameter]
    public int? Page { get; set; }

    protected override Task OnParametersSetAsync()
    {
        PlatformLegalStatus? status = Enum.TryParse(Status, true, out PlatformLegalStatus parsed) ? parsed : null;
        _status = status?.ToString() ?? string.Empty;
        _search = Search;
        return Presenter.LoadAsync(status, Search, Page ?? 1);
    }

    private void Apply()
    {
        Navigation.NavigateTo(Url(1));
    }

    private string Url(int page)
    {
        Dictionary<string, string?> query = new()
        {
            ["status"] = string.IsNullOrEmpty(_status) ? null : _status,
            ["search"] = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
            ["page"] = page > 1 ? page.ToString(System.Globalization.CultureInfo.InvariantCulture) : null
        };

        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/legal/register", query.Where(pair => pair.Value is not null));
    }
}
