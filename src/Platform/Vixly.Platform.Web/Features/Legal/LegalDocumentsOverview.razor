@*
=========================================================
FILE: LegalDocumentsOverview.razor

PURPOSE:
Vixly's legal documents: every version by kind with its status,
and a form to start a new draft (Slice 8).

IMPORTANT NOTES:
- Feature component (ADR-0001): behaviour lives in the
  presenter; this file holds markup and UI glue only
- Text comes from PlatformText (UI-10); placeholder look until
  the Frontend/UI team designs it
=========================================================
*@
@inherits PlatformPresenterComponent<LegalDocumentsPresenter>
@using Vixly.Platform.Domain.Legal
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors
@inject NavigationManager Navigation

@if (Presenter.State.Error is not null)
{
    <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
}
@if (Presenter.State.Abilities.CanManage)
{
    <div id="legal-new"><VxCard Title="@T["ui.legal.new_draft"]">
        <form class="vx-form" @onsubmit="CreateAsync">
            <label for="legal-new-kind">@T["ui.legal.kind"]</label>
            <select id="legal-new-kind" @bind="_newKind">
                @foreach (PlatformLegalDocumentKind kind in Enum.GetValues<PlatformLegalDocumentKind>())
                {
                    <option value="@kind">@T[LegalDisplay.KindKey(kind)]</option>
                }
            </select>
            <label for="legal-new-version">@T["ui.legal.version"]</label>
            <input id="legal-new-version" @bind="_newVersion" maxlength="@PlatformLegalLimits.VersionMaxLength" required placeholder="2026-11" aria-describedby="legal-new-help" />
            <p id="legal-new-help" class="vx-hint">@T["ui.legal.new_draft_help"]</p>
            <div class="vx-actions">
                <VxButton Variant="VxButtonVariant.Primary" Type="submit" IsBusy="@Presenter.IsBusy">@T["ui.legal.create_draft"]</VxButton>
            </div>
        </form>
    </VxCard></div>
}
<form class="vx-toolbar" @onsubmit="Apply">
    <label for="legal-kind">@T["ui.legal.kind"]</label>
    <select id="legal-kind" @bind="_kind">
        <option value="">@T["ui.legal.kind.all"]</option>
        @foreach (PlatformLegalDocumentKind kind in Enum.GetValues<PlatformLegalDocumentKind>())
        {
            <option value="@kind">@T[LegalDisplay.KindKey(kind)]</option>
        }
    </select>
    <VxButton Type="submit">@T["ui.users.apply"]</VxButton>
</form>
<div id="legal-documents">
    <VxDataTable Items="Presenter.State.Items" IsLoading="!Presenter.State.Loaded">
        <HeaderContent>
            <th scope="col">@T["ui.legal.kind"]</th>
            <th scope="col">@T["ui.legal.version"]</th>
            <th scope="col">@T["ui.legal.document_status"]</th>
            <th scope="col">@T["ui.legal.effective"]</th>
            <th scope="col">@T["ui.legal.published"]</th>
        </HeaderContent>
        <RowTemplate Context="document">
            <td>@T[LegalDisplay.KindKey(document.Kind)]</td>
            <td><a href="/legal/@document.DocumentId">@document.Version</a></td>
            <td>
                <VxStatusBadge Status="@LegalDisplay.DocumentBadge(document.Status)" Text="@T[LegalDisplay.DocumentStatusKey(document.Status)]" />
                @if (document.Kind == PlatformLegalDocumentKind.Terms && document.Status != PlatformLegalDocumentStatus.Draft)
                {
                    <span class="vx-hint"> · @T[document.AcceptanceRequired ? "ui.legal.acceptance_required" : "ui.legal.notice_only"]</span>
                }
            </td>
            <td>@LegalDisplay.Date(document.EffectiveUtc)</td>
            <td>@(document.PublishedUtc is { } published ? PlatformDisplay.Utc(T, published) + " · " + document.PublishedByName : "-")</td>
        </RowTemplate>
    </VxDataTable>
</div>
@if (Presenter.State.Loaded && Presenter.State.TotalPages > 1)
{
    <VxPager CurrentPage="Presenter.State.Page" TotalPages="Presenter.State.TotalPages" PageChanged="page => Navigation.NavigateTo(Url(page))" />
}

@code {
    private string _kind = string.Empty;

    private PlatformLegalDocumentKind _newKind = PlatformLegalDocumentKind.Terms;

    private string? _newVersion;

    [Parameter]
    public string? Kind { get; set; }

    [Parameter]
    public int? Page { get; set; }

    protected override Task OnParametersSetAsync()
    {
        PlatformLegalDocumentKind? kind = Enum.TryParse(Kind, true, out PlatformLegalDocumentKind parsed) ? parsed : null;
        _kind = kind?.ToString() ?? string.Empty;
        return Presenter.LoadAsync(kind, Page ?? 1);
    }

    private void Apply()
    {
        Navigation.NavigateTo(Url(1));
    }

    private async Task CreateAsync()
    {
        await Presenter.CreateAsync(_newKind, _newVersion);

        if (Presenter.State.CreatedId is Guid id)
        {
            Navigation.NavigateTo("/legal/" + id);
        }
    }

    private string Url(int page)
    {
        Dictionary<string, string?> query = new()
        {
            ["kind"] = string.IsNullOrEmpty(_kind) ? null : _kind,
            ["page"] = page > 1 ? page.ToString(System.Globalization.CultureInfo.InvariantCulture) : null
        };

        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/legal", query.Where(pair => pair.Value is not null));
    }
}
