@*
=========================================================
FILE: OfferCreateForm.razor

PURPOSE:
Prepare an offer link for a valued customer; it is saved as a
draft, then submitted from its page (D-S21).

IMPORTANT NOTES:
- Feature component (ADR-0001): behaviour lives in the
  presenter; this file holds markup and UI glue only
- Text comes from PlatformText (UI-10); placeholder look until
  the Frontend/UI team designs it
- The link itself exists only once the offer is issued
=========================================================
*@
@inherits PlatformPresenterComponent<OfferPresenter>
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors
@inject NavigationManager Navigation

<form class="vx-form" @onsubmit="PrepareAsync">
    @if (Presenter.State.Error is not null)
    {
        <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
    }
    <p class="vx-hint">@T["ui.offers.create_help"]</p>
    <OfferFields Model="_model" Plans="Presenter.State.Plans" />
    <div class="vx-actions">
        <VxButton Variant="VxButtonVariant.Primary" Type="submit" IsBusy="@Presenter.IsBusy">@T["ui.offers.prepare"]</VxButton>
        <a class="vx-button" href="/offers">@T["ui.common.cancel"]</a>
    </div>
</form>

@code {
    private readonly OfferFormModel _model = new();

    protected override Task OnParametersSetAsync()
    {
        return Presenter.LoadAsync(null);
    }

    private async Task PrepareAsync()
    {
        if (await Presenter.PrepareAsync(_model) is Guid id)
        {
            Navigation.NavigateTo("/offers/" + id);
        }
    }
}
