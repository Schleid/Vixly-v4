@*
=========================================================
FILE: LeadsOverview.razor

PURPOSE:
Contact requests from the public site, new ones first by
default, for sales staff to follow up.

IMPORTANT NOTES:
- Feature component (ADR-0001): behaviour lives in the
  presenter; this file holds markup and UI glue only
- Text comes from PlatformText (UI-10); placeholder look until
  the Frontend/UI team designs it
- Filters live in the URL so a view can be bookmarked
=========================================================
*@
@inherits PlatformPresenterComponent<LeadsPresenter>
@using Vixly.Platform.Domain.Sales
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors
@inject NavigationManager Navigation

@if (Presenter.State.Error is not null)
{
    <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
}
<form class="vx-toolbar" role="search" @onsubmit="Apply">
    <label for="leads-search">@T["ui.leads.search"]</label>
    <input id="leads-search" @bind="_search" maxlength="100" />
    <label for="leads-status">@T["ui.leads.status"]</label>
    <select id="leads-status" @bind="_status">
        <option value="All">@T["ui.leads.status.all"]</option>
        @foreach (PlatformSalesLeadStatus status in Enum.GetValues<PlatformSalesLeadStatus>())
        {
            <option value="@status">@T[LeadDisplay.StatusKey(status)]</option>
        }
    </select>
    <VxButton Type="submit">@T["ui.users.apply"]</VxButton>
</form>
<p class="vx-hint">@(Presenter.State.Loaded ? VixlyText.Format(T, "ui.leads.count", "count", Presenter.State.TotalCount) : T["ui.common.loading"].Value)</p>
<div id="leads-list">
    <VxDataTable Items="Presenter.State.Items" IsLoading="!Presenter.State.Loaded">
        <HeaderContent>
            <th scope="col">@T["ui.leads.received"]</th>
            <th scope="col">@T["ui.leads.company"]</th>
            <th scope="col">@T["ui.leads.contact"]</th>
            <th scope="col">@T["ui.leads.kind"]</th>
            <th scope="col">@T["ui.leads.language"]</th>
            <th scope="col">@T["ui.leads.status"]</th>
        </HeaderContent>
        <RowTemplate Context="lead">
            <td><a href="/leads/@lead.LeadId">@PlatformDisplay.Utc(T, lead.ReceivedUtc)</a></td>
            <td>@lead.CompanyName</td>
            <td>@lead.ContactName <span class="vx-hint">@lead.Email</span></td>
            <td>@T[LeadDisplay.KindKey(lead.Kind)]</td>
            <td>@lead.Language</td>
            <td><VxStatusBadge Status="@LeadDisplay.Badge(lead.Status)" Text="@T[LeadDisplay.StatusKey(lead.Status)]" /></td>
        </RowTemplate>
    </VxDataTable>
</div>
@if (Presenter.State.Loaded && Presenter.State.TotalPages > 1)
{
    <VxPager CurrentPage="Presenter.State.Page" TotalPages="Presenter.State.TotalPages" PageChanged="page => Navigation.NavigateTo(Url(page))" />
}

@code {
    private string _status = nameof(PlatformSalesLeadStatus.New);

    private string? _search;

    [Parameter]
    public string? Status { get; set; }

    [Parameter]
    public string? Search { get; set; }

    [Parameter]
    public int? Page { get; set; }

    // New leads by default; "All" shows every lead.
    protected override Task OnParametersSetAsync()
    {
        PlatformSalesLeadStatus? status = Status is null ? PlatformSalesLeadStatus.New : Enum.TryParse(Status, true, out PlatformSalesLeadStatus parsed) ? parsed : null;
        _status = status?.ToString() ?? "All";
        _search = Search;
        return Presenter.LoadAsync(status, Search, Page ?? 1);
    }

    private void Apply()
    {
        Navigation.NavigateTo(Url(1));
    }

    private string Url(int page)
    {
        Dictionary<string, string?> query = new()
        {
            ["status"] = _status == nameof(PlatformSalesLeadStatus.New) ? null : _status,
            ["search"] = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
            ["page"] = page > 1 ? page.ToString(System.Globalization.CultureInfo.InvariantCulture) : null
        };

        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/leads", query.Where(pair => pair.Value is not null));
    }
}
