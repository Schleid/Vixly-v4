@*
=========================================================
FILE: SalesSettingsForm.razor

PURPOSE:
The limits the sales manager sets: what salespeople may offer on
their own, how long offer links last and when customers are told
a discount is ending (D-S22, D-S25).

IMPORTANT NOTES:
- Feature component (ADR-0001): behaviour lives in the
  presenter; this file holds markup and UI glue only
- Text comes from PlatformText (UI-10)
- No hard-coded limits: a blank limit means everything needs the
  sales manager's approval; a blank notice means no email
- Saving asks for step-up; four eyes apply to every approval
=========================================================
*@
@inherits PlatformPresenterComponent<SalesSettingsPresenter>
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors

<div id="sales-settings">
    <VxCard Title="@T["ui.sales_settings.title"]">
        @if (Presenter.State.DoneKey is { } done)
        {
            <VxMessage Type="VxMessageType.Success">@T[done]</VxMessage>
        }
        @if (Presenter.State.Error is not null)
        {
            <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
        }
        @if (!Presenter.State.Loaded)
        {
            <p role="status">@T["ui.common.loading"]</p>
        }
        else if (Presenter.State.Settings is { } settings)
        {
            <div class="vx-settings-header">
                <p class="vx-hint">@T["ui.sales_settings.help"]</p>
                @if (settings.UpdatedUtc is { } updated)
                {
                    <span class="vx-settings-meta">@VixlyText.Format(T, "ui.sales_settings.updated", new Dictionary<string, object> { ["name"] = settings.UpdatedByName ?? string.Empty, ["time"] = PlatformDisplay.Utc(T, updated) })</span>
                }
            </div>
            <form class="vx-form" @onsubmit="SaveAsync">
                <!-- Section 1: Discounts & Fixed Limits -->
                <fieldset class="vx-fieldset" disabled="@(!Presenter.State.CanEdit)">
                    <legend class="vx-fieldset__legend">@T["ui.sales_settings.discounts"]</legend>
                    <div class="vx-field" style="max-width: 22rem;">
                        <label for="sales-max-percent" class="vx-label">@T["ui.sales_settings.max_percent"]</label>
                        <input id="sales-max-percent" type="number" min="0" max="100" step="0.01" class="vx-input" @bind="_model.MaxPercentWithoutApproval" aria-describedby="sales-max-percent-help" />
                        <span id="sales-max-percent-help" class="vx-hint">@T["ui.sales_settings.max_percent_help"]</span>
                    </div>

                    <div class="vx-field">
                        <label class="vx-label">@T["ui.sales_settings.fixed_limits"]</label>
                        <span class="vx-hint">@T["ui.sales_settings.fixed_limits_help"]</span>
                        @if (_model.FixedLimits.Count > 0)
                        {
                            <div class="vx-limit-list">
                                @for (int index = 0; index < _model.FixedLimits.Count; index++)
                                {
                                    SalesSettingsModel.FixedLimitRow row = _model.FixedLimits[index];
                                    <div class="vx-limit-row">
                                        <input aria-label="@T["ui.plans.currency"]" class="vx-input vx-limit-currency" @bind="row.CurrencyCode" maxlength="3" required autocomplete="off" placeholder="USD" />
                                        <input aria-label="@T["ui.sales_settings.fixed_amount"]" class="vx-input vx-limit-amount" type="number" min="0" step="0.01" @bind="row.Amount" placeholder="0.00" />
                                        <VxButton Variant="VxButtonVariant.Subtle" OnClick="() => _model.FixedLimits.Remove(row)">@T["ui.common.remove"]</VxButton>
                                    </div>
                                }
                            </div>
                        }
                        <div>
                            <VxButton Variant="VxButtonVariant.Subtle" OnClick="() => _model.FixedLimits.Add(new SalesSettingsModel.FixedLimitRow())">@T["ui.sales_settings.add_limit"]</VxButton>
                        </div>
                    </div>

                    <div class="vx-field vx-field--checkbox">
                        <label class="vx-checkbox-label">
                            <input type="checkbox" class="vx-checkbox" @bind="_model.NoEndWithoutApproval" />
                            <span>@T["ui.sales_settings.no_end"]</span>
                        </label>
                    </div>
                </fieldset>

                <!-- Section 2: Offer Validity -->
                <fieldset class="vx-fieldset" disabled="@(!Presenter.State.CanEdit)">
                    <legend class="vx-fieldset__legend">@T["ui.sales_settings.offers"]</legend>
                    <div class="vx-field" style="max-width: 22rem;">
                        <label for="sales-offer-days" class="vx-label">@T["ui.sales_settings.max_offer_days"]</label>
                        <input id="sales-offer-days" type="number" min="1" max="365" class="vx-input" @bind="_model.MaxOfferValidityDays" aria-describedby="sales-offer-days-help" />
                        <span id="sales-offer-days-help" class="vx-hint">@T["ui.sales_settings.max_offer_days_help"]</span>
                    </div>
                </fieldset>

                <!-- Section 3: Customer Notices & Registration -->
                <fieldset class="vx-fieldset" disabled="@(!Presenter.State.CanEdit)">
                    <legend class="vx-fieldset__legend">@T["ui.sales_settings.customers"]</legend>
                    <div class="vx-field" style="max-width: 22rem;">
                        <label for="sales-notice-days" class="vx-label">@T["ui.sales_settings.notice_days"]</label>
                        <input id="sales-notice-days" type="number" min="1" max="90" class="vx-input" @bind="_model.DiscountEndNoticeDays" aria-describedby="sales-notice-days-help" />
                        <span id="sales-notice-days-help" class="vx-hint">@T["ui.sales_settings.notice_days_help"]</span>
                    </div>
                    <div class="vx-field vx-field--checkbox">
                        <label class="vx-checkbox-label">
                            <input type="checkbox" class="vx-checkbox" @bind="_model.PromotionCodesAtRegistration" />
                            <span>@T["ui.sales_settings.codes_at_registration"]</span>
                        </label>
                    </div>
                </fieldset>

                @if (Presenter.State.CanEdit)
                {
                    <div class="vx-actions">
                        <VxButton Variant="VxButtonVariant.Primary" Type="submit" IsBusy="@Presenter.IsBusy">@T["ui.sales_settings.save"]</VxButton>
                    </div>
                }
            </form>
            @if (Presenter.State.StepUpPending)
            {
                <StepUpDialog OnConfirmed="SaveAsync" OnCancelled="Presenter.CancelStepUp" />
            }
        }
    </VxCard>
</div>

@code {
    private SalesSettingsModel _model = new();

    private int _seenVersion = -1;

    protected override async Task OnParametersSetAsync()
    {
        await Presenter.LoadAsync();
        Sync();
    }

    private async Task SaveAsync()
    {
        await Presenter.SaveAsync(_model);
        Sync();
    }

    private void Sync()
    {
        if (Presenter.State.Settings is { } settings && _seenVersion != Presenter.State.Version)
        {
            _seenVersion = Presenter.State.Version;
            _model = SalesSettingsModel.From(settings);
        }
    }
}
