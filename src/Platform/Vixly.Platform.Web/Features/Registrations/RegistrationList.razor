@*
=========================================================
FILE: RegistrationList.razor

PURPOSE:
Self-service registrations: filters, table and pager.

IMPORTANT NOTES:
- Feature component (ADR-0001): behaviour lives in the
  presenter; this file holds markup and UI glue only
- Text comes from PlatformText (UI-10); placeholder look until
  the Frontend/UI team designs it
=========================================================
*@
@inherits PlatformPresenterComponent<RegistrationListPresenter>
@using Vixly.Platform.Domain.Tenants
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors
@inject NavigationManager Navigation

<form class="vx-toolbar" role="search" @onsubmit="ApplyFilters">
    <label for="registration-search">@T["ui.registrations.search"]</label>
    <input id="registration-search" type="search" @bind="_search" maxlength="100" />
    <label for="registration-status">@T["ui.tenants.status"]</label>
    <select id="registration-status" @bind="_status">
        <option value="">@T["ui.tenants.status.all"]</option>
        @foreach (PlatformTenantRegistrationStatus status in Enum.GetValues<PlatformTenantRegistrationStatus>())
        {
            <option value="@status">@T[PlatformDisplay.RegistrationStatusKey(status)]</option>
        }
    </select>
    <VxButton Type="submit">@T["ui.users.apply"]</VxButton>
</form>

@if (Presenter.State.Error is not null)
{
    <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
}
else
{
    <VxDataTable Items="Presenter.State.Registrations" IsLoading="@(!Presenter.State.Loaded)" Caption="@(Presenter.State.Loaded ? VixlyText.Format(T, "ui.registrations.count", "count", Presenter.State.TotalCount) : null)">
        <HeaderContent>
            <th scope="col">@T["ui.tenants.legal_name"]</th>
            <th scope="col">@T["ui.tenants.owner"]</th>
            <th scope="col">@T["ui.tenants.slug"]</th>
            <th scope="col">@T["ui.tenants.status"]</th>
            <th scope="col">@T["ui.registrations.started"]</th>
        </HeaderContent>
        <RowTemplate Context="item">
            <td><a href="/tenants/registrations/@item.RegistrationId">@item.LegalName</a></td>
            <td>@item.OwnerName (@item.OwnerEmail)</td>
            <td>@item.Slug</td>
            <td><VxStatusBadge Status="@PlatformDisplay.RegistrationBadge(item.Status)" Text="@T[PlatformDisplay.RegistrationStatusKey(item.Status)]" /></td>
            <td>@PlatformDisplay.Utc(T, item.CreatedUtc)</td>
        </RowTemplate>
        <EmptyContent>
            <VxEmptyState Title="@T["ui.registrations.empty"]" />
        </EmptyContent>
    </VxDataTable>
    @if (Presenter.State.Loaded && Presenter.State.Registrations.Count > 0)
    {
        <VxPager CurrentPage="Presenter.State.Page" TotalPages="Presenter.State.TotalPages" PageChanged="GoToPage" />
    }
}

@code {
    private string? _search;

    private string _status = string.Empty;

    [Parameter]
    public string? Search { get; set; }

    [Parameter]
    public string? Status { get; set; }

    [Parameter]
    public int? Page { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _search = Search;
        PlatformTenantRegistrationStatus? status = Enum.TryParse(Status, true, out PlatformTenantRegistrationStatus parsed) ? parsed : null;
        _status = status?.ToString() ?? string.Empty;

        await Presenter.LoadAsync(Search, status, Page ?? 1);
    }

    private void ApplyFilters()
    {
        Navigation.NavigateTo(Url(_search, _status, 1));
    }

    private string PageUrl(int page)
    {
        return Url(Search, _status, page);
    }

    private static string Url(string? search, string status, int page)
    {
        Dictionary<string, string?> query = new()
        {
            ["search"] = string.IsNullOrWhiteSpace(search) ? null : search.Trim(),
            ["status"] = string.IsNullOrEmpty(status) ? null : status,
            ["page"] = page > 1 ? page.ToString(System.Globalization.CultureInfo.InvariantCulture) : null
        };

        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/tenants/registrations", query.Where(pair => pair.Value is not null));
    }

    private void GoToPage(int page)
    {
        Navigation.NavigateTo(PageUrl(page));
    }
}
