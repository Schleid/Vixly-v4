@*
=========================================================
FILE: TenantLicensing.razor

PURPOSE:
The Licensing section of the tenant page: seats bought and in
use, devices waiting, releases under review, and the owner
actions (first-device link, owner recovery) (Slice 7).

IMPORTANT NOTES:
- Feature component (ADR-0001): behaviour lives in the
  presenter; this file holds markup and UI glue only
- Text comes from PlatformText (UI-10); placeholder look until
  the Frontend/UI team designs it
- Hidden for staff without platform.licensing.view
- Links go to the owner's email only; staff never see them
- Owner support (D-O13): the identity check and reason are
  required; a second-factor reset needs a second staff member
=========================================================
*@
@inherits PlatformPresenterComponent<TenantLicensingPresenter>
@using Vixly.Platform.Application.Security
@using Vixly.Platform.Application.UseCases.Licensing
@using Vixly.Platform.Domain.Licensing
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors

@if (!PlatformSecurityErrors.AccessDenied.Equals(Presenter.State.Error))
{
    <div id="tenant-licensing"><VxCard Title="@T["ui.licensing.title"]">
        @if (Presenter.State.DoneKey is { } done)
        {
            <VxMessage Type="VxMessageType.Success">@T[done]</VxMessage>
        }
        @if (Presenter.State.Error is not null)
        {
            <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
        }
        @if (!Presenter.State.Loaded)
        {
            <p role="status">@T["ui.common.loading"]</p>
        }
        else if (Presenter.State.Summary is { } summary)
        {
            <dl class="vx-facts">
                <dt>@T["ui.licensing.seats"]</dt>
                <dd>
                    @VixlyText.Format(T, "ui.licensing.seats_used", new Dictionary<string, object> { ["inUse"] = summary.Counts.HoldingSeats, ["seats"] = summary.SeatsBought })
                    @if (summary.SeatsScheduled is { } scheduled)
                    {
                        <span class="vx-hint">@VixlyText.Format(T, "ui.licensing.seats_scheduled", "seats", scheduled)</span>
                    }
                </dd>
                <dt>@T["ui.licensing.pending"]</dt>
                <dd>@summary.Counts.Pending</dd>
                <dt>@T["ui.licensing.awaiting_review"]</dt>
                <dd>@summary.Counts.AwaitingReview</dd>
                <dt>@T["ui.licensing.allowance"]</dt>
                <dd>@VixlyText.Format(T, "ui.licensing.allowance_value", "count", summary.ReleaseAllowance)</dd>
            </dl>
            <TenantLicenceList TenantId="@TenantId" Seats="@summary.SeatsBought" />
            @if (summary.Abilities.CanManage)
            {
                @if (summary.FirstDeviceLinkAllowed)
                {
                    <div class="vx-actions">
                        <VxButton OnClick="() => Presenter.RunAsync(TenantId, TenantLicensingPresenter.FirstDeviceAction)" IsBusy="@Presenter.IsBusy">@T["ui.licensing.send_first_link"]</VxButton>
                    </div>
                }
                <h3>@T["ui.licensing.support_title"]</h3>
                <p class="vx-hint">@T["ui.licensing.support_help"]</p>
                <div class="vx-form-grid-2" style="margin-bottom: 0.75rem;">
                    <div class="vx-field-compact">
                        <label for="support-identity">@T["ui.licensing.identity_check"]</label>
                        <textarea id="support-identity" @bind="_identityCheck" maxlength="@PlatformLicensingLimits.SupportTextMaxLength" rows="2" placeholder="@T["ui.licensing.identity_check_hint"]" style="resize: vertical;"></textarea>
                    </div>
                    <div class="vx-field-compact">
                        <label for="support-reason">@T["ui.licensing.support_reason"]</label>
                        <textarea id="support-reason" @bind="_reason" maxlength="@PlatformLicensingLimits.SupportTextMaxLength" rows="2" style="resize: vertical;"></textarea>
                    </div>
                </div>
                <div class="vx-field-compact" style="max-width: 32rem; margin-bottom: 1rem;">
                    <label for="support-replace">
                        <strong>@T["ui.licensing.replace_device"]</strong>
                    </label>
                    <select id="support-replace" @bind="_replace" style="height: 38px; font-weight: 500;">
                        <option value="">— @T["ui.licensing.replace_none"] —</option>
                        @foreach (PlatformDeviceOption device in summary.ActiveDevices)
                        {
                            <option value="@device.DeviceId">@device.Number · @device.Name</option>
                        }
                    </select>
                </div>
                <div class="vx-actions">
                    <VxButton Variant="VxButtonVariant.Subtle" OnClick="() => Presenter.RunAsync(TenantId, TenantLicensingPresenter.RecoveryAction, Input())" IsBusy="@Presenter.IsBusy">@T["ui.licensing.start_recovery"]</VxButton>
                    <VxButton Variant="VxButtonVariant.Subtle" OnClick="() => Presenter.RunAsync(TenantId, TenantLicensingPresenter.ResetAction, Input())" IsBusy="@Presenter.IsBusy">@T["ui.licensing.request_reset"]</VxButton>
                </div>
                <p class="vx-hint">@T["ui.licensing.recovery_help"]</p>
                @if (summary.Support.Count > 0)
                {
                    <h3>@T["ui.licensing.support_open"]</h3>
                    <ul class="vx-list">
                        @foreach (PlatformOwnerSupportItem item in summary.Support)
                        {
                            <li>
                                <strong>@T["ui.licensing.support_kind." + item.Kind.ToString().ToLowerInvariant()]</strong>
                                · @T["ui.licensing.support_status." + item.Status.ToString().ToLowerInvariant()]
                                · @(item.RequestedByName ?? T["ui.licensing.unknown_staff"]) · @item.RequestedUtc.ToString("g", System.Globalization.CultureInfo.CurrentCulture)
                                <div class="vx-hint">@item.IdentityCheck — @item.Reason</div>
                                @if (item.Kind == PlatformOwnerSupportKind.SecondFactorReset && item.Status == PlatformOwnerSupportStatus.Pending)
                                {
                                    <div class="vx-field">
                                        <label for="note-@item.RequestId">@T["ui.licensing.decision_note"]</label>
                                        <input id="note-@item.RequestId" @bind="_note" maxlength="@PlatformLicensingLimits.SupportTextMaxLength" />
                                    </div>
                                    <div class="vx-actions">
                                        <VxButton OnClick="() => Presenter.RunAsync(TenantId, TenantLicensingPresenter.ApproveAction + item.RequestId, Input())" IsBusy="@Presenter.IsBusy">@T["ui.licensing.approve_reset"]</VxButton>
                                        <VxButton Variant="VxButtonVariant.Subtle" OnClick="() => Presenter.RunAsync(TenantId, TenantLicensingPresenter.RefuseAction + item.RequestId, Input())" IsBusy="@Presenter.IsBusy">@T["ui.licensing.refuse_reset"]</VxButton>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }
            }
        }
    </VxCard></div>
    @if (Presenter.State.StepUpAction is { } action)
    {
        <StepUpDialog OnConfirmed="() => Presenter.RunAsync(TenantId, action)" OnCancelled="Presenter.CancelStepUp" />
    }
}

@code {
    [Parameter, EditorRequired]
    public Guid TenantId { get; set; }

    private Guid _loaded;

    private string? _identityCheck;

    private string? _reason;

    private string? _replace;

    private string? _note;

    private OwnerSupportInput Input() => new(_reason, _identityCheck, Guid.TryParse(_replace, out Guid id) ? id : null, _note);

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded != TenantId)
        {
            _loaded = TenantId;
            await Presenter.LoadAsync(TenantId);
        }
    }
}
