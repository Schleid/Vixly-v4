@*
=========================================================
FILE: TenantSubscriptionHistory.razor

PURPOSE:
The tenant's subscription history, newest first, across every
subscription it has had (D-S3).

IMPORTANT NOTES:
- Feature component (ADR-0001): behaviour lives in the
  presenter; this file holds markup and UI glue only
- Text comes from PlatformText (UI-10); placeholder look until
  the Frontend/UI team designs it
- History is append-only in the database (D-2)
=========================================================
*@
@inherits PlatformPresenterComponent<TenantSubscriptionHistoryPresenter>
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors

<div id="tenant-subscription-history"><VxCard Title="@T["ui.subscriptions.history"]">
    @if (Presenter.State.Error is not null)
    {
        <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
    }
    else
    {
        <VxDataTable Items="Presenter.State.Events" IsLoading="@(!Presenter.State.Loaded)">
            <HeaderContent>
                <th scope="col">@T["ui.audit.when"]</th>
                <th scope="col">@T["ui.audit.what"]</th>
                <th scope="col">@T["ui.subscriptions.status"]</th>
                <th scope="col">@T["ui.audit.who"]</th>
                <th scope="col">@T["ui.tenants.reason"]</th>
            </HeaderContent>
            <RowTemplate Context="item">
                <td>@PlatformDisplay.Utc(T, item.OccurredUtc)</td>
                <td>@SubscriptionDisplay.History(T, item)</td>
                <td>@T[SubscriptionDisplay.StatusKey(item.ToStatus)]</td>
                <td>@(item.ActorName ?? T["ui.audit.no_actor"].Value)</td>
                <td>@item.Reason</td>
            </RowTemplate>
            <EmptyContent>
                <VxEmptyState Title="@T["ui.subscriptions.history_empty"]" />
            </EmptyContent>
        </VxDataTable>
        @if (Presenter.State.Loaded && Presenter.State.TotalPages > 1)
        {
            <VxPager CurrentPage="Presenter.State.Page" TotalPages="Presenter.State.TotalPages" PageChanged="page => Presenter.LoadAsync(TenantId, page)" />
        }
    }
</VxCard></div>

@code {
    [Parameter, EditorRequired]
    public Guid TenantId { get; set; }

    [Parameter]
    public int Version { get; set; }

    protected override Task OnParametersSetAsync()
    {
        return Presenter.LoadAsync(TenantId, 1);
    }
}
