@*
=========================================================
FILE: ZelleClaimsOverview.razor

PURPOSE:
Zelle payments customers reported, waiting ones first by
default: staff check each against the bank before confirming.

IMPORTANT NOTES:
- Feature component (ADR-0001): behaviour lives in the
  presenter; this file holds markup and UI glue only
- Text comes from PlatformText (UI-10); placeholder look until
  the Frontend/UI team designs it
- Filters live in the URL so a view can be bookmarked
=========================================================
*@
@inherits PlatformPresenterComponent<ZelleClaimsPresenter>
@using Vixly.Platform.Domain.Payments
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors
@inject NavigationManager Navigation

@if (Presenter.State.Error is not null)
{
    <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
}
<form class="vx-toolbar" role="search" @onsubmit="Apply">
    <label for="zelle-search">@T["ui.zelle.search"]</label>
    <input id="zelle-search" @bind="_search" maxlength="100" />
    <label for="zelle-status">@T["ui.zelle.status"]</label>
    <select id="zelle-status" @bind="_status">
        <option value="All">@T["ui.zelle.status.all"]</option>
        @foreach (PlatformZelleClaimStatus status in Enum.GetValues<PlatformZelleClaimStatus>())
        {
            <option value="@status">@T[ZelleDisplay.StatusKey(status)]</option>
        }
    </select>
    <VxButton Type="submit">@T["ui.users.apply"]</VxButton>
</form>
<p class="vx-hint">@(Presenter.State.Loaded ? VixlyText.Format(T, "ui.zelle.count", "count", Presenter.State.TotalCount) : T["ui.common.loading"].Value)</p>
<div id="zelle-claims">
    <VxDataTable Items="Presenter.State.Items" IsLoading="!Presenter.State.Loaded">
        <HeaderContent>
            <th scope="col">@T["ui.zelle.reported"]</th>
            <th scope="col">@T["ui.zelle.tenant"]</th>
            <th scope="col">@T["ui.invoices.number"]</th>
            <th scope="col">@T["ui.zelle.amount"]</th>
            <th scope="col">@T["ui.zelle.sender"]</th>
            <th scope="col">@T["ui.zelle.status"]</th>
        </HeaderContent>
        <RowTemplate Context="claim">
            <td><a href="/payments/zelle/@claim.ClaimId">@PlatformDisplay.Utc(T, claim.ReportedUtc)</a></td>
            <td><a href="/tenants/@claim.PlatformTenantId#tenant-billing">@claim.TenantName</a></td>
            <td><a href="/invoices/@claim.PlatformInvoiceId">@claim.InvoiceNumber</a></td>
            <td>@Vixly.Platform.Web.Features.Billing.BillingDisplay.Money(claim.Amount, claim.CurrencyCode)</td>
            <td>@claim.SenderName <span class="vx-hint">@claim.Reference</span></td>
            <td><VxStatusBadge Status="@ZelleDisplay.Badge(claim.Status)" Text="@T[ZelleDisplay.StatusKey(claim.Status)]" /></td>
        </RowTemplate>
    </VxDataTable>
</div>
@if (Presenter.State.Loaded && Presenter.State.TotalPages > 1)
{
    <VxPager CurrentPage="Presenter.State.Page" TotalPages="Presenter.State.TotalPages" PageChanged="page => Navigation.NavigateTo(Url(page))" />
}

@code {
    private string _status = nameof(PlatformZelleClaimStatus.Waiting);

    private string? _search;

    [Parameter]
    public string? Status { get; set; }

    [Parameter]
    public string? Search { get; set; }

    [Parameter]
    public int? Page { get; set; }

    // Waiting reports by default; "All" shows every report.
    protected override Task OnParametersSetAsync()
    {
        PlatformZelleClaimStatus? status = Status is null ? PlatformZelleClaimStatus.Waiting : Enum.TryParse(Status, true, out PlatformZelleClaimStatus parsed) ? parsed : null;
        _status = status?.ToString() ?? "All";
        _search = Search;
        return Presenter.LoadAsync(status, Search, Page ?? 1);
    }

    private void Apply()
    {
        Navigation.NavigateTo(Url(1));
    }

    private string Url(int page)
    {
        Dictionary<string, string?> query = new()
        {
            ["status"] = _status == nameof(PlatformZelleClaimStatus.Waiting) ? null : _status,
            ["search"] = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
            ["page"] = page > 1 ? page.ToString(System.Globalization.CultureInfo.InvariantCulture) : null
        };

        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/payments/zelle", query.Where(pair => pair.Value is not null));
    }
}
