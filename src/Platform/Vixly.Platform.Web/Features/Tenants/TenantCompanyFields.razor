@*
=========================================================
FILE: TenantCompanyFields.razor

PURPOSE:
The company fields shared by the new-tenant form and the
profile editor.

IMPORTANT NOTES:
- Markup only, no presenter: the parent owns the model
- Text comes from PlatformText (UI-10)
=========================================================
*@
@inject IStringLocalizer<PlatformText> T

<fieldset class="vx-fieldset">
    <legend>@T["ui.tenants.company"]</legend>
    <label for="@($"{Prefix}-legal")">@T["ui.tenants.legal_name"]</label>
    <input id="@($"{Prefix}-legal")" @bind="Model.LegalName" maxlength="200" required autocomplete="organization" />
    <label for="@($"{Prefix}-trading")">@T["ui.tenants.trading_name"]</label>
    <input id="@($"{Prefix}-trading")" @bind="Model.TradingName" maxlength="200" />
    <label for="@($"{Prefix}-email")">@T["ui.tenants.company_email"]</label>
    <input id="@($"{Prefix}-email")" type="email" @bind="Model.Email" maxlength="254" required />
    <label for="@($"{Prefix}-phone")">@T["ui.tenants.company_phone"]</label>
    <input id="@($"{Prefix}-phone")" type="tel" @bind="Model.Phone" maxlength="30" required />
    <label for="@($"{Prefix}-line1")">@T["ui.tenants.address_line1"]</label>
    <input id="@($"{Prefix}-line1")" @bind="Model.AddressLine1" maxlength="200" required autocomplete="address-line1" />
    <label for="@($"{Prefix}-line2")">@T["ui.tenants.address_line2"]</label>
    <input id="@($"{Prefix}-line2")" @bind="Model.AddressLine2" maxlength="200" autocomplete="address-line2" />
    <label for="@($"{Prefix}-city")">@T["ui.tenants.city"]</label>
    <input id="@($"{Prefix}-city")" @bind="Model.City" maxlength="100" required autocomplete="address-level2" />
    <label for="@($"{Prefix}-region")">@T["ui.tenants.state_province"]</label>
    <input id="@($"{Prefix}-region")" @bind="Model.StateProvince" maxlength="100" autocomplete="address-level1" />
    <label for="@($"{Prefix}-postal")">@T["ui.tenants.postal_code"]</label>
    <input id="@($"{Prefix}-postal")" @bind="Model.PostalCode" maxlength="20" autocomplete="postal-code" />
    <label for="@($"{Prefix}-country")">@T["ui.tenants.country"]</label>
    <select id="@($"{Prefix}-country")" @bind="Model.CountryCode" required>
        <option value="">@T["ui.tenants.choose_country"]</option>
        @foreach ((string countryCode, string countryName) in PlatformDisplay.Countries(T))
        {
            <option value="@countryCode">@countryName</option>
        }
    </select>
</fieldset>
<fieldset class="vx-fieldset">
    <legend>@T["ui.tenants.settings"]</legend>
    <label for="@($"{Prefix}-language")">@T["ui.tenants.language"]</label>
    <select id="@($"{Prefix}-language")" @bind="Model.Language">
        @foreach (string language in VixlyCultures.Supported.Select(culture => culture.TwoLetterISOLanguageName))
        {
            <option value="@language">@T["ui.language." + language]</option>
        }
    </select>
    <label for="@($"{Prefix}-zone")">@T["ui.tenants.time_zone"]</label>
    <input id="@($"{Prefix}-zone")" list="@($"{Prefix}-zones")" @bind="Model.TimeZone" maxlength="64" autocomplete="off" />
    <datalist id="@($"{Prefix}-zones")">
        @foreach (string zone in PlatformDisplay.TimeZoneIds)
        {
            <option value="@zone"></option>
        }
    </datalist>
</fieldset>

@code {
    [Parameter, EditorRequired]
    public TenantFormModel Model { get; set; } = null!;

    [Parameter, EditorRequired]
    public string Prefix { get; set; } = string.Empty;
}
