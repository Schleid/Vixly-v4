@*
=========================================================
FILE: TenantHistory.razor

PURPOSE:
The history of a tenant, in the reader's language (D-4).

IMPORTANT NOTES:
- Feature component (ADR-0001): behaviour lives in the
  presenter; this file holds markup and UI glue only
- Text comes from PlatformText (UI-10); placeholder look until
  the Frontend/UI team designs it
- Each event is a code plus arguments turned into text here
=========================================================
*@
@inherits PlatformPresenterComponent<TenantHistoryPresenter>
@using Vixly.Platform.Application.Queries
@inject IStringLocalizer<PlatformText> T
@inject PlatformErrorText Errors

<div id="tenant-history"><VxCard Title="@T["ui.tenants.history"]">
    @if (Presenter.State.Error is not null)
    {
        <VxMessage Type="VxMessageType.Error">@Errors.Describe(Presenter.State.Error)</VxMessage>
    }
    else
    {
        <VxDataTable Items="Presenter.State.Events" IsLoading="@(!Presenter.State.Loaded)">
            <HeaderContent>
                <th scope="col">@T["ui.audit.when"]</th>
                <th scope="col">@T["ui.audit.what"]</th>
                <th scope="col">@T["ui.audit.who"]</th>
                <th scope="col">@T["ui.tenants.reason"]</th>
            </HeaderContent>
            <RowTemplate Context="item">
                <td>@PlatformDisplay.Utc(T, item.OccurredUtc)</td>
                <td>@Describe(item)</td>
                <td>@(item.ActorName ?? T["ui.audit.no_actor"].Value)</td>
                <td>@item.Reason</td>
            </RowTemplate>
        </VxDataTable>
        @if (Presenter.State.Loaded && Presenter.State.TotalPages > 1)
        {
            <VxPager CurrentPage="Presenter.State.Page" TotalPages="Presenter.State.TotalPages" PageChanged="page => Presenter.LoadAsync(TenantId, page)" />
        }
    }
</VxCard></div>

@code {
    [Parameter, EditorRequired]
    public Guid TenantId { get; set; }

    [Parameter]
    public int Version { get; set; }

    protected override Task OnParametersSetAsync()
    {
        return Presenter.LoadAsync(TenantId, 1);
    }

    private string Describe(PlatformTenantEventItem item)
    {
        Dictionary<string, object> values = item.Arguments.ToDictionary(pair => pair.Key, pair => (object)pair.Value, StringComparer.Ordinal);
        values["status"] = T[PlatformDisplay.TenantStatusKey(item.ToStatus)].Value;
        values["category"] = item.Category is { } category ? T[PlatformDisplay.CategoryKey(category)].Value : string.Empty;

        return VixlyText.Format(T, PlatformDisplay.HistoryKey(item.EventCode), values);
    }
}
