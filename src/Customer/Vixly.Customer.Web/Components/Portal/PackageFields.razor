@*
=========================================================
FILE: PackageFields.razor

PURPOSE:
The fields of one announced package (Slice 3B; owner, 2026-10-18).

RESPONSIBILITIES:
- Ask for the carrier, tracking number, the store it was bought from, what is inside item by item, and the expected date

IMPORTANT NOTES:
- Markup only; the caller passes its localizer and the form around it
- The customer's own words become the package's declaration; staff never type it (D-C6)
- "Purchase store" names the shop the customer bought from, so it is not mistaken for a place to send to (owner, 2026-10-27)
- Owner, 2026-11-01: item by item (words, quantity, value of one, new or used); blank rows are left out; no customs code is ever asked
=========================================================
*@
@using Vixly.Contracts.Operations.Packages

<div class="customer-field-duo">
    <label>@T["ui.prealert.carrier"] <input name="carrier" value="@Entered?.Carrier" maxlength="40" required="@Required" placeholder="UPS, FedEx, USPS, DHL, Amazon" /></label>
    <label>@T["ui.prealert.store"] <input name="store" value="@Entered?.Store" maxlength="100" placeholder="Amazon, Walmart, Shein, eBay" /></label>
</div>
<label>@T["ui.prealert.tracking"] <input name="tracking" value="@Entered?.TrackingNumber" maxlength="60" required="@Required" autocomplete="off" autocapitalize="characters" spellcheck="false" /></label>
<fieldset class="customer-items">
    <legend>@T["ui.prealert.items"]</legend>
    <p class="customer-items__hint">@T["ui.prealert.items_hint"]</p>
    <div class="customer-items__table-wrap">
        <table class="customer-items__table">
            <thead>
                <tr>
                    <th scope="col" style="min-width: 14rem;">@T["ui.prealert.item"]</th>
                    <th scope="col" style="width: 5rem; text-align: center;">@T["ui.prealert.quantity"]</th>
                    <th scope="col" style="width: 7rem; text-align: right;">@T["ui.prealert.value_each"]</th>
                    <th scope="col" style="width: 7.5rem;">@T["ui.prealert.condition"]</th>
                </tr>
            </thead>
            <tbody>
                @for (int row = 0; row < RowCount; row++)
                {
                    CustomerItemBody? item = row < Items.Count ? Items[row] : null;
                    bool first = row == 0;
                    <tr>
                        <td><input name="item_words" maxlength="200" value="@item?.Words" required="@(Required && first)" aria-label="@T["ui.prealert.item"]" placeholder="@(first ? T["ui.prealert.item_example"].Value : null)" class="customer-items__input-words" /></td>
                        <td style="text-align: center;"><input name="item_qty" type="number" inputmode="numeric" min="1" step="1" size="3" value="@(item is null ? null : item.Quantity.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))" placeholder="1" aria-label="@T["ui.prealert.quantity"]" class="customer-items__input-qty" /></td>
                        <td style="text-align: right;"><input name="item_value" type="number" inputmode="decimal" min="0" step="0.01" size="7" value="@(item is { ValueEach: >= 0 } ? item.ValueEach.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : null)" required="@(Required && first)" aria-label="@T["ui.prealert.value_each"]" class="customer-items__input-val" /></td>
                        <td>
                            <select name="item_used" aria-label="@T["ui.prealert.condition"]" class="customer-items__select-used">
                                <option value="new">@T["ui.prealert.condition_new"]</option>
                                <option value="used" selected="@(item?.Used == true)">@T["ui.prealert.condition_used"]</option>
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</fieldset>
<label>@T["ui.prealert.expected"] <input name="expected" type="date" value="@Entered?.ExpectedDate?.ToString("yyyy-MM-dd")" /></label>

@code {
    [Parameter, EditorRequired] public IStringLocalizer<CustomerText> T { get; set; } = null!;

    [Parameter] public CustomerPreAlertBody? Entered { get; set; }

    // Slice 4D: optional on the new shipment form, where a package may be announced with it or not.
    [Parameter] public bool Required { get; set; } = true;

    // What was typed before a refusal; an older single declaration shows as one item.
    private IReadOnlyList<CustomerItemBody> Items => Entered?.Items is { Count: > 0 } items ? items
        : Entered is { Contents: { Length: > 0 } contents } ? new[] { new CustomerItemBody(contents, 1m, Entered.DeclaredValue, false) } : Array.Empty<CustomerItemBody>();

    // Five rows to fill, or one more than typed, at most ten.
    private int RowCount => Math.Min(10, Math.Max(5, Items.Count + 1));
}
