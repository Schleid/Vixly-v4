@*
=========================================================
FILE: ForgotPasswordPage.razor

PURPOSE:
The forgot-password page.

RESPONSIBILITIES:
- Render the forgot-password page

IMPORTANT NOTES:
- Markup only. Text comes from CustomerText (L-10); values come from the endpoint
- Static forms with antiforgery and the form guard (ADR-0019)
- Placeholder look: Frontend/UI designs the final experience; never says "Vixly"
=========================================================
*@
@inject IStringLocalizer<CustomerText> T

<CustomerShell Brand="@Brand" Title="@T["ui.forgot.title"]" Subtitle="@T["ui.forgot.subtitle"]" Error="@Error" ReturnHere="/customer/forgot-password">
    <form method="post" action="/customer/forgot-password" class="customer-portal__form">
        <AntiforgeryToken />
        <label>@T["ui.field.email"] <input type="email" name="email" value="@Email" autocomplete="email" maxlength="254" required /></label>
        <button type="submit" class="vx-button vx-button--primary">@T["ui.forgot.submit"]</button>
    </form>
    <p><a href="/customer/sign-in">@T["ui.sign_in.link"]</a></p>
</CustomerShell>

@code {
    [Parameter] public Vixly.Contracts.Operations.Customers.CustomerPortalBrandDto? Brand { get; set; }

    [Parameter] public string? Email { get; set; }

    [Parameter] public string? Error { get; set; }
}
