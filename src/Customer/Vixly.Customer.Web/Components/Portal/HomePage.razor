@*
=========================================================
FILE: HomePage.razor

PURPOSE:
The signed-in customer's home: the mailbox addresses and the code.

RESPONSIBILITIES:
- Render the signed-in customer's home: the mailbox addresses and the code

IMPORTANT NOTES:
- Markup only. Text comes from CustomerText (L-10); values come from the endpoint
- Static forms with antiforgery and the form guard (ADR-0019)
- Placeholder look: Frontend/UI designs the final experience; never says "Vixly"
=========================================================
*@
@using Vixly.Contracts.Operations.Customers
@inject IStringLocalizer<CustomerText> T

<CustomerShell Brand="@Brand" Title="@VixlyText.Format(T, "ui.home.hello", "name", Customer.FirstName)" SignedIn="true" Info="@Info" ReturnHere="/customer/">
    <nav class="customer-home-actions" aria-label="@T["ui.nav"]">
        <a href="/customer/packages"><Vixly.Shared.UI.Primitives.VxWorkspaceArt Kind="parcel" /><span>@T["ui.nav.packages"]</span><span aria-hidden="true">↗</span></a>
        <a href="/customer/rates"><Vixly.Shared.UI.Primitives.VxWorkspaceArt Kind="document" /><span>@T["ui.nav.rates"]</span><span aria-hidden="true">↗</span></a>
        <a href="/customer/tickets"><Vixly.Shared.UI.Primitives.VxWorkspaceArt Kind="support" /><span>@T["ui.nav.tickets"]</span><span aria-hidden="true">↗</span></a>
    </nav>
    <section class="customer-portal__panel" aria-labelledby="mailbox-title">
        <h2 id="mailbox-title">@T["ui.mailbox.title"]</h2>
        <p class="customer-portal__code">@VixlyText.Format(T, "ui.mailbox.code", "code", Customer.Code ?? string.Empty)</p>
        <p class="customer-portal__hint">@T["ui.mailbox.hint"]</p>
        @if (Customer.Mailboxes.Count == 0)
        {
            <p>@T["ui.mailbox.none"]</p>
        }
        <div class="customer-portal__mailboxes">
        @foreach (CustomerMailboxDto mailbox in Customer.Mailboxes)
        {
            <address class="customer-portal__mailbox">
                <strong>@mailbox.WarehouseName</strong><br />
                @mailbox.Addressee<br />
                @mailbox.Line1<br />
                @if (!string.IsNullOrWhiteSpace(mailbox.Line2)) { @mailbox.Line2<br /> }
                @mailbox.City@(mailbox.Region is null ? null : ", " + mailbox.Region) @mailbox.PostalCode<br />
                @mailbox.CountryCode
            </address>
        }
        </div>
    </section>
</CustomerShell>

@code {
    [Parameter] public CustomerPortalBrandDto? Brand { get; set; }

    [Parameter, EditorRequired] public CustomerProfileDto Customer { get; set; } = null!;

    [Parameter] public string? Info { get; set; }
}
