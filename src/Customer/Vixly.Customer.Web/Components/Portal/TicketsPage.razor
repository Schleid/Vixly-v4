@*
=========================================================
FILE: TicketsPage.razor

PURPOSE:
The customer's tickets about packages the carrier delivered that are not in the account (Slice 4D step 4).

RESPONSIBILITIES:
- List the tickets with their status; link to a new one

IMPORTANT NOTES:
- Markup only. Text comes from CustomerText (L-10); never "Vixly" (ADR-0012)
- Staff search the warehouse; the customer never does (A-6)
- Brief §5 list anatomy with structured table and status pills
=========================================================
*@
@using Vixly.Contracts.Operations.Customers
@using Vixly.Contracts.Operations.Tickets
@inject IStringLocalizer<CustomerText> T

<CustomerShell Brand="@Brand" Title="@T["ui.tickets.title"]" SignedIn="true" Error="@Error" ReturnHere="/customer/tickets">
    <div class="customer-portal__actions customer-portal__actions--top">
        <a class="vx-button vx-button--primary" href="/customer/tickets/new">@T["ui.tickets.new"]</a>
    </div>
    @if (Tickets is { } tickets)
    {
        @if (tickets.Tickets.Count == 0)
        {
            <p class="customer-portal__hint">@T["ui.tickets.none"]</p>
        }
        else
        {
            <CustomerTableViewport Label="@T["ui.tickets.title"]">
                <table class="customer-portal__table">
                    <thead>
                        <tr>
                            <th scope="col">@T["ui.tickets.opened"]</th>
                            <th scope="col">@T["ui.prealert.tracking"]</th>
                            <th scope="col">@T["ui.prealert.carrier"]</th>
                            <th scope="col">@T["ui.tickets.status"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (CustomerTicketDto ticket in tickets.Tickets)
                        {
                            <tr>
                                <td><a href="/customer/tickets/@ticket.TicketId">@ticket.CreatedUtc.ToString("yyyy-MM-dd")</a></td>
                                <td>@ticket.TrackingNumber</td>
                                <td>@ticket.Carrier</td>
                                <td><span class="customer-ticket-status" data-status="@ticket.Status">@T["ui.tickets.status." + ticket.Status]</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </CustomerTableViewport>
        }
    }
</CustomerShell>

@code {
    [Parameter] public CustomerPortalBrandDto? Brand { get; set; }

    [Parameter] public CustomerTicketsDto? Tickets { get; set; }

    [Parameter] public CustomerTicketBody? Entered { get; set; }

    [Parameter] public string? Error { get; set; }
}
