@*
=========================================================
FILE: PreAlertPage.razor

PURPOSE:
The form a customer fills to announce a package (Slice 3B).

RESPONSIBILITIES:
- Ask for the carrier, tracking number, store, contents, value and expected date

IMPORTANT NOTES:
- Markup only. Text comes from CustomerText (L-10)
- The customer's own words become the package's declaration; staff never type it (D-C6)
=========================================================
*@
@using Vixly.Contracts.Operations.Customers
@using Vixly.Contracts.Operations.Packages
@inject IStringLocalizer<CustomerText> T

<CustomerShell Brand="@Brand" Title="@T["ui.prealert.title"]" SignedIn="true" Error="@Error" ReturnHere="/customer/packages/new">
    <form method="post" action="/customer/packages/new" class="customer-portal__form customer-prealert-form">
        <AntiforgeryToken />
        <p>@T["ui.prealert.intro"]</p>
        <label>@T["ui.prealert.carrier"] <input name="carrier" value="@Entered?.Carrier" maxlength="40" required placeholder="UPS, FedEx, USPS, DHL, Amazon" /></label>
        <label>@T["ui.prealert.tracking"] <input name="tracking" value="@Entered?.TrackingNumber" maxlength="60" required autocomplete="off" autocapitalize="characters" spellcheck="false" /></label>
        <label>@T["ui.prealert.store"] <input name="store" value="@Entered?.Store" maxlength="100" /></label>
        <label>@T["ui.prealert.contents"] <textarea name="contents" maxlength="300" required rows="3">@Entered?.Contents</textarea></label>
        <label>@T["ui.prealert.value"] <input name="value" type="number" inputmode="decimal" min="0" step="0.01" value="@(Entered is { DeclaredValue: >= 0 } entered ? entered.DeclaredValue.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : null)" required /></label>
        <label>@T["ui.prealert.expected"] <input name="expected" type="date" value="@Entered?.ExpectedDate?.ToString("yyyy-MM-dd")" /></label>
        <button type="submit" class="vx-button vx-button--primary">@T["ui.prealert.submit"]</button>
        <p><a href="/customer/packages">@T["ui.packages.back"]</a></p>
    </form>
</CustomerShell>

@code {
    [Parameter] public CustomerPortalBrandDto? Brand { get; set; }

    [Parameter] public CustomerPreAlertBody? Entered { get; set; }

    [Parameter] public string? Error { get; set; }
}
