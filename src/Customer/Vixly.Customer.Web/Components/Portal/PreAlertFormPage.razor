@*
=========================================================
FILE: PreAlertFormPage.razor

PURPOSE:
Announce a package on its own, before any shipment (Slice 4D; owner, 2026-10-19).

RESPONSIBILITIES:
- The warehouse it is shipped to (when the customer has several mailbox addresses)
- The package (PackageFields), and optionally one of the customer's open shipments to put it in

IMPORTANT NOTES:
- Markup only. Text comes from CustomerText (L-10); never "Vixly" (ADR-0012)
- The shipment can be chosen later on the packages page; Operations checks everything again
=========================================================
*@
@using Vixly.Contracts.Operations.Customers
@using Vixly.Contracts.Operations.Packages
@using Vixly.Customer.Web.Portal
@inject IStringLocalizer<CustomerText> T

<CustomerShell Brand="@Brand" Title="@T["ui.prealert.new"]" SignedIn="true" Error="@Error" ReturnHere="/customer/packages/new">
    @if (Choices is { } choices)
    {
        <form method="post" action="/customer/packages/new" class="customer-portal__form customer-prealert-form">
            <AntiforgeryToken />
            <p>@T["ui.prealert.intro"]</p>
            @if (choices.Origins.Count == 0)
            {
                <p class="customer-portal__notice">@T["ui.shipments.no_mailbox"]</p>
            }
            else if (choices.Origins.Count > 1)
            {
                <label>@T["ui.prealert.warehouse"]
                    <select name="warehouse" required>
                        @foreach (CustomerChoiceDto origin in choices.Origins) { <option value="@origin.Id" selected="@(origin.Id == Entered?.WarehouseId)">@origin.Name · @origin.Detail</option> }
                    </select>
                </label>
            }
            <PackageFields T="T" Entered="Entered" />
            @if (Shipments.Count > 0)
            {
                <label>@T["ui.prealert.shipment"]
                    <select name="shipment">
                        <option value="">@T["ui.packages.move.none"]</option>
                        @foreach (CustomerShipmentDto shipment in Shipments)
                        {
                            <option value="@shipment.ShipmentId" selected="@(shipment.ShipmentId == Entered?.ShipmentId)">@shipment.Origin → @(shipment.Delivery == "pickup" ? shipment.BranchName : shipment.Address?.City + ", " + shipment.CountryCode) · @shipment.RecipientName</option>
                        }
                    </select>
                </label>
                <p class="customer-portal__hint">@T["ui.prealert.shipment_hint"]</p>
            }
            @if (choices.Origins.Count > 0) { <button type="submit" class="vx-button vx-button--primary">@T["ui.prealert.submit"]</button> }
            <p><a href="/customer/packages">@T["ui.packages.back"]</a></p>
        </form>
    }
</CustomerShell>

@code {
    [Parameter] public CustomerPortalBrandDto? Brand { get; set; }

    [Parameter] public CustomerShipmentChoicesDto? Choices { get; set; }

    // The customer's open shipments with instructions (from any of its warehouses; Operations refuses one from another warehouse).
    [Parameter] public IReadOnlyList<CustomerShipmentDto> Shipments { get; set; } = Array.Empty<CustomerShipmentDto>();

    [Parameter] public CustomerPreAlertBody? Entered { get; set; }

    [Parameter] public string? Error { get; set; }
}
