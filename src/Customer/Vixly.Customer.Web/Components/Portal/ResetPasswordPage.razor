@*
=========================================================
FILE: ResetPasswordPage.razor

PURPOSE:
The page to choose a new password from a reset or invitation link.

RESPONSIBILITIES:
- Render the page to choose a new password from a reset or invitation link

IMPORTANT NOTES:
- Markup only. Text comes from CustomerText (L-10); values come from the endpoint
- Static forms with antiforgery and the form guard (ADR-0019)
- Placeholder look: Frontend/UI designs the final experience; never says "Vixly"
=========================================================
*@
@inject IStringLocalizer<CustomerText> T

<CustomerShell Brand="@Brand" Title="@T["ui.reset.title"]" Error="@Error" ReturnHere="/customer/sign-in">
    <form method="post" action="/customer/reset-password" class="customer-portal__form">
        <AntiforgeryToken />
        <input type="hidden" name="token" value="@Token" />
        <label>@T["ui.field.new_password"] <input type="password" name="password" autocomplete="new-password" minlength="12" maxlength="64" required /></label>
        <button type="submit" class="vx-button vx-button--primary">@T["ui.reset.submit"]</button>
    </form>
</CustomerShell>

@code {
    [Parameter] public Vixly.Contracts.Operations.Customers.CustomerPortalBrandDto? Brand { get; set; }

    [Parameter] public string Token { get; set; } = string.Empty;

    [Parameter] public string? Error { get; set; }
}
