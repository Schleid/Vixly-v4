<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>vixly-v4-customer-web</UserSecretsId>
    <!-- Production (2026-10-23): the customer portal is the /customer application inside the Operations Web site and shares its
         application pool (the host gives sub-applications no pool of their own). Two in-process apps cannot share a pool (500.35),
         so both run out of process. The published web.config then says hostingModel="outofprocess". -->
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Vixly.Shared.Help\Vixly.Shared.Help.csproj" />
    <ProjectReference Include="..\Vixly.Customer.Infrastructure\Vixly.Customer.Infrastructure.csproj" />
    <ProjectReference Include="..\Vixly.Customer.Resources\Vixly.Customer.Resources.csproj" />
    <ProjectReference Include="..\..\Contracts\Vixly.Contracts.Operations\Vixly.Contracts.Operations.csproj" />
    <ProjectReference Include="..\..\Shared\Vixly.Shared.Localization\Vixly.Shared.Localization.csproj" />
    <ProjectReference Include="..\..\Shared\Vixly.Shared.Hosting\Vixly.Shared.Hosting.csproj" />
    <ProjectReference Include="..\..\Shared\Vixly.Shared.UI\Vixly.Shared.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vixly.Customer.Web.Tests" />
  </ItemGroup>

</Project>
