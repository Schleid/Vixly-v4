root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,razor,csproj,props,targets,slnx,json,yml,yaml,xml,config}]
end_of_line = crlf

[*.{cs,razor}]
charset = utf-8-bom

[*.md]
end_of_line = lf
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2
